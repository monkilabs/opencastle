Output clips/03-init.mp4
Set FontSize 16
Set Width 1280
Set Height 720
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set Padding 16
Set Framerate 30
Set Shell "bash"
Set WindowBar Colorful

Hide
Type "export HOME=/tmp/opencastle-demo/home PATH=/tmp/opencastle-demo/bin:$PATH PS1='$ ' && cd /tmp/opencastle-demo/acme-shop && clear"
Enter
Sleep 600ms
Show

Sleep 500ms
Type "npx opencastle init"
Enter
# The plan, then "Set this up? [Y/n]"
Sleep 5500ms
Enter
Sleep 8943ms
