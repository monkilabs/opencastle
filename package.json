{
  "name": "opencastle",
  "version": "1.0.0",
  "type": "module",
  "description": "Your team's AI setup and memory, in every teammate's assistant: shared instructions, skills, agents, MCP servers and lessons, reviewed in pull requests and extended across repositories, for Claude Code, Copilot, Cursor, Windsurf, OpenCode, Codex and Antigravity.",
  "bin": {
    "opencastle": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "!src/dashboard/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "copilot",
    "cursor",
    "claude",
    "orchestration",
    "multi-agent",
    "coding-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkilabs/opencastle.git"
  },
  "bugs": {
    "url": "https://github.com/monkilabs/opencastle/issues"
  },
  "homepage": "https://www.opencastle.dev/",
  "license": "MIT",
  "author": "Filip Mares",
  "scripts": {
    "build": "npm run cli:build",
    "cli:build": "rm -rf dist && tsc",
    "test": "vitest run",
    "plugins:build": "tsx scripts/pack-plugins.ts",
    "website:dev": "astro dev --root website",
    "website:build": "astro build --root website",
    "website:preview": "astro preview --root website",
    "prepublishOnly": "npm run build",
    "verify:claims": "npm run cli:build && bash scripts/verify-claims.sh",
    "mcp:check": "node scripts/mcp-pins.mjs",
    "mcp:bump": "node scripts/mcp-pins.mjs --bump",
    "matrix": "npm run cli:build && node scripts/command-matrix.mjs --tier=1",
    "matrix:full": "npm run cli:build && node scripts/command-matrix.mjs --tier=2",
    "matrix:all": "npm run cli:build && node scripts/command-matrix.mjs --tier=3",
    "test:deep": "OC_ARRANGEMENT_DEPTH=9 vitest run src/cli/managed-block.property.test.ts src/cli/gitignore.property.test.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "astro": "^5.5.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "smol-toml": "^1.9.0",
    "valibot": "^1.2.0",
    "yaml": "^2.8.2"
  }
}
