{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "trello",
  "description": "Trello skill and MCP server for AI coding assistants: Visual board task management via MCP.",
  "homepage": "https://www.opencastle.dev/docs/plugins#trello",
  "repository": "https://github.com/monkilabs/opencastle",
  "license": "MIT",
  "keywords": [
    "team",
    "task-management"
  ],
  "extensions": {
    "dev.opencastle": {
      "label": "Trello",
      "category": "team",
      "subCategory": "task-management",
      "authType": "env-token",
      "env": [
        "TRELLO_API_KEY",
        "TRELLO_TOKEN"
      ],
      "officialDocs": "https://developer.atlassian.com/cloud/trello/"
    }
  }
}
