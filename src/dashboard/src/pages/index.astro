      </div>
      <div class="chart-card__body" id="tasks-section-body">
        <div id="task-summary-cards" class="task-summary-cards"></div>
        <div id="phase-breakdown" class="phase-breakdown"></div>
        <div id="task-table-wrap" class="task-table-wrap"></div>
