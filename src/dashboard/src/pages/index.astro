      '<th scope="col">Verdict</th>' +
      '<th scope="col">Model</th>' +
      '<th scope="col">Tokens</th>' +
      '</tr></thead>' +
      '<tbody>' +
      reviewedTasks.map(function(t) {
        var verdictUpper = t.review_verdict ? t.review_verdict.toUpperCase() : '';
        var verdictBadge = t.review_verdict
