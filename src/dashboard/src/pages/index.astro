  function showConvoyDetailView(convoyId, convoyName) {
    const home = document.getElementById('view-home');
    const detail = document.getElementById('view-convoy-detail');
    const breadcrumbs = document.getElementById('breadcrumbs');
    if (home) home.dataset.viewHidden = '';
    if (detail) delete detail.dataset.viewHidden;
    if (breadcrumbs) delete breadcrumbs.dataset.viewHidden;
    document.querySelectorAll('.dash-sidebar__link[data-view="home"]').forEach(el => el.closest('li').style.display = 'none');
    document.querySelectorAll('.dash-sidebar__link[data-view="detail"]').forEach(el => el.closest('li').style.display = '');
    const crumbText = document.getElementById('breadcrumbs-convoy');
    if (crumbText) crumbText.textContent = convoyName || convoyId;
    const url = new URL(window.location);
    url.searchParams.set('convoy', convoyId);
    history.pushState({}, '', url);
    loadConvoyDetail(convoyId);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ── Convoy List ─────────────────────────────────────────
  var convoyListCurrentPage = 1;
  var CONVOY_LIST_PAGE_SIZE = 10;
  var convoyChainExpanded = {};
  var executionLogPageSize = 20;
  var executionLogCurrentPage = 1;
  var executionLogAllSortedTasks = [];
  var executionLogLimit = 10;

  function renderConvoyList() {
    const data = window.__DASHBOARD_DATA__;
    const list = data?.convoyList ?? [];
    const wrap = document.getElementById('convoy-list-table-wrap');
    const emptyEl = document.getElementById('convoy-list-empty');
    if (!wrap) return;

    const search = (document.getElementById('cl-filter-search')?.value || '').toLowerCase();
    const status = document.getElementById('cl-filter-status')?.value || '';
    const fromDate = document.getElementById('cl-filter-from')?.value || '';
    const toDate = document.getElementById('cl-filter-to')?.value || '';

    let filtered = list;
    if (search) filtered = filtered.filter(c => (c.name || c.id || '').toLowerCase().includes(search));
    if (status) filtered = filtered.filter(c => c.status === status);
    if (fromDate) filtered = filtered.filter(c => c.created_at && c.created_at >= fromDate);
    if (toDate) filtered = filtered.filter(c => c.created_at && c.created_at.slice(0, 10) <= toDate);

    if (filtered.length === 0) {
      wrap.innerHTML = '';
      var existingPag = document.getElementById('convoy-list-pagination');
      if (existingPag) existingPag.remove();
      if (emptyEl) emptyEl.style.display = '';
      return;
    }
    if (emptyEl) emptyEl.style.display = 'none';

    const statusBadgeClass = (s) => {
      const map = { done: '--done', running: '--running', failed: '--failed', 'gate-failed': '--gate-failed', gate_failed: '--gate-failed', pending: '--pending' };
      return 'status-badge ' + (map[s] || '');
    };

    // Group convoys by pipeline_id (non-null pipeline_id forms a chain)
    var grouped = [];
    var pipelineMap = {};
    for (var gi = 0; gi < filtered.length; gi++) {
      var gc = filtered[gi];
      if (gc.pipeline_id) {
        if (!pipelineMap[gc.pipeline_id]) {
          pipelineMap[gc.pipeline_id] = { pipeline_id: gc.pipeline_id, convoys: [] };
          grouped.push(pipelineMap[gc.pipeline_id]);
        }
        pipelineMap[gc.pipeline_id].convoys.push(gc);
      } else {
        grouped.push(gc);
      }
    }

    // Pagination on grouped top-level items
    var totalPages = Math.ceil(grouped.length / CONVOY_LIST_PAGE_SIZE);
    if (convoyListCurrentPage > totalPages) convoyListCurrentPage = 1;
    var pageStart = (convoyListCurrentPage - 1) * CONVOY_LIST_PAGE_SIZE;
    var paginated = grouped.slice(pageStart, pageStart + CONVOY_LIST_PAGE_SIZE);

    let html = '<table class="convoy-list-table"><thead><tr>' +
      '<th>Name</th><th>Status</th><th>Tasks</th><th>Created</th><th>Duration</th>' +
      '</tr></thead><tbody>';

    for (var pi = 0; pi < paginated.length; pi++) {
      var item = paginated[pi];
      if (item.convoys) {
        // Pipeline group row
        var grpConvoys = item.convoys;
        var grpPipelineId = item.pipeline_id;
        var isExpanded = !!convoyChainExpanded[grpPipelineId];
        var grpStatus = (function(cs) {
          if (cs.some(function(x) { return x.status === 'failed' || x.status === 'gate_failed'; })) return 'gate_failed';
          if (cs.some(function(x) { return x.status === 'running'; })) return 'running';
          if (cs.every(function(x) { return x.status === 'done'; })) return 'done';
          return cs[0] ? cs[0].status : 'pending';
        })(grpConvoys);
        var grpTasks = grpConvoys.reduce(function(s, x) { return s + (x.task_count || 0); }, 0);
        var grpEarliestCreated = grpConvoys.reduce(function(a, x) { return (!a || (x.created_at && x.created_at < a)) ? x.created_at : a; }, null);
        var grpLatestFinished = grpConvoys.reduce(function(a, x) { return (!a || (x.finished_at && x.finished_at > a)) ? x.finished_at : a; }, null);
        var grpAllFinished = grpConvoys.every(function(x) { return !!x.finished_at; });
        var grpDuration = grpEarliestCreated && grpAllFinished && grpLatestFinished ? formatDuration(grpEarliestCreated, grpLatestFinished) : (grpStatus === 'running' ? 'In progress' : '\u2014');
        var grpName = grpConvoys[0].pipeline_name || grpPipelineId.replace(/-/g, ' ').replace(/\b\w/g, function(l) { return l.toUpperCase(); });
        var toggleIcon = isExpanded ? '\u25bc' : '\u25b6';
        html += '<tr class="convoy-chain-row task-row--clickable" data-pipeline-group-id="' + escapeHtml(grpPipelineId) + '" aria-expanded="' + isExpanded + '" role="row">' +
          '<td><span class="convoy-chain-toggle">' + toggleIcon + '</span><strong>' + escapeHtml(grpName) + '</strong></td>' +
          '<td><span class="' + statusBadgeClass(grpStatus) + '">' + escapeHtml(grpStatus) + '</span></td>' +
          '<td>' + grpTasks + '</td>' +
          '<td>' + (grpEarliestCreated ? formatTime(grpEarliestCreated) : '\u2014') + '</td>' +
          '<td>' + grpDuration + '</td>' +
          '</tr>';
        if (isExpanded) {
          for (var ci = 0; ci < grpConvoys.length; ci++) {
            var cc = grpConvoys[ci];
            var ccName = escapeHtml(cc.name || cc.id);
            var ccDate = cc.created_at ? formatTime(cc.created_at) : '\u2014';
            var ccDur = cc.started_at && cc.finished_at ? formatDuration(cc.started_at, cc.finished_at) : (cc.status === 'running' ? 'In progress' : '\u2014');
            var ccTasks = cc.task_count != null ? cc.task_count : '\u2014';
            html += '<tr data-convoy-id="' + escapeHtml(cc.id) + '" class="task-row--clickable convoy-chain-child">' +
              '<td><strong>' + ccName + '</strong></td>' +
              '<td><span class="' + statusBadgeClass(cc.status) + '">' + escapeHtml(cc.status || 'unknown') + '</span></td>' +
              '<td>' + ccTasks + '</td>' +
              '<td>' + ccDate + '</td>' +
              '<td>' + ccDur + '</td>' +
              '</tr>';
          }
        }
      } else {
        var name = escapeHtml(item.name || item.id);
        var dateStr = item.created_at ? formatTime(item.created_at) : '\u2014';
        var duration = item.started_at && item.finished_at ? formatDuration(item.started_at, item.finished_at) : (item.status === 'running' ? 'In progress' : '\u2014');
        var taskCount = item.task_count != null ? item.task_count : '\u2014';
        html += '<tr data-convoy-id="' + escapeHtml(item.id) + '" class="task-row--clickable">' +
          '<td><strong>' + name + '</strong></td>' +
          '<td><span class="' + statusBadgeClass(item.status) + '">' + escapeHtml(item.status || 'unknown') + '</span></td>' +
          '<td>' + taskCount + '</td>' +
          '<td>' + dateStr + '</td>' +
          '<td>' + (duration || '\u2014') + '</td>' +
          '</tr>';
      }
    }
    html += '</tbody></table>';
    wrap.innerHTML = html;

    wrap.querySelectorAll('tr[data-pipeline-group-id]').forEach(row => {
      row.addEventListener('click', () => {
        const groupId = row.dataset.pipelineGroupId;
        convoyChainExpanded[groupId] = !convoyChainExpanded[groupId];
        renderConvoyList();
      });
    });

    wrap.querySelectorAll('tr[data-convoy-id]').forEach(row => {
      row.addEventListener('click', () => {
        const id = row.dataset.convoyId;
        const nameCell = row.querySelector('td strong');
        showConvoyDetailView(id, nameCell ? nameCell.textContent : id);
      });
    });

    // Render pagination controls
    var oldPag = document.getElementById('convoy-list-pagination');
    if (oldPag) oldPag.remove();
    if (grouped.length > CONVOY_LIST_PAGE_SIZE) {
      var pagEl = document.createElement('div');
      pagEl.id = 'convoy-list-pagination';
      pagEl.className = 'convoy-list-pagination';
      pagEl.innerHTML =
        '<button class="dash-btn dash-btn--ghost" id="convoy-list-prev" type="button"' + (convoyListCurrentPage === 1 ? ' disabled' : '') + '>Previous</button>' +
        '<span class="convoy-list-pagination__info">Page ' + convoyListCurrentPage + ' of ' + totalPages + '</span>' +
        '<button class="dash-btn dash-btn--ghost" id="convoy-list-next" type="button"' + (convoyListCurrentPage === totalPages ? ' disabled' : '') + '>Next</button>';
      wrap.after(pagEl);
      pagEl.querySelector('#convoy-list-prev').addEventListener('click', function() {
        if (convoyListCurrentPage > 1) { convoyListCurrentPage--; renderConvoyList(); }
      });
      pagEl.querySelector('#convoy-list-next').addEventListener('click', function() {
        if (convoyListCurrentPage < totalPages) { convoyListCurrentPage++; renderConvoyList(); }
      });
    }
  }

  // ── Overall Stats Rendering ──────────────────────────────

  function renderOverallStats() {
    const data = window.__DASHBOARD_DATA__;
    if (!data || !data.overallStats) return;
    const stats = data.overallStats;
    const cc = stats.convoyCounts || {};
    const tc = stats.tokenCostTotals || {};
    const ds = stats.durationStats || {};

    setKpiValue('overall-total-runs', String(cc.total || 0));
    setKpiValue('overall-running', String(cc.running || 0));

    const total = cc.total || 0;
    const success = cc.done || 0;
    const rate = total > 0 ? ((success / total) * 100).toFixed(1) + '%' : '\u2014';
    setKpiValue('overall-success-rate', rate);

    const avgSec = ds.avg_sec;
    setKpiValue('overall-avg-duration', avgSec != null ? formatDurationSec(avgSec) : '\u2014');
    var totalTokens = (tc && tc.total_tokens) || 0;
    var totalCost = (tc && tc.total_cost_usd) || 0;
    setKpiValue('overall-total-tokens', totalTokens > 0 ? formatTokens(totalTokens) : '\u2014');
    setKpiValue('overall-total-cost', totalCost > 0 ? '$' + totalCost.toFixed(2) : '\u2014');

    // Fallback: if overall stats show 0 tokens, sum from convoy list
    if (totalTokens === 0) {
      var convoyListFallback = (window.__DASHBOARD_DATA__ && window.__DASHBOARD_DATA__.convoyList) || [];
      if (convoyListFallback.length > 0) {
        var sumTokens = convoyListFallback.reduce(function(s, c) { return s + (c.total_tokens != null ? c.total_tokens : 0); }, 0);
        var sumCost = convoyListFallback.reduce(function(s, c) { return s + (c.total_cost_usd != null ? c.total_cost_usd : 0); }, 0);
        if (sumTokens > 0) {
          setKpiValue('overall-total-tokens', formatTokens(sumTokens));
          setKpiValue('overall-total-cost', '$' + sumCost.toFixed(2));
        } else {
          // Final fallback: estimate from task count (~5000 tokens/task at ~$8/1M tokens avg)
          var taskTotal = (stats.taskTotals && stats.taskTotals.totalTasks) || 0;
          if (taskTotal > 0) {
            var estTokens = taskTotal * 5000;
            var estCost = estTokens * 0.000008;
            setKpiValue('overall-total-tokens', '~' + formatTokens(estTokens));
            setKpiValue('overall-total-cost', '~$' + estCost.toFixed(2));
          } else {
            setKpiValue('overall-total-tokens', 'N/A (estimated)');
            setKpiValue('overall-total-cost', 'N/A (estimated)');
          }
        }
      }
    }

    // Total tasks and retries
    var tt = stats.taskTotals || {};
    setKpiValue('overall-total-tasks', String(tt.totalTasks || 0));
    setKpiValue('overall-total-retries', String(tt.totalRetries || 0));
  }

  function setKpiValue(id, value) {
    const el = document.getElementById(id);
    if (el) {
      const valEl = el.querySelector('.overall-kpi__value');
      if (valEl) valEl.textContent = value;
    }
  }

  function formatDurationSec(sec) {
    if (sec < 60) return Math.round(sec) + 's';
    const min = Math.floor(sec / 60);
    const remSec = Math.round(sec % 60);
    if (min < 60) return min + 'm ' + remSec + 's';
    const hr = Math.floor(min / 60);
    const remMin = min % 60;
    return hr + 'h ' + remMin + 'm';
  }

  function renderActivityTimeline() {
    var el = document.getElementById('activity-timeline-chart');
    if (!el) return;
    var data = window.__DASHBOARD_DATA__;
    var timeline = (data && data.overallStats && data.overallStats.activityTimeline) || [];
    if (timeline.length === 0) {
      el.innerHTML = emptyStateHtml('timeline', 'No activity yet', 'Convoy run activity will appear here as runs complete.');
      return;
    }
    var maxCount = Math.max.apply(null, timeline.map(function(d) { return d.count; }));
    var html = '<div class="activity-timeline activity-timeline--vertical">';
    for (var i = 0; i < timeline.length; i++) {
      var d = timeline[i];
      var pct = maxCount > 0 ? Math.round((d.count / maxCount) * 100) : 0;
      html += '<div class="vbar-col">' +
        '<span class="vbar-value">' + d.count + '</span>' +
        '<div class="vbar-track"><div class="vbar-fill" style="height:' + pct + '%"></div></div>' +
        '<span class="vbar-label">' + formatShortDate(d.date) + '</span>' +
        '</div>';
    }
    html += '</div>';
    el.innerHTML = html;
  }

  async function renderRecentSessions() {
    var el = document.getElementById('sessions-table');
    var detailEl = document.getElementById('detail-sessions-table');
    if (!el && !detailEl) return;
    try {
      var allEvents = await loadNdjson(base + 'data/events.ndjson');
      var sessions = allEvents.filter(function(e) { return e.type === 'session'; });
      sessions.sort(function(a, b) {
        return (b.timestamp || '').localeCompare(a.timestamp || '');
      });
      sessions = sessions.slice(0, 15);
      if (sessions.length === 0) {
        var emptyHtml = emptyStateHtml('sessions', 'No sessions recorded yet', 'Agent session data will appear here when sessions are logged via opencastle log.');
        if (el) el.innerHTML = emptyHtml;
        if (detailEl) detailEl.innerHTML = emptyHtml;
        return;
      }
      var thead = '<thead><tr>' +
        '<th>Agent</th><th>Task</th><th>Outcome</th><th>Duration</th><th>Retries</th><th>Files</th><th>Time</th>' +
        '</tr></thead>';
      var tbody = '<tbody>';
      for (var i = 0; i < sessions.length; i++) {
        var s = sessions[i];
        var outcomeClass = s.outcome === 'success' ? 'outcome-badge--success' : s.outcome === 'failed' ? 'outcome-badge--failed' : 'outcome-badge--partial';
        var filesVal = s.files_changed;
        var filesCell;
        if (Array.isArray(s.file_partition) && s.file_partition.length > 0) {
          filesCell = '<span class="tooltip-trigger" data-tooltip="' + escapeHtml(s.file_partition.join('\n')) + '">' + s.file_partition.length + ' file' + (s.file_partition.length !== 1 ? 's' : '') + '</span>';
        } else if (typeof filesVal === 'number') {
          filesCell = String(filesVal);
        } else {
          filesCell = '0';
        }
        tbody += '<tr>' +
          '<td class="td-agent" title="' + escapeHtml(s.agent || '') + '">' + escapeHtml(s.agent || '\u2014') + '</td>' +
          '<td class="td-task" title="' + escapeHtml(s.task || '') + '">' + escapeHtml(s.task || '\u2014') + '</td>' +
          '<td><span class="outcome-badge ' + outcomeClass + '">' + escapeHtml(s.outcome || '\u2014') + '</span></td>' +
          '<td>' + (s.duration_min != null ? s.duration_min + 'm' : '\u2014') + '</td>' +
          '<td>' + (s.retries || 0) + '</td>' +
          '<td>' + filesCell + '</td>' +
          '<td>' + (s.timestamp ? formatTime(s.timestamp) : '\u2014') + '</td>' +
          '</tr>';
      }
      tbody += '</tbody>';
      var tableHtml = '<table class="sessions-table">' + thead + tbody + '</table>';
      if (el) el.innerHTML = tableHtml;
      if (detailEl) detailEl.innerHTML = tableHtml;
    } catch (e) {
      var errHtml = emptyStateHtml('sessions', 'No sessions recorded yet', 'Agent session data will appear here when sessions are logged.');
      if (el) el.innerHTML = errHtml;
      if (detailEl) detailEl.innerHTML = errHtml;
    }
  }

  async function loadConvoyDetail(convoyId) {
    executionLogLimit = 10;
    if (!convoyId) {
      renderConvoyDetailHeader(null);
      ['pipeline-section', 'agent-section', 'tier-section', 'model-section', 'quality-section', 'reliability-section', 'drift-section', 'outputs-section', 'execution-section', 'event-timeline-section', 'panel-section', 'reviews-section'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
      return;
    }
    try {
      const resp = await fetch(base + 'data/convoys/' + encodeURIComponent(convoyId) + '.json');
      if (!resp.ok) throw new Error('Failed to load convoy detail');
      const detail = await resp.json();
      renderConvoyDetailHeader(detail);
      window.__SELECTED_CONVOY__ = detail;
      renderTaskSummaryCards(detail.tasks || []);
      renderTaskTable(detail.tasks || []);
      renderPhaseBreakdown(detail.tasks || []);
      const tasksSection = document.getElementById('tasks-section');
      if (tasksSection) tasksSection.style.display = '';
      renderDetailPipeline(detail.tasks || []);
      renderDetailAgentChart(detail.tasks || []);
      renderDetailTierChart(detail.tasks || []);
      renderDetailMechanismChart(detail.events || []);
      renderDetailModelChart(detail.tasks || []);
      renderQualitySection(detail);
      renderReliabilitySection(detail);
      renderDriftSection(detail);
      renderOutputsSection(detail);
      renderDetailExecutionLog(detail.tasks || []);
      renderEventTimeline(detail);
      renderDetailPanelChart(detail.tasks || []);
      renderDetailReviewsTable(detail.tasks || []);
      // Show pipeline chain if this convoy is part of a pipeline
      const convoyListForChain = window.__DASHBOARD_DATA__?.convoyList ?? [];
      const currentConvoyEntry = convoyListForChain.find(c => c.id === convoyId);
      if (currentConvoyEntry && currentConvoyEntry.pipeline_id) {
        const chainConvoys = convoyListForChain
          .filter(c => c.pipeline_id === currentConvoyEntry.pipeline_id)
          .sort((a, b) => (a.created_at || '').localeCompare(b.created_at || ''));
        if (chainConvoys.length > 1) {
          renderPipelineChain(chainConvoys, convoyId);
        }
      }
      await renderRecentSessions();
    } catch (e) {
      console.error('Failed to load convoy detail:', e);
      renderConvoyDetailHeader(null);
      ['pipeline-section', 'agent-section', 'tier-section', 'model-section', 'quality-section', 'reliability-section', 'drift-section', 'outputs-section', 'execution-section', 'event-timeline-section', 'panel-section', 'reviews-section'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
    }
  }

  function renderConvoyDetailHeader(detail) {
    const nameEl = document.getElementById('detail-hero-title');
    const statusEl = document.getElementById('detail-hero-status');
    const metaEl = document.getElementById('detail-hero-meta');

    if (!detail || !detail.convoy) {
      if (nameEl) nameEl.textContent = 'No convoy selected';
      if (statusEl) { statusEl.textContent = ''; statusEl.className = 'status-badge'; }
      if (metaEl) metaEl.innerHTML = '';
      ['tasks-section', 'pipeline-section', 'agent-section', 'tier-section', 'model-section', 'quality-section', 'reliability-section', 'drift-section', 'outputs-section', 'execution-section', 'event-timeline-section', 'panel-section', 'reviews-section'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
      return;
    }

    const c = detail.convoy;
    if (nameEl) nameEl.textContent = c.name || c.id;
    if (statusEl) {
      statusEl.textContent = c.status;
      statusEl.className = 'status-badge status-badge--' + c.status;
    }
    // Status explanation
    const statusExplanations = {
      'running': 'This run is still in progress; some tasks are being executed.',
      'done': 'This run completed successfully; all tasks finished.',
      'failed': 'This run stopped because at least one task could not recover.',
      'gate-failed': 'This run stopped because a quality check failed.',
      'hook-failed': 'This run stopped because a lifecycle script failed.',
    };
    if (metaEl) {
      let html = '';
      if (c.branch) html += '<span class="convoy-meta__item">🌿 ' + escapeHtml(c.branch) + '</span>';
      if (c.created_at) html += '<span class="convoy-meta__item">\u25B6 ' + formatTime(c.created_at) + '</span>';
      if (c.finished_at) html += '<span class="convoy-meta__item">\u25A0 ' + formatTime(c.finished_at) + '</span>';
      if (c.created_at && c.finished_at) {
        const dur = formatDuration(c.created_at, c.finished_at);
        if (dur) html += '<span class="convoy-meta__item">\u23F1 ' + dur + '</span>';
      }
      if (c.total_tokens != null) html += '<span class="convoy-meta__item">\uD83D\uDD24 ' + formatTokens(c.total_tokens) + ' tokens</span>';
      if (c.total_cost_usd != null) html += '<span class="convoy-meta__item">\uD83D\uDCB0 $' + c.total_cost_usd.toFixed(2) + '</span>';
      metaEl.innerHTML = html;
    }
  }

  // ── Task Section ─────────────────────────────────────────

  const STATUS_TOOLTIPS = {
    'done': 'Finished successfully.',
    'running': 'Currently executing.',
    'pending': 'Waiting to start.',
    'assigned': 'Assigned to a worker, starting soon.',
    'failed': 'Stopped due to an error.',
    'gate-failed': 'A quality check did not pass.',
    'timed-out': 'Exceeded the time limit.',
    'review-blocked': 'Paused because a reviewer requested changes.',
    'skipped': 'Skipped because a dependency failed.',
    'hook-failed': 'A pre/post-task script encountered an error.',
    'disputed': 'Under dispute after review disagreement.',
    'wait-for-input': 'Paused \u2014 needs your input.',
  };

  let taskSortCol = 'phase';
  let taskSortAsc = true;

  function renderTaskSummaryCards(tasks) {
    const el = document.getElementById('task-summary-cards');
    if (!el) return;
    if (!tasks || tasks.length === 0) { el.innerHTML = ''; return; }
    const done = tasks.filter(t => t.status === 'done').length;
    const waiting = tasks.filter(t => t.status === 'pending' || t.status === 'assigned').length;
    const running = tasks.filter(t => t.status === 'running').length;
    const errors = tasks.filter(t => ['failed', 'gate-failed', 'timed-out', 'hook-failed'].includes(t.status)).length;
    const waitInput = tasks.filter(t => t.status === 'wait-for-input').length;
    const cards = [
      { label: 'Tasks Completed', value: done, tooltip: 'Tasks that finished successfully.', mod: 'done' },
      { label: 'Tasks Waiting', value: waiting, tooltip: 'Tasks not yet started.', mod: 'waiting' },
      { label: 'Tasks Running', value: running, tooltip: 'Tasks currently being executed.', mod: 'running' },
      { label: 'Tasks With Errors', value: errors, tooltip: 'Tasks that stopped due to errors.', mod: 'errors' },
      { label: 'Waiting For Input', value: waitInput, tooltip: 'Tasks paused until you provide input.', mod: 'input' },
    ];
    el.innerHTML = cards.map(card =>
      '<div class="task-summary-card task-summary-card--' + card.mod + '">' +
        '<span class="task-summary-card__label">' + escapeHtml(card.label) +
          ' <span class="tooltip-trigger" tabindex="0" role="button" aria-label="Info: ' + escapeHtml(card.tooltip) + '" data-tooltip="' + escapeHtml(card.tooltip) + '">' + INFO_ICON + '</span>' +
        '</span>' +
        '<span class="task-summary-card__value">' + card.value + '</span>' +
      '</div>'
    ).join('');
  }

  function renderTaskTable(tasks) {
    const el = document.getElementById('task-table-wrap');
    if (!el) return;
    if (!tasks || tasks.length === 0) {
      el.innerHTML = emptyStateHtml('pipeline', 'No tasks', 'This convoy has no tasks recorded.');
      return;
    }
    const cols = [
      { key: 'id', label: 'Task ID' },
      { key: 'phase', label: 'Phase' },
      { key: 'agent', label: 'Agent' },
      { key: 'status', label: 'Status' },
      { key: 'duration', label: 'Duration' },
      { key: 'retries', label: 'Retries' },
      { key: 'files', label: 'Files' },
      { key: 'total_tokens', label: 'Tokens' },
    ];
    const sorted = tasks.slice().sort((a, b) => {
      let av, bv;
      if (taskSortCol === 'duration') {
        av = (a.started_at && a.finished_at) ? (new Date(a.finished_at) - new Date(a.started_at)) : -1;
        bv = (b.started_at && b.finished_at) ? (new Date(b.finished_at) - new Date(b.started_at)) : -1;
      } else if (taskSortCol === 'files') {
        av = a.files ? a.files.length : 0;
        bv = b.files ? b.files.length : 0;
      } else {
        av = a[taskSortCol] != null ? a[taskSortCol] : '';
        bv = b[taskSortCol] != null ? b[taskSortCol] : '';
      }
      if (av < bv) return taskSortAsc ? -1 : 1;
      if (av > bv) return taskSortAsc ? 1 : -1;
      return 0;
    });
    const thead = '<thead><tr>' + cols.map(col => {
      const isActive = col.key === taskSortCol;
      const indicator = isActive ? (taskSortAsc ? ' \u25B2' : ' \u25BC') : ' \u25B6';
      const ariaSort = isActive ? (taskSortAsc ? 'ascending' : 'descending') : 'none';
      return '<th class="sortable-th' + (isActive ? ' sortable-th--active' : '') + '" data-sort-key="' + col.key + '" scope="col" aria-sort="' + ariaSort + '">' +
        escapeHtml(col.label) +
        '<span class="sort-indicator">' + indicator + '</span>' +
        '</th>';
    }).join('') + '</tr></thead>';
    const tbody = '<tbody>' + sorted.map(t => {
      const statusTip = STATUS_TOOLTIPS[t.status] || '';
      const statusBadge = '<span class="status-badge status-badge--' + escapeHtml(t.status) + '" title="' + escapeHtml(statusTip) + '" role="status">' + escapeHtml(t.status) + '</span>';
      const dur = formatDuration(t.started_at, t.finished_at) || '\u2014';
      const fileCount = t.files ? t.files.length : 0;
      const fileTip = t.files && t.files.length > 0 ? t.files.join('\n') : '';
      const filesCell = fileCount > 0
        ? '<span class="tooltip-trigger" data-tooltip="' + escapeHtml(fileTip) + '">' + fileCount + ' file' + (fileCount !== 1 ? 's' : '') + '</span>'
        : '<span style="opacity:0.4">\u2014</span>';
      const tokens = t.total_tokens != null ? formatTokens(t.total_tokens) : '\u2014';
      return '<tr>' +
        '<td class="td-task">' + escapeHtml(t.id || '\u2014') + '</td>' +
        '<td>' + (t.phase != null ? t.phase : '\u2014') + '</td>' +
        '<td class="td-agent">' + escapeHtml(t.agent || '\u2014') + '</td>' +
        '<td>' + statusBadge + '</td>' +
        '<td>' + dur + '</td>' +
        '<td class="td-num">' + t.retries + '</td>' +
        '<td>' + filesCell + '</td>' +
        '<td class="td-num">' + tokens + '</td>' +
        '</tr>';
    }).join('') + '</tbody>';
    el.innerHTML = '<table class="sessions-table task-table">' + thead + tbody + '</table>';
    el.querySelectorAll('.sortable-th').forEach(th => {
      th.addEventListener('click', function() {
        const key = this.dataset.sortKey;
        if (key === taskSortCol) {
          taskSortAsc = !taskSortAsc;
        } else {
          taskSortCol = key;
          taskSortAsc = true;
        }
        const convoy = window.__SELECTED_CONVOY__;
        renderTaskTable((convoy && convoy.tasks) ? convoy.tasks : []);
      });
    });
  }

  function renderPhaseBreakdown(tasks) {
    const el = document.getElementById('phase-breakdown');
    if (!el) return;
    if (!tasks || tasks.length === 0) { el.innerHTML = ''; return; }
    const phaseMap = {};
    for (const t of tasks) {
      const p = t.phase != null ? String(t.phase) : '0';
      if (!phaseMap[p]) phaseMap[p] = { done: 0, running: 0, waiting: 0, failed: 0 };
      if (t.status === 'done') phaseMap[p].done++;
      else if (t.status === 'running') phaseMap[p].running++;
      else if (t.status === 'pending' || t.status === 'assigned') phaseMap[p].waiting++;
      else phaseMap[p].failed++;
    }
    const phases = Object.keys(phaseMap).sort((a, b) => Number(a) - Number(b));
    if (phases.length === 0) { el.innerHTML = ''; return; }
    const html = phases.map(p => {
      const d = phaseMap[p];
      const total = d.done + d.running + d.waiting + d.failed;
      if (total === 0) return '';
      const pct = v => Math.round((v / total) * 100);
      const segments = [
        { cls: 'done', v: d.done },
        { cls: 'running', v: d.running },
        { cls: 'waiting', v: d.waiting },
        { cls: 'failed', v: d.failed },
      ].filter(s => s.v > 0);
      return '<div class="phase-breakdown__row">' +
        '<span class="phase-breakdown__label">Phase ' + escapeHtml(p) + '</span>' +
        '<div class="phase-breakdown__bar">' +
          segments.map(s =>
            '<div class="phase-breakdown__seg phase-breakdown__seg--' + s.cls + '" style="width:' + pct(s.v) + '%" title="' + s.cls + ': ' + s.v + '"></div>'
          ).join('') +
        '</div>' +
        '<span class="phase-breakdown__count">' + total + ' task' + (total !== 1 ? 's' : '') + '</span>' +
      '</div>';
    }).join('');
    el.innerHTML = html;
  }

  // ── Convoy Detail: Derive Tier from Model ────────────────

  function deriveTier(model, agent) {
    var TIER_MAP = {
      'claude-opus-4-6': 'premium',
      'claude-opus-4': 'premium',
      'claude-sonnet-4-6': 'standard',
      'claude-sonnet-4': 'standard',
      'claude-haiku-3-5': 'economy',
      'claude-haiku-4': 'economy',
      'gpt-5-mini': 'economy',
      'gpt-5.3-codex': 'standard',
      'gpt-5': 'standard',
      'gemini-3.1-pro': 'standard',
      'gemini-3.0-flash': 'economy',
    };
    if (model && model !== 'copilot' && model !== 'cursor' && model !== 'opencode' && model !== 'claude') {
      if (TIER_MAP[model]) return TIER_MAP[model];
      var m = model.toLowerCase();
      if (m.includes('opus')) return 'premium';
      if (m.includes('sonnet') || m.includes('pro')) return 'standard';
      if (m.includes('haiku') || m.includes('flash') || m.includes('mini')) return 'economy';
    }
    // Derive from agent name when model is a generic adapter name
    if (agent) {
      var a = (typeof agent === 'string' ? agent : '').toLowerCase().replace(/[\s\/]+/g, '-');
      if (a === 'architect' || a === 'team-lead' || a.includes('team-lead')) return 'premium';
      if (a === 'reviewer' || a === 'documentation-writer' || a === 'seo-specialist' || a === 'session-guard') return 'economy';
      if (['developer', 'ui-ux-expert', 'testing-expert', 'security-expert', 'performance-expert', 'devops-expert', 'data-expert', 'api-designer', 'copywriter', 'release-manager', 'content-engineer', 'database-engineer', 'researcher'].includes(a)) return 'standard';
    }
    if (!model) return 'unknown';
    return 'utility';
  }

  function deriveModel(model, agent) {
    if (model && model !== 'copilot' && model !== 'cursor' && model !== 'opencode' && model !== 'claude') {
      return model;
    }
    if (agent) {
      var AGENT_MODEL = {
        'developer': 'claude-sonnet-4-6', 'ui-ux-expert': 'claude-sonnet-4-6',
        'testing-expert': 'claude-sonnet-4-6', 'security-expert': 'claude-sonnet-4-6',
        'performance-expert': 'claude-sonnet-4-6', 'devops-expert': 'claude-sonnet-4-6',
        'data-expert': 'claude-sonnet-4-6', 'api-designer': 'claude-sonnet-4-6',
        'copywriter': 'claude-sonnet-4-6', 'release-manager': 'claude-sonnet-4-6',
        'content-engineer': 'claude-sonnet-4-6', 'database-engineer': 'claude-sonnet-4-6',
        'researcher': 'claude-sonnet-4-6',
        'architect': 'claude-opus-4-6', 'team-lead': 'claude-opus-4-6',
        'reviewer': 'claude-haiku-3-5', 'documentation-writer': 'claude-haiku-3-5',
        'seo-specialist': 'claude-haiku-3-5', 'session-guard': 'claude-haiku-3-5',
      };
      var a = agent.toLowerCase().replace(/[\s\/]+/g, '-');
      return AGENT_MODEL[a] || model || 'unknown';
    }
    return model || 'unknown';
  }

  // ── Convoy Detail: Pipeline View ─────────────────────────

  function renderDetailPipeline(tasks) {
    var el = document.getElementById('pipeline-view');
    if (!el) return;

    if (!tasks || tasks.length === 0) {
      el.innerHTML = emptyStateHtml('pipeline', 'No pipeline activity yet', 'Tasks will flow through execution phases here.');
      return;
    }

    var phases = {};
    tasks.forEach(function(t) {
      var p = t.phase != null ? t.phase : 0;
      if (!phases[p]) phases[p] = { count: 0, done: 0, failed: 0, running: 0 };
      phases[p].count++;
      if (t.status === 'done') phases[p].done++;
      else if (['failed', 'gate-failed', 'timed-out', 'hook-failed'].includes(t.status)) phases[p].failed++;
      else if (t.status === 'running' || t.status === 'assigned') phases[p].running++;
    });

    var phaseNums = Object.keys(phases).map(Number).sort(function(a, b) { return a - b; });
    var PHASE_LABELS = ['Foundation', 'Integration', 'Validation', 'QA Gate', 'Phase 5', 'Phase 6'];
    var PHASE_ICONS = [
      { iconClass: 'pending', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="13" y2="14"/></svg>' },
      { iconClass: 'active', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>' },
      { iconClass: 'review', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>' },
      { iconClass: 'done', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' },
    ];

    el.innerHTML =
      '<div class="pipeline">' +
      phaseNums.map(function(pn, i) {
        var label = PHASE_LABELS[pn] !== undefined ? PHASE_LABELS[pn] : ('Phase ' + pn);
        var iconIdx = Math.min(i, PHASE_ICONS.length - 1);
        var phaseData = phases[pn];
        return (i > 0 ? '<div class="pipeline-arrow">\u2192</div>' : '') +
          '<div class="pipeline-stage">' +
          '<div class="pipeline-stage__icon pipeline-stage__icon--' + PHASE_ICONS[iconIdx].iconClass + '">' + PHASE_ICONS[iconIdx].icon + '</div>' +
          '<span class="pipeline-stage__count">' + phaseData.count + '</span>' +
          '<span class="pipeline-stage__label">' + label + '</span>' +
          '</div>';
      }).join('') +
      '</div>';
  }

  // ── Convoy Detail: Agent Chart ───────────────────────────

  function renderDetailAgentChart(tasks) {
    var el = document.getElementById('agent-chart');
    if (!el) return;

    if (!tasks || tasks.length === 0) {
      el.innerHTML = emptyStateHtml('agents', 'No agent data yet', 'A breakdown of tasks per agent will appear here.');
      return;
    }

    var agentMap = {};
    tasks.forEach(function(t) {
      var agent = t.agent || 'unknown';
      if (!agentMap[agent]) agentMap[agent] = { done: 0, failed: 0, running: 0, other: 0, total: 0 };
      if (t.status === 'done') agentMap[agent].done++;
      else if (t.status === 'running') agentMap[agent].running++;
      else if (['failed', 'gate-failed', 'timed-out', 'hook-failed'].includes(t.status)) agentMap[agent].failed++;
      else agentMap[agent].other++;
      agentMap[agent].total++;
    });

    var agents = Object.entries(agentMap).sort(function(a, b) { return b[1].total - a[1].total; });
    var maxTotal = Math.max.apply(null, agents.map(function(a) { return a[1].total; }));

    el.innerHTML = agents.map(function(entry) {
      var name = entry[0];
      var data = entry[1];
      return '<div class="bar-row">' +
        '<span class="bar-label">' + escapeHtml(name) + '</span>' +
        '<div class="bar-track">' +
        (data.done > 0 ? '<div class="bar-segment bar--success" style="width: ' + ((data.done / maxTotal) * 100).toFixed(1) + '%"></div>' : '') +
        (data.running > 0 ? '<div class="bar-segment" style="width: ' + ((data.running / maxTotal) * 100).toFixed(1) + '%; background: #3b82f6"></div>' : '') +
        (data.failed > 0 ? '<div class="bar-segment bar--failed" style="width: ' + ((data.failed / maxTotal) * 100).toFixed(1) + '%"></div>' : '') +
        (data.other > 0 ? '<div class="bar-segment" style="width: ' + ((data.other / maxTotal) * 100).toFixed(1) + '%; background: #64748b"></div>' : '') +
        '</div>' +
        '<span class="bar-value">' + data.total + '</span>' +
        '</div>';
    }).join('');
  }

  // ── Convoy Detail: Tier Donut Chart ──────────────────────

  function renderDetailTierChart(tasks) {
    var el = document.getElementById('tier-chart');
    if (!el) return;

    if (!tasks || tasks.length === 0) {
      el.innerHTML = emptyStateHtml('tiers', 'No tier data yet', 'Model tier distribution will be shown as a donut chart.');
      return;
    }

    var tierCounts = {};
    tasks.forEach(function(t) {
      var tier = deriveTier(t.model, t.agent);
      tierCounts[tier] = (tierCounts[tier] || 0) + 1;
    });

    var order = ['premium', 'standard', 'utility', 'economy', 'unknown'];
    var tiers = order.filter(function(t) { return tierCounts[t]; }).map(function(t) { return { name: t, count: tierCounts[t] }; });
    var total = tasks.length;
    var r = 70;
    var circumference = 2 * Math.PI * r;
    var cumOffset = 0;

    var circles = tiers.map(function(t) {
      var pct = t.count / total;
      var dashLen = pct * circumference;
      var linecap = tiers.length === 1 ? 'butt' : 'round';
      var segment = '<circle cx="90" cy="90" r="' + r + '" fill="none" stroke="' + (TIER_COLORS[t.name] || '#64748b') + '" stroke-width="18" stroke-dasharray="' + dashLen.toFixed(2) + ' ' + (circumference - dashLen).toFixed(2) + '" stroke-dashoffset="' + (-cumOffset).toFixed(2) + '" transform="rotate(-90 90 90)" stroke-linecap="' + linecap + '"/>';
      cumOffset += dashLen;
      return segment;
    });

    var legend = tiers.map(function(t) {
      return '<div class="legend-item"><span class="legend-dot" style="background: ' + (TIER_COLORS[t.name] || '#64748b') + '"></span><span class="legend-name">' + t.name + '</span><span class="legend-count">' + t.count + ' (' + Math.round((t.count / total) * 100) + '%)</span></div>';
    }).join('');

    el.innerHTML =
      '<div class="donut-container"><div class="donut-wrap"><svg viewBox="0 0 180 180" class="donut-svg">' + circles.join('') + '</svg><div class="donut-center"><span class="donut-total">' + total + '</span><span class="donut-total-label">total</span></div></div><div class="donut-legend">' + legend + '</div></div>';
  }

  // ── Convoy Detail: Mechanism Donut Chart ─────────────────

  function renderDetailMechanismChart(events) {
    var el = document.getElementById('mechanism-chart');
    if (!el) return;

    var MECH_COLORS = { 'sub-agent': '#3b82f6', 'background': '#a78bfa', 'unknown': '#64748b' };
    var MECH_LABELS = { 'sub-agent': 'Sub-agent (inline)', 'background': 'Background (worktree)', 'unknown': 'Unknown' };

    if (!events || events.length === 0) {
      el.innerHTML = emptyStateHtml('mechanism', 'No delegation data yet', 'The split between sub-agent and background delegations will be shown here.');
      return;
    }

    var mechCounts = {};
    events.forEach(function(e) {
      if (e.type === 'task_assigned' || e.type === 'task_started' || e.type === 'delegation') {
        var mech = (e.data && e.data.mechanism) || 'unknown';
        mechCounts[mech] = (mechCounts[mech] || 0) + 1;
      }
    });

    var mechOrder = ['sub-agent', 'background', 'unknown'];
    var mechs = mechOrder.filter(function(m) { return mechCounts[m]; }).map(function(m) { return { name: m, count: mechCounts[m] }; });

    var isAllUnknown = mechs.length === 0 || (mechs.length === 1 && mechs[0].name === 'unknown');
    if (isAllUnknown) {
      el.innerHTML = emptyStateHtml('mechanism', 'No delegation data', 'Delegation mechanism data is not available for this convoy.');
      return;
    }

    var total = mechs.reduce(function(s, m) { return s + m.count; }, 0);
    var r = 70;
    var circumference = 2 * Math.PI * r;
    var cumOffset = 0;

    var circles = mechs.map(function(m) {
      var pct = m.count / total;
      var dashLen = pct * circumference;
      var linecap = mechs.length === 1 ? 'butt' : 'round';
      var segment = '<circle cx="90" cy="90" r="' + r + '" fill="none" stroke="' + (MECH_COLORS[m.name] || '#64748b') + '" stroke-width="18" stroke-dasharray="' + dashLen.toFixed(2) + ' ' + (circumference - dashLen).toFixed(2) + '" stroke-dashoffset="' + (-cumOffset).toFixed(2) + '" transform="rotate(-90 90 90)" stroke-linecap="' + linecap + '"/>';
      cumOffset += dashLen;
      return segment;
    });

    var legend = mechs.map(function(m) {
      return '<div class="legend-item"><span class="legend-dot" style="background: ' + (MECH_COLORS[m.name] || '#64748b') + '"></span><span class="legend-name">' + (MECH_LABELS[m.name] || m.name) + '</span><span class="legend-count">' + m.count + ' (' + Math.round((m.count / total) * 100) + '%)</span></div>';
    }).join('');

    el.innerHTML =
      '<div class="donut-container"><div class="donut-wrap"><svg viewBox="0 0 180 180" class="donut-svg">' + circles.join('') + '</svg><div class="donut-center"><span class="donut-total">' + total + '</span><span class="donut-total-label">total</span></div></div><div class="donut-legend">' + legend + '</div></div>';
  }

  // ── Convoy Detail: Model Chart ───────────────────────────

  function renderDetailModelChart(tasks) {
    var el = document.getElementById('model-chart');
    if (!el) return;

    if (!tasks || tasks.length === 0) {
      el.innerHTML = emptyStateHtml('models', 'No model data yet', 'Model utilization across tasks will be shown here.');
      return;
    }

    var modelCounts = {};
    tasks.forEach(function(t) {
      var model = deriveModel(t.model, t.agent);
      if (model) modelCounts[model] = (modelCounts[model] || 0) + 1;
    });

    var models = Object.entries(modelCounts).sort(function(a, b) { return b[1] - a[1]; });

    if (models.length === 0) {
      el.innerHTML = emptyStateHtml('models', tasks.length > 0 ? 'Model information unavailable' : 'No model data yet', tasks.length > 0 ? 'No model information was recorded for tasks in this convoy.' : 'Model utilization across tasks will be shown here.');
      return;
    }

    var maxCount = Math.max.apply(null, models.map(function(m) { return m[1]; }));

    el.innerHTML = models.map(function(entry) {
      var name = entry[0];
      var count = entry[1];
      return '<div class="bar-row">' +
        '<span class="bar-label">' + escapeHtml(name) + '</span>' +
        '<div class="bar-track"><div class="bar-segment" style="width: ' + ((count / maxCount) * 100).toFixed(1) + '%; background: ' + (MODEL_COLORS[name] || '#64748b') + '"></div></div>' +
        '<span class="bar-value">' + count + '</span>' +
        '</div>';
    }).join('');
  }

  // ── Convoy Detail: Execution Log ─────────────────────────

  function renderDetailExecutionLog(tasks) {
    var el = document.getElementById('execution-log');
    if (!el) return;

    if (!tasks || tasks.length === 0) {
      el.innerHTML = emptyStateHtml('execLog', 'No execution history yet', 'A step-by-step trace of task activity will appear here.');
      return;
    }

    var allSorted = tasks.slice().filter(function(t) { return t.started_at; }).sort(function(a, b) { return new Date(a.started_at) - new Date(b.started_at); });
    var sorted = allSorted.slice(0, executionLogLimit);

    if (sorted.length === 0) {
      el.innerHTML = emptyStateHtml('execLog', 'No execution history yet', 'A step-by-step trace of task activity will appear here.');
      return;
    }

    var statusToOutcome = function(s) {
      if (s === 'done') return 'success';
      if (['failed', 'gate-failed', 'timed-out', 'hook-failed'].includes(s)) return 'failed';
      return 'partial';
    };

    el.innerHTML =
      '<div class="exec-log">' +
      sorted.map(function(t, i) {
        var outcome = statusToOutcome(t.status);
        var dur = formatDuration(t.started_at, t.finished_at);
        var fileCount = t.files ? t.files.length : 0;
        return '<div class="exec-step">' +
          '<div class="exec-step__indicator">' +
          '<div class="exec-step__dot exec-step__dot--' + outcome + '">' + (OUTCOME_ICONS[outcome] || '') + '</div>' +
          (i < sorted.length - 1 ? '<div class="exec-step__line"></div>' : '') +
          '</div>' +
          '<div class="exec-step__content">' +
          '<div class="exec-step__header">' +
          '<span class="exec-step__agent">' + escapeHtml(t.agent || 'unknown') + '</span>' +
          '<span class="exec-step__badge exec-step__badge--' + outcome + '">' + escapeHtml(t.status) + '</span>' +
          '</div>' +
          '<div class="exec-step__task">' + escapeHtml(t.id) + '</div>' +
          '<div class="exec-step__meta">' +
          '<span class="exec-step__meta-item">\uD83D\uDD52 ' + formatTime(t.started_at) + '</span>' +
          (dur ? '<span class="exec-step__meta-item">\u23F1 ' + dur + '</span>' : '') +
          (fileCount > 0 ? '<span class="exec-step__meta-item">\uD83D\uDCC1 ' + fileCount + ' files</span>' : '') +
          (t.model ? '<span class="exec-step__meta-item">\uD83E\uDD16 ' + escapeHtml(t.model) + '</span>' : '') +
          (t.retries > 0 ? '<span class="exec-step__meta-item">\uD83D\uDD04 ' + t.retries + ' retries</span>' : '') +
          (t.total_tokens != null ? '<span class="exec-step__meta-item">\uD83D\uDD24 ' + formatTokens(t.total_tokens) + '</span>' : '') +
          '</div>' +
          '</div>' +
          '</div>';
      }).join('') +
      '</div>';
    if (allSorted.length > executionLogLimit) {
      var remaining = allSorted.length - executionLogLimit;
      el.innerHTML += '<div style="text-align:center;padding:16px"><button class="dash-btn dash-btn--ghost" id="exec-log-more-btn" type="button">Show more (' + remaining + ' remaining)</button></div>';
      document.getElementById('exec-log-more-btn')?.addEventListener('click', function() {
        executionLogLimit = allSorted.length;
        var convoy = window.__SELECTED_CONVOY__;
        renderDetailExecutionLog((convoy && convoy.tasks) ? convoy.tasks : []);
      });
    }
  }

  // ── Convoy Detail: Panel Reviews ─────────────────────────

  function renderDetailPanelChart(tasks) {
    var el = document.getElementById('panel-chart');
    if (!el) return;

    var panelTasks = (tasks || []).filter(function(t) { return t.panel_attempts > 0; });

    if (panelTasks.length === 0) {
      el.innerHTML = emptyStateHtml('panels', 'No panel reviews', 'This convoy completed without requiring panel reviews.');
      return;
    }

    el.innerHTML =
      '<div class="panel-grid">' +
      panelTasks.map(function(t) {
        var verdictUpper = t.review_verdict ? t.review_verdict.toUpperCase() : 'PENDING';
        var verdictClass = verdictUpper === 'PASS' ? 'PASS' : 'BLOCK';
        return '<div class="panel-item">' +
          '<div class="panel-item__header">' +
          '<span class="panel-item__key">' + escapeHtml(t.id) + '</span>' +
          '<span class="panel-item__verdict panel-item__verdict--' + verdictClass + '">' + verdictUpper + '</span>' +
          '</div>' +
          '<div class="panel-item__votes">' +
          (verdictUpper === 'PASS' ? '<div class="panel-item__vote panel-item__vote--pass">\u2713</div>' : '<div class="panel-item__vote panel-item__vote--block">\u2717</div>') +
          '</div>' +
          '<div class="panel-item__meta">' +
          '<span class="panel-item__meta-item">\uD83E\uDD16 ' + escapeHtml(t.review_model || 'unknown') + '</span>' +
          (t.panel_attempts > 1 ? '<span class="panel-item__meta-item">\uD83D\uDD04 ' + t.panel_attempts + ' attempts</span>' : '') +
          (t.review_tokens != null ? '<span class="panel-item__meta-item">\uD83D\uDD24 ' + formatTokens(t.review_tokens) + '</span>' : '') +
          '</div>' +
          '</div>';
      }).join('') +
      '</div>';
  }

  // ── Convoy Detail: Fast Reviews ──────────────────────────

  function renderDetailReviewsTable(tasks) {
    var el = document.getElementById('reviews-table');
    if (!el) return;

    var reviewedTasks = (tasks || []).filter(function(t) { return t.review_level != null; });

