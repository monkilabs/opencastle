  // ── Active Convoy Polling ──────────────────────────────────
  let _activePollingTimer = null;
  let _activePollingConvoyId = null;
  let _lastPolledConvoyStatus = null;

  function startActiveConvoyPolling() {
    if (_activePollingTimer) return; // already polling
    _activePollingTimer = setInterval(pollActiveConvoy, 3000);
    // Also poll immediately
    pollActiveConvoy();
  }

  function stopActiveConvoyPolling() {
    if (_activePollingTimer) {
      clearInterval(_activePollingTimer);
      _activePollingTimer = null;
    }
  }

  async function pollActiveConvoy() {
    try {
      const resp = await fetch(base + 'data/active-convoy.json');
      if (!resp.ok) return;
      const data = await resp.json();

      if (!data.convoy) return; // no convoy yet — keep polling

      const convoy = data.convoy;
      const isRunningOrPending = convoy.status === 'running' || convoy.status === 'pending';

      // If we haven't navigated to any convoy yet, navigate now
      if (!_activePollingConvoyId) {
        _activePollingConvoyId = convoy.id;
        _lastPolledConvoyStatus = null;
        // Refresh ETL data so convoy detail JSON exists
        await fetch(base + 'data/refresh');
        // Re-fetch the convoy list and stats
        await refreshDashboardData();
        showConvoyDetailView(convoy.id, convoy.name || convoy.id);
        removeWaitingBanner();
      }

      // If we're on a convoy and a new one started (pipeline chain), follow it
      if (_activePollingConvoyId !== convoy.id && isRunningOrPending) {
        _activePollingConvoyId = convoy.id;
        _lastPolledConvoyStatus = null;
        await fetch(base + 'data/refresh');
        await refreshDashboardData();
        showConvoyDetailView(convoy.id, convoy.name || convoy.id);
      }

      // If we're viewing the active convoy, refresh when it's running or just transitioned
      if (_activePollingConvoyId === convoy.id) {
        const statusChanged = _lastPolledConvoyStatus !== null && _lastPolledConvoyStatus !== convoy.status;
        _lastPolledConvoyStatus = convoy.status;

        if (isRunningOrPending || statusChanged) {
          await fetch(base + 'data/refresh');
          await refreshDashboardData();
          // Reload convoy detail to show latest task progress
          await loadConvoyDetail(convoy.id);

          // Update pipeline chain breadcrumb if applicable
          if (data.pipeline && data.pipeline.length > 1) {
            renderPipelineChain(data.pipeline, convoy.id);
          }
        }
      }

      // NOTE: In 'active' mode we intentionally keep polling even after a convoy finishes,
      // so that subsequent convoys are detected when they start.
    } catch {
      // Polling errors are non-fatal — just retry next interval
    }
  }

  async function refreshDashboardData() {
    try {
      const [statsResp, listResp] = await Promise.all([
        fetch(base + 'data/overall-stats.json'),
        fetch(base + 'data/convoy-list.json'),
      ]);
      if (statsResp.ok) {
        window.__DASHBOARD_DATA__.overallStats = await statsResp.json();
      }
      if (listResp.ok) {
        window.__DASHBOARD_DATA__.convoyList = await listResp.json();
      }
      renderOverallStats();
      renderConvoyList();
      renderActivityTimeline();
      renderRecentSessions();
    } catch {
      // Non-fatal
    }
  }

  function renderPipelineChain(pipelineConvoys, activeConvoyId) {
    let chainEl = document.getElementById('pipeline-chain-nav');
    if (!chainEl) {
      chainEl = document.createElement('div');
      chainEl.id = 'pipeline-chain-nav';
      chainEl.className = 'pipeline-chain-nav';
      const breadcrumbs = document.getElementById('breadcrumbs');
      if (breadcrumbs) breadcrumbs.after(chainEl);
    }

    const statusDot = (status) => {
      const colors = { done: '#4ade80', running: '#60a5fa', pending: '#94a3b8', failed: '#f87171', 'gate-failed': '#fb923c' };
      return '<span class="pipeline-chain__dot" style="background:' + (colors[status] || '#94a3b8') + '"></span>';
    };

    let html = '<div class="pipeline-chain__label">Pipeline:</div>';
    for (const c of pipelineConvoys) {
      const isActive = c.id === activeConvoyId;
      html += '<button class="pipeline-chain__item' + (isActive ? ' pipeline-chain__item--active' : '') + '" data-convoy-id="' + escapeHtml(c.id) + '">' +
        statusDot(c.status) + escapeHtml(c.name || c.id) + '</button>';
    }
    chainEl.innerHTML = html;

    chainEl.querySelectorAll('button[data-convoy-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.convoyId;
        const name = btn.textContent.trim();
        _activePollingConvoyId = id;
        showConvoyDetailView(id, name);
      });
    });
  }

