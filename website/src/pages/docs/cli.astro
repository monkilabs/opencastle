---
import '../../styles/global.css';

const title = 'CLI Reference — OpenCastle';
const description = 'Complete reference for every opencastle CLI command. Set up, compile, diagnose, and share one AI assistant standard across a team.';

/* ---------- Sidebar category icons ---------- */
const categoryIcons: Record<string, string> = {
  setup: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  lifecycle: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`,
  runtime: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>`,
  diagnostics: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  teams: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
};

const categories = [
  { id: 'setup', label: 'Setup', icon: categoryIcons.setup },
  { id: 'lifecycle', label: 'Lifecycle', icon: categoryIcons.lifecycle },
  { id: 'runtime', label: 'Runtime', icon: categoryIcons.runtime },
  { id: 'diagnostics', label: 'Diagnostics', icon: categoryIcons.diagnostics },
  { id: 'teams', label: 'Teams', icon: categoryIcons.teams },
];

/* ---------- Command data ---------- */
const commands = [
  {
    id: 'status',
    category: 'setup',
    name: '(no command)',
    summary: 'Show project status and what to run next',
    description: 'Running <code>opencastle</code> with no arguments reports which assistants it compiles for, whether the generated files are current, which assistants are configured in the repo but not being compiled, and the single command that resolves whatever it found. It is the one command worth remembering.',
    usage: 'npx opencastle',
    options: [
      { flag: '--json', desc: 'Machine-readable output' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [],
    examples: [
      { cmd: 'npx opencastle', desc: 'Status and the next step' },
      { cmd: 'npx opencastle --json', desc: 'Same, for scripts' },
    ],
  },
  {
    id: 'init',
    category: 'setup',
    name: 'init',
    summary: 'Set up this project',
    description: 'Reads the repository, proposes a complete setup, and asks once. Detects which assistants already have config, which framework, database, and test runner the project uses, then compiles the config for every assistant it found.',
    usage: 'npx opencastle init [options]',
    options: [
      { flag: '--customize, --reconfigure', desc: 'Choose IDEs and integrations manually instead of accepting detection' },
      { flag: '--yes, -y', desc: 'Accept the detected setup without asking' },
      { flag: '--dry-run', desc: 'Preview what would be created without writing anything' },
      { flag: '--allow-downgrade', desc: 'Re-run with this OpenCastle even though a newer one compiled the project' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What it does', content: `<ol>
        <li><strong>Finds your assistants</strong> — any of <code>CLAUDE.md</code> or <code>.claude/</code>, <code>.cursorrules</code> or <code>.cursor/rules</code>, <code>.github/copilot-instructions.md</code>, <code>.windsurfrules</code> or <code>.windsurf/rules</code>, <code>GEMINI.md</code>, <code>.codex</code>, or <code>opencode.json</code> makes that assistant a compile target. <code>AGENTS.md</code> counts, as Codex CLI, only when none of those is present.</li>
        <li><strong>Scans the stack</strong> — frameworks, databases, CMSes, deployment targets, test runners, monorepo tools — and writes what it read into <code>.opencastle/</code>: versions, commands, routes, models, migrations, environment variable names. JavaScript and TypeScript projects are read from <code>package.json</code>; Python ones from <code>pyproject.toml</code> or <code>requirements.txt</code> (FastAPI, Django, Flask), Go ones from <code>go.mod</code> (Gin, Echo, chi, Fiber); a Makefile, justfile or <code>scripts/</code> adds its commands to any of them. A Python or Go service with no web interface gets no TypeScript or web-interface rules, and no browser to test with.</li>
        <li><strong>Shows the plan and asks once</strong> — then compiles agents, skills, instructions, and MCP config for each target. On a project that is already set up it asks <code>Re-initialize? [y/N]</code> first.</li>
        <li><strong>Leaves your writing alone</strong> — what you wrote in <code>CLAUDE.md</code>, <code>.cursorrules</code> and the other root files stays above a managed block. A file of yours inside a directory OpenCastle generates (<code>.cursor/rules/</code>, <code>.claude/agents/</code>, <code>.agents/skills/</code>, …) is named in the summary and removed by the next <code>sync</code>; move it into <code>.opencastle/</code> and it is compiled for every assistant.</li>
      </ol>` },
    ],
    examples: [
      { cmd: 'npx opencastle init', desc: 'Detect, show the plan, confirm once' },
      { cmd: 'npx opencastle init --yes', desc: 'No prompts, for CI or scripted setup' },
      { cmd: 'npx opencastle init --customize', desc: 'Pick IDEs and integrations by hand' },
    ],
  },
  {
    id: 'sync',
    category: 'lifecycle',
    name: 'sync',
    summary: 'Recompile every target from source',
    description: 'Compiles the framework sources into each configured assistant format, preserving everything under <code>.opencastle/</code>. Run it after upgrading the package, or when <code>opencastle</code> reports that generated files are older than their sources.',
    usage: 'npx opencastle sync [options]',
    options: [
      { flag: '--check', desc: 'Compare against a fresh compile and exit non-zero on drift; writes nothing' },
      { flag: '--json', desc: 'Machine-readable report (with --check)' },
      { flag: '--dry-run', desc: 'Preview what would change' },
      { flag: '--force', desc: 'Recompile even when everything already matches its sources' },
      { flag: '--allow-downgrade', desc: 'Recompile with this OpenCastle, or an installed baseline, even though a newer one compiled the project' },
      { flag: '--reconfigure', desc: 'Choose the integrations again (tech and team tools); to change assistants, run init --customize' },
      { flag: '--yes', desc: 'Skip confirmation prompts' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What is preserved', content: `<p><code>.opencastle/</code> is never overwritten, nor your text around the managed block in a root file. Generated directories are rewritten whole, so a file of yours placed in one is removed; keep it in <code>.opencastle/</code>. An MCP server entry you edited stays as you left it; one still exactly as an earlier release wrote it is updated to the current default, and named.</p>` },
      { heading: 'Team sources and the lock', content: `<p><code>sync</code> writes <code>.opencastle/lock.json</code>, the record of what every assistant is given; commit it. When <code>.opencastle/config.json</code> exists, it is resolved first — baselines, the project's own content, MCP servers, policy — and any error, such as a baseline that is not installed or a server the policy refuses, means nothing is written. See <a href="/docs/teams">OpenCastle for Teams</a>.</p>
<p>A project compiled by a newer OpenCastle than the one you run is refused, and so is an installed baseline older than the one the lock records (run <code>npm install</code>). <code>--allow-downgrade</code> goes back on purpose.</p>` },
      { heading: 'sync --check', content: `<p>Compiles to a scratch directory and compares, writing nothing. It fails when a generated file was edited by hand or not recompiled, when the lock is missing or stale, when the team's sources do not resolve or break the policy, and on any MCP problem <code>doctor</code> fails on. On GitHub Actions it annotates each drifted file with its fix and writes a table to the job summary; <code>--json</code> leaves the annotations out.</p>
<p><a href="#ci"><code>opencastle ci</code></a> writes the GitHub Actions workflow. On any other CI, install dependencies, with <code>opencastle</code> as a devDependency, and run <code>npx opencastle sync --check</code>.</p>` },
      { heading: 'Previously called update', content: `<p><code>opencastle update</code> still works.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle sync', desc: 'Recompile all targets' },
      { cmd: 'npx opencastle sync --check', desc: 'Fail on drift, for CI' },
      { cmd: 'npx opencastle sync --dry-run', desc: 'See what would change' },
    ],
  },
  {
    id: 'add',
    category: 'lifecycle',
    name: 'add',
    summary: 'Adopt an integration and recompile',
    description: 'Adds one or more packs — a framework, database, CMS, deployment target, or team tool — to the project and recompiles so its skills and MCP configuration reach every target.',
    usage: 'npx opencastle add <pack>...',
    options: [
      { flag: '--list', desc: 'Show every available pack' },
      { flag: '--dry-run', desc: 'Preview without writing' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [],
    examples: [
      { cmd: 'npx opencastle add supabase', desc: 'Add one integration' },
      { cmd: 'npx opencastle add nextjs vercel sentry', desc: 'Add several at once' },
      { cmd: 'npx opencastle add --list', desc: 'See what is available' },
    ],
  },
  {
    id: 'doctor',
    category: 'diagnostics',
    name: 'doctor',
    summary: 'Diagnose setup problems',
    description: 'Checks the manifest, per-assistant generated files, the skill matrix, MCP configuration, and required environment variables, audits what each MCP config launches, and says how to fix what it can. It also says when <code>.opencastle/project.instructions.md</code> is still a template, how much is left to describe, and when the lessons index agents read before every task has grown past about 2,000 tokens.',
    usage: 'npx opencastle doctor [options]',
    options: [
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What it checks in MCP configs', content: `<p>Every target's MCP config, including servers you added yourself:</p>
<ul>
  <li><strong>Warning</strong> — a package launched without an exact version (<code>@latest</code>, a range, or none), so each machine runs whatever was published last. A failure instead when the team's policy sets <code>requirePinned</code>.</li>
  <li><strong>Failure</strong> — a package OpenCastle knows is not on npm (one an earlier release wrote, or one since unpublished), or a remote server in <code>.mcp.json</code> with no <code>"type"</code>, which Claude Code reads as a stdio server and never loads.</li>
  <li><strong>Failure</strong> — a credential written into the file, or a server the team's policy does not allow, whether by name or by the host it connects to.</li>
</ul>
<p>Each finding names its fix.</p>` },
      { heading: 'Team sources and lessons', content: `<ul>
  <li><strong>Team sources</strong> — <code>.opencastle/config.json</code> and the baselines it extends resolve, and what they contribute.</li>
  <li><strong>Always-loaded context</strong> — the tokens every assistant loads before a task (instructions plus the skill and agent index, estimated at four characters per token), against the budget a layer set; a warning past it, naming the three largest contributors.</li>
  <li><strong>Team instructions match this repository</strong> — <code>npm run</code> scripts named in team content that <code>package.json</code> does not define, and backticked paths in the project's own content that do not exist.</li>
  <li><strong>OpenCastle version</strong> — a failure when you run an older release than the one that compiled the project.</li>
  <li><strong>Lessons</strong> — one whose cited code changed since it was verified, with <a href="#lesson"><code>lesson verify</code> or <code>lesson archive</code></a> as the fix.</li>
</ul>` },
    ],
    examples: [
      { cmd: 'npx opencastle doctor', desc: 'Run all checks' },
    ],
  },
  {
    id: 'remove',
    category: 'lifecycle',
    name: 'remove',
    summary: 'Remove OpenCastle from this project',
    description: 'Asks whether to keep the generated files — making them standalone so you can uninstall the package — or delete everything it created. Always previews before touching anything.',
    usage: 'npx opencastle remove [options]',
    options: [
      { flag: '--keep-files', desc: 'Keep generated files; drop only the manifest' },
      { flag: '--all', desc: 'Delete every generated file' },
      { flag: '--dry-run', desc: 'Preview without changing anything' },
      { flag: '--yes', desc: 'Skip the confirmation' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What --all keeps', content: `<p>A file that also holds your writing — <code>CLAUDE.md</code>, <code>.cursorrules</code>, <code>opencode.json</code> — loses only the OpenCastle block or servers. <code>.opencastle/</code> is moved to <code>.opencastle.removed/</code>, with your conventions and lessons, for you to delete when you are sure.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle remove', desc: 'Ask, then remove' },
      { cmd: 'npx opencastle remove --keep-files', desc: 'Make the files standalone' },
      { cmd: 'npx opencastle remove --all --dry-run', desc: 'See exactly what a full delete would remove' },
    ],
  },
  {
    id: 'convoy',
    category: 'runtime',
    name: 'convoy',
    summary: 'Experimental: plan multi-step work and run it with agents in parallel',
    description: 'Plans multi-step work without changing anything, shows you the plan and asks once, then runs it on the agent runtime <code>opencastle init</code> set up: each task in its own git worktree, independent tasks at the same time, the result on a branch of its own. Your checkout is never touched. Runs are recorded in <code>.opencastle/convoy.db</code>, so an interrupted or failed run resumes instead of starting over. Worked runs, with their time and cost, are on <a href="/docs/use-cases">Use cases</a>.',
    usage: 'npx opencastle convoy [task] [options]',
    options: [
      { flag: '--yes, -y', desc: 'With a task: run the plan without asking' },
      { flag: '--dry-run', desc: 'With a task: plan and write the spec, but do not run it. With run or resume: show what would run' },
      { flag: '--adapter, -a <name>', desc: 'Agent runtime: claude, codex, cursor, opencode or copilot (default: the one opencastle init set up)' },
      { flag: '--concurrency, -c <n>', desc: 'Tasks at once, 1 to 50' },
      { flag: '--verbose', desc: 'Stream agent output' },
      { flag: '--json', desc: 'With no task: the last run, as JSON' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'Subcommands', content: `<table>
        <thead><tr><th>Command</th><th>What it does</th><th>Its options</th></tr></thead>
        <tbody>
          <tr><td><code>opencastle convoy</code></td><td>The last run and the one next step</td><td><code>--json</code></td></tr>
          <tr><td><code>opencastle convoy "&lt;task&gt;"</code></td><td>Plan it, show the plan, ask, then run it</td><td><code>--yes</code>, <code>--dry-run</code>, <code>--adapter</code>, <code>--concurrency</code>, <code>--verbose</code></td></tr>
          <tr><td><code>opencastle convoy run &lt;spec.yml&gt;</code></td><td>Run a spec, one you wrote or one the planner wrote to <code>.opencastle/convoys/</code></td><td><code>--dry-run</code>, <code>--adapter</code>, <code>--concurrency</code>, <code>--verbose</code></td></tr>
          <tr><td><code>opencastle convoy resume</code></td><td>Continue the newest run that is not done. <code>retry</code> is another name for it</td><td><code>--dry-run</code>, <code>--adapter</code>, <code>--concurrency</code>, <code>--verbose</code></td></tr>
          <tr><td><code>opencastle convoy dashboard</code></td><td>The Observability dashboard, live, on 127.0.0.1: totals across every run, and for each run its tasks and what they wait for, tokens and cost, reviews, checks, retries, failure reasons and the event timeline, read from <code>.opencastle/convoy.db</code></td><td><code>--port &lt;n&gt;</code> (default 4300, moving up while busy; 0 picks a free one), <code>--no-open</code></td></tr>
          <tr><td><code>opencastle convoy plan --prd &lt;file&gt;</code></td><td>Plan again from a PRD you edited</td><td><code>--yes</code>, <code>--dry-run</code>, <code>--adapter</code>, <code>--concurrency</code>, <code>--verbose</code></td></tr>
        </tbody>
      </table>
<p>Each subcommand has its own help: <code>opencastle convoy run --help</code>.</p>` },
      { heading: 'Plan, ask, run', content: `<p><code>opencastle convoy "&lt;task&gt;"</code> plans without changing anything. A small change is planned straight from the request; larger work first gets a PRD in <code>.opencastle/prds/</code>, reviewed while the tasks are planned from it. The spec goes to <code>.opencastle/convoys/</code>, and the plan is printed as a table — each task, its agent, what it waits for and the files it may change — with the branch, the runtime and the checks that run at the end. Then it asks <code>Run it? [Y/n]</code>.</p>
<ul>
  <li><code>--yes</code> runs it without asking, after one more agent session reviews the plan.</li>
  <li>No answer — stdin closed, as in a script — means no: nothing runs, and the command to run it later is printed.</li>
  <li><code>--dry-run</code> stops after writing the spec.</li>
</ul>
<p>A run prints each task as it starts and finishes, with its time and cost. It ends with the branch and the <code>git diff</code> and <code>git merge</code> commands for it, the lessons workers recorded (committed on the branch, so they are reviewed with the work), the bugs they found outside their tasks, and the tokens and cost spent. On a terminal outside CI it also starts the live dashboard. Ctrl+C stops the agents and exits 130; <code>opencastle convoy resume</code> carries on. It exits 0 when every task is done and every check passed, 1 otherwise.</p>` },
      { heading: 'Runtime', content: `<p>The runtime is the first of: <code>--adapter</code>, the spec's <code>adapter</code>, the assistant <code>opencastle init</code> set up, or the first agent CLI found on PATH. A runtime that is named but not installed is an error, never a quiet switch to another. The run's first lines say which it chose and why.</p>
<table>
  <thead><tr><th>Assistant set up by init</th><th>Runtime</th><th>Command</th></tr></thead>
  <tbody>
    <tr><td>Claude Code</td><td><code>claude</code></td><td><code>claude</code></td></tr>
    <tr><td>VS Code (GitHub Copilot)</td><td><code>copilot</code></td><td><code>copilot</code></td></tr>
    <tr><td>Cursor</td><td><code>cursor</code></td><td><code>cursor-agent</code> (or Cursor's <code>agent</code>)</td></tr>
    <tr><td>OpenCode</td><td><code>opencode</code></td><td><code>opencode</code></td></tr>
    <tr><td>Codex CLI</td><td><code>codex</code></td><td><code>codex</code></td></tr>
  </tbody>
</table>
<p>Windsurf and Antigravity have no command-line agent; a project set up only for them runs on the first agent CLI found on PATH, or the one <code>--adapter</code> names.</p>` },
      { heading: 'Models', content: `<p>A task with no <code>model</code> in its spec runs on its agent's capability tier. Claude Code maps premium, standard and economy to its own <code>opus</code>, <code>sonnet</code> and <code>haiku</code> aliases; reviews run on economy, and the planner writes on standard and checks on economy. The other runtimes run on their own default model. A <code>model</code> in the spec, on a task or under <code>defaults</code>, always wins.</p>` },
      { heading: 'Experimental', content: `<p>This namespace may change or be removed. The compiler does not depend on it. How it works inside is in <a href="https://github.com/monkilabs/opencastle/blob/main/ARCHITECTURE.md#convoy-architecture">ARCHITECTURE.md</a>.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle convoy "Add tags to notes, and reject a note without a title"', desc: 'Plan, show the plan, ask, run' },
      { cmd: 'npx opencastle convoy', desc: 'Where the last run stands, and what to do next' },
      { cmd: 'npx opencastle convoy run .opencastle/convoys/note-tags.convoy.yml --dry-run', desc: 'Check a spec and see what would run' },
      { cmd: 'npx opencastle convoy resume', desc: 'Continue what is not done' },
      { cmd: 'npx opencastle convoy dashboard --no-open', desc: 'Print the dashboard\'s address without opening a browser' },
    ],
  },
  {
    id: 'explain',
    category: 'teams',
    name: 'explain',
    summary: 'What every assistant here is given, and what you need to set up',
    description: 'Onboarding in one command. Resolves the project exactly as <code>sync</code> does and shows the layers, what every assistant loads before each task and what it costs, the team\'s skills, agents, prompts and workflows by where they come from, the MCP servers every assistant can start, the team\'s policy, and — under <em>Your setup</em> — the environment variables you have not set and the servers that will ask you to sign in.',
    usage: 'npx opencastle explain [options]',
    options: [
      { flag: '--all', desc: 'List OpenCastle\'s own skills, agents, commands and workflows one by one too, not only the team\'s' },
      { flag: '--json', desc: 'Machine-readable output' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What it shows', content: `<pre><code>  🏰 What the AI assistants in this repository are given

  Layers  OpenCastle 1.0.0 → @acme/opencastle-baseline 1.5.0 → this project  (later layers add to and override earlier ones)
  Targets Claude Code, Cursor, VS Code, OpenCode

  Always loaded — ~2779 tokens before every task: instructions ~613, the skill and agent index ~2167
  …
  Your setup
    ✗ ACME_DOCS_TOKEN — used by the internal-docs MCP server (@acme/opencastle-baseline/dev.opencastle/config.json); set it in .env or your shell
    ✗ ACME_DB_URL — used by the acme-db MCP server (.opencastle/config.json); set it in .env or your shell
    → Linear: your assistant opens a browser to sign in the first time it starts the server
  …</code></pre>
<p>The full run is in the <a href="/docs/teams#example">worked example</a>. A variable counts as set when it is in your shell or in <code>.env</code> at the project root. Warnings about the team's sources are listed at the end. It exits 1, saying why, when the sources do not resolve.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle explain', desc: 'What this repository gives every assistant' },
      { cmd: 'npx opencastle explain --all --json', desc: 'Everything, for a script' },
    ],
  },
  {
    id: 'review',
    category: 'teams',
    name: 'review',
    summary: 'What a change does to the assistants, for pull requests',
    description: 'Reads <code>.opencastle/lock.json</code> as committed at a base ref, compares it with what the current sources compile to, and says in sentences what every assistant gains, loses or gets changed: baselines and their versions, skills, agents and always-loaded instructions, MCP servers, policy, and context size. What deserves a careful look is marked ⚠️.',
    usage: 'npx opencastle review [options]',
    options: [
      { flag: '--base <ref>', desc: 'What to compare against (default: HEAD; on a GitHub Actions pull request, origin/<base branch>)' },
      { flag: '--markdown', desc: 'Print Markdown, e.g. for a pull request comment' },
      { flag: '--json', desc: 'Machine-readable output' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What gets ⚠️', content: `<ul>
  <li>A baseline added or dropped, or one whose contents changed without a version change</li>
  <li>A new or changed always-loaded instruction, and a required item that moved or was removed</li>
  <li>Every new MCP server, and one that now launches differently, reads different variables, or has different environment values or headers (a version bump of the same package is not marked)</li>
  <li>An allowlist or host list widened or removed, pinning no longer required, an item no longer required, the context budget removed</li>
  <li>Always-loaded context up by more than 10%, or over the budget</li>
</ul>` },
      { heading: 'In CI', content: `<p>On GitHub Actions the Markdown is also appended to the job summary, beside the drift table <code>sync --check</code> writes. The base defaults to <code>origin/&lt;base branch&gt;</code> there, so check out with <code>fetch-depth: 0</code>. When the committed lock is not what the sources compile to, it says so first.</p>
<p>It explains; it does not gate. It exits 0 whatever the change is, and 1 only when it cannot compare — not a git repository, a base that is not a commit here, or sources that do not resolve. <code>sync --check</code> is the gate.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle review', desc: 'What your uncommitted changes do, compared with HEAD' },
      { cmd: 'npx opencastle review --base origin/main --markdown', desc: 'A branch, as Markdown for a pull request' },
    ],
  },
  {
    id: 'ci',
    category: 'teams',
    name: 'ci',
    summary: 'Add the drift and policy check to GitHub Actions',
    description: 'Writes <code>.github/workflows/opencastle.yml</code>: check out with full history, set up Node 22, install dependencies with the package manager your lockfile names so baselines resolve, run <code>sync --check</code>, and on pull requests run <code>review</code> against the base branch.',
    usage: 'npx opencastle ci [options]',
    options: [
      { flag: '--owners <team>', desc: 'Also route changes to .opencastle/lock.json and .opencastle/config.json to these reviewers in CODEOWNERS' },
      { flag: '--force', desc: 'Replace an existing workflow file' },
      { flag: '--dry-run', desc: 'Print what would be written, and write nothing' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'Which OpenCastle it runs', content: `<p>When <code>opencastle</code> is one of the project's devDependencies, the workflow runs that copy — <code>npx --no opencastle</code>, <code>pnpm exec opencastle</code> or <code>yarn opencastle</code> — so laptops and CI run the version the lockfile pins. Otherwise it pins the release that last compiled the project, <code>npx -y opencastle@&lt;version&gt;</code>, and suggests adding the devDependency.</p>` },
      { heading: 'Monorepos and CODEOWNERS', content: `<p>Run from a subdirectory, it writes <code>opencastle-&lt;dir&gt;.yml</code> at the repository root, filtered to that directory's paths and running in it, and installs dependencies where the lockfile is. <code>--owners</code> appends two lines, for the lock and the team config, to the CODEOWNERS file GitHub reads — <code>.github/</code>, the root or <code>docs/</code>, the first it finds — creating <code>.github/CODEOWNERS</code> only when there is none, and leaves the file alone if it already routes the lock.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle ci --owners @acme/platform', desc: 'Workflow plus owners for what assistants are given' },
      { cmd: 'npx opencastle ci --dry-run', desc: 'See the workflow first' },
    ],
  },
  {
    id: 'baseline',
    category: 'teams',
    name: 'baseline',
    summary: 'Create or check a baseline many repositories extend',
    description: 'A baseline is an npm package that carries an organisation\'s instructions, skills, agents, MCP servers and policy. Repositories install it as a devDependency and name it in <code>extends</code>. One that <code>init</code> creates is also an <a href="/docs/agent-plugins">Agent Plugin</a>, so assistants that read Agent Plugins can install it as it is. <code>init</code> scaffolds one; <code>check</code> validates it the way every repository extending it will, and the way assistants load it.',
    usage: 'npx opencastle baseline <init|check> [dir] [options]',
    options: [
      { flag: '--name <pkg>', desc: 'Package name for init (default: @your-org/opencastle-baseline)' },
      { flag: '--json', desc: 'Machine-readable output for check' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'init', content: `<p>Creates <code>./opencastle-baseline</code>, or the directory you name, laid out as an Agent Plugin: <code>plugin.json</code>, an example skill in <code>skills/code-review/</code>, <code>mcp.json</code> for servers any assistant can start as they are, and in <code>dev.opencastle/</code> what the standard does not cover — an example instruction and the policy, in <code>config.json</code>. Also Claude Code's <code>.claude-plugin/plugin.json</code>, a <code>package.json</code> declaring <code>"opencastle": { "baseline": "." }</code>, a README on publishing and adopting it, and a workflow that runs <code>check</code>. It refuses a directory that already has a <code>package.json</code>.</p>` },
      { heading: 'check', content: `<p>Resolves the baseline in a scratch project that extends it, and reports what it contributes and how many tokens a repository extending it loads up front. For an Agent Plugin it also checks the manifest, every skill against the Agent Skills spec and every portable server, as <code>plugin check</code> does. It exits 1 when <code>package.json</code> does not declare the layer or declares one outside the package, when <code>"files"</code> would leave part of it out of <code>npm publish</code>, when the layer directory is missing, when the Agent Plugin check finds an error or Claude Code's files are out of date, or when its config, content or policy has an error.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle baseline init --name @acme/opencastle-baseline', desc: 'Scaffold the package' },
      { cmd: 'npx opencastle baseline check', desc: 'Validate the baseline in this directory before publishing' },
    ],
  },
  {
    id: 'plugin',
    category: 'teams',
    name: 'plugin',
    summary: 'Check an Agent Plugin, build Claude Code\'s files, index a marketplace',
    description: '<a href="/docs/agent-plugins">Agent Plugins 1.0</a> is the open package format for skills and MCP servers: <code>plugin.json</code>, <code>skills/&lt;name&gt;/SKILL.md</code> and <code>mcp.json</code>. GitHub Copilot, VS Code, Cursor, Codex and Kiro install one as it is. <code>plugin</code> checks one, writes the files Claude Code reads instead, and writes the marketplace file each assistant indexes plugins with.',
    usage: 'npx opencastle plugin <check|build|index> [dir] [options]',
    options: [
      { flag: '--check', desc: 'build and index: change nothing; exit 1 if a file is out of date' },
      { flag: '--name <name>', desc: 'index: the marketplace name (default: from package.json or the directory)' },
      { flag: '--owner <name>', desc: 'index: who maintains it (default: from package.json)' },
      { flag: '--json', desc: 'check: machine-readable output' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'check', content: `<p>Loads the plugin the way a conformant client does and reports what such a client would refuse, skip or ignore: a manifest outside the closed schema, a skill whose name does not match its directory or whose description is missing or too long, an MCP server with a shell string for a command, a plain-http remote, a header given twice. It also fails when <code>.claude-plugin/plugin.json</code> or <code>.mcp.json</code> no longer matches the portable files.</p>` },
      { heading: 'build', content: `<p>Claude Code reads <code>.claude-plugin/plugin.json</code> and <code>.mcp.json</code>, not the standard's files. <code>build</code> writes both from <code>plugin.json</code> and <code>mcp.json</code> — <code>./</code> commands become <code>\${CLAUDE_PLUGIN_ROOT}/…</code>, <code>streamable-http</code> becomes <code>http</code>. Anything only Claude Code reads that you put in its manifest — <code>userConfig</code>, <code>hooks</code>, <code>agents</code> — is kept.</p>` },
      { heading: 'index', content: `<p>For a repository of plugins under <code>plugins/&lt;name&gt;/</code>, writes <code>.claude-plugin/marketplace.json</code> (read by Claude Code and Copilot CLI), <code>.cursor-plugin/marketplace.json</code> (Cursor team marketplaces) and <code>.agents/plugins/marketplace.json</code> (Codex). Teammates then add the repository once in each assistant.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle plugin check', desc: 'Check the plugin in this directory' },
      { cmd: 'npx opencastle plugin build --check', desc: 'In CI: fail when Claude Code\'s files are stale' },
      { cmd: 'npx opencastle plugin index --owner "Acme Platform"', desc: 'List every plugin under plugins/ for each assistant' },
    ],
  },
  {
    id: 'promote',
    category: 'teams',
    name: 'promote',
    summary: 'Make a skill or memory from your own assistant the team\'s',
    description: 'Moves a skill one developer wrote for their own assistant, or what an assistant remembered on one laptop, into the team\'s sources — this repository\'s <code>.opencastle/</code> or a baseline — where the next <code>sync</code> compiles it into every assistant. It lands as a change in your working tree, for a pull request.',
    usage: 'npx opencastle promote <skill|memory> [name|path] [options]',
    options: [
      { flag: '--to <dir>', desc: 'skill: a baseline or Agent Plugin directory to put it in' },
      { flag: '--from <dir>', desc: 'memory: read memory files from this directory instead' },
      { flag: '--force', desc: 'skill: replace a team skill with the same name' },
      { flag: '--dry-run', desc: 'Say what would be written, and write nothing' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'skill', content: `<p>Finds the skill by name in <code>~/.claude/skills</code>, <code>~/.agents/skills</code>, <code>~/.codex/skills</code>, <code>~/.cursor/skills</code> or <code>~/.copilot/skills</code>, or takes a path. It is checked against the Agent Skills spec — a name that does not match its directory is refused, as assistants that follow the spec skip it — and every file is scanned for credentials. Then it is copied, with its scripts and references, to <code>.opencastle/skills/&lt;name&gt;/</code>, or with <code>--to</code> into a baseline's <code>skills/</code>.</p>` },
      { heading: 'memory', content: `<p>Reads what the assistants on this machine remember about this repository and writes it as lessons in <code>.opencastle/lessons/</code>:</p>
<ul>
  <li><strong>Claude Code</strong> — its auto memory, <code>~/.claude/projects/&lt;repository&gt;/memory/</code> (under <code>$CLAUDE_CONFIG_DIR</code> if you set it), or wherever <code>autoMemoryDirectory</code> points. Corrections (<code>feedback</code>), project notes and memories with no type; the rest, such as memories about you, are left out.</li>
  <li><strong>VS Code</strong> (GitHub Copilot Chat) — the repository memory its agents keep for this folder, in VS Code's workspace storage, stable and Insiders. One lesson per memory file. Your user memory is about you, and is left out.</li>
  <li><strong>Codex</strong> — the blocks of <code>$CODEX_HOME/memories/MEMORY.md</code> whose directory is this repository: their reusable knowledge and failures, not the user preferences or the session list.</li>
</ul>
<p>Cursor keeps its memories on its own servers, and Copilot Memory lives on GitHub, so neither can be read. Memories that hold a credential, and ones already promoted, are left out, and paths in your home directory are written as <code>~</code>. Each lesson records which memory it came from, so running it again adds only what is new. Plain <code>npx opencastle</code> says how many memories on this machine are not lessons yet. How lessons reach the team: <a href="/docs/teams#memory">Team Memory</a>.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle promote skill deploy-runbook', desc: 'Your skill, in every teammate\'s assistant after the next sync' },
      { cmd: 'npx opencastle promote skill deploy-runbook --to ../ai-standard', desc: 'Into the baseline every repository extends' },
      { cmd: 'npx opencastle promote memory --dry-run', desc: 'See which of your assistant\'s memories would become lessons' },
    ],
  },
  {
    id: 'lesson',
    category: 'teams',
    name: 'lesson',
    summary: 'Record, verify or archive a lesson',
    description: 'Agents run it, from their instructions, when they learn something the hard way: one file per lesson in <code>.opencastle/lessons/</code>, and the index they read first, <code>.opencastle/LESSONS-LEARNED.md</code>, rewritten. You run <code>verify</code> and <code>archive</code> when <code>doctor</code> names a lesson whose cited code has changed. It is left out of <code>--help</code> for that reason.',
    usage: `npx opencastle lesson [add] --title <text> --category <cat> --severity <level> --problem <text> [options]
npx opencastle lesson verify <id> [--cite <path[:line]>]...
npx opencastle lesson archive <id> --into <file>`,
    options: [
      { flag: '--title, --category, --severity, --problem', desc: 'add: required. Severity is high, medium or low; npx opencastle lesson --help lists the categories' },
      { flag: '--wrong, --correct, --why', desc: 'add: what was tried, what works, and the root cause' },
      { flag: '--cite <path[:line]>', desc: 'The code the lesson is about; repeat for more. On verify, replaces the citations' },
      { flag: '--into <file>', desc: 'archive: the skill or instruction file the lesson now lives in, or an item such as skills/deploy-runbook that a baseline gives this repository' },
      { flag: '--dry-run', desc: 'Print what would be written, and write nothing' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'verify and archive', content: `<p><code>verify</code> says a lesson still holds: it stamps today\'s date and what the cited files hold now, so <code>doctor</code> stops reporting them. <code>archive</code> marks a lesson merged into the file <code>--into</code> names; it stays on record and leaves the list agents read. A lesson every repository needs goes into the baseline's skill: once the baseline version carrying it is installed, <code>--into skills/&lt;name&gt;</code> names that skill. How lessons reach the team: <a href="/docs/teams#memory">Team Memory</a>.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle lesson verify 2026-10-02-always-quote-shell-variables', desc: 'It still holds' },
      { cmd: 'npx opencastle lesson archive 2026-10-02-always-quote-shell-variables --into .opencastle/skills/git-workflow/SKILL.md', desc: 'It now lives in a skill' },
    ],
  },
  {
    id: 'fleet',
    category: 'teams',
    name: 'fleet',
    summary: 'Versions and drift across many repositories',
    description: 'Reads the committed <code>.opencastle/lock.json</code> of each directory you give it — nothing is installed and nothing is fetched — and shows which OpenCastle and baseline versions each repository runs, which lag behind the newest, and which MCP servers launch differently across them.',
    usage: 'npx opencastle fleet <dir...> [options]',
    options: [
      { flag: '--json', desc: 'Machine-readable output' },
      { flag: '--help, -h', desc: 'Show help' },
    ],
    details: [
      { heading: 'What it shows', content: `<pre><code>  …
  • shop        opencastle 1.0.0  @acme/opencastle-baseline@1.5.0  4 target(s), 6 MCP server(s), ~2779 tokens up front
  …
  @acme/opencastle-baseline: 1.4.0 (1), 1.5.0 (1) — 1 behind 1.5.0: admin

  MCP servers running differently across repositories
    ~ acme-db
      npx -y @acme/db-mcp@2.2.0  — shop
      npx -y @acme/db-mcp@2.1.0  — admin</code></pre>
<p>From the <a href="/docs/teams#example">worked example</a>. Directories without <code>.opencastle/</code> are skipped, one without a lock is listed as not yet synced by a release that writes one, and one whose lock this release cannot read is listed as such. Each repository is named by its <code>package.json</code> name, or else its directory.</p>` },
    ],
    examples: [
      { cmd: 'npx opencastle fleet ~/src/*', desc: 'Every checkout in a directory' },
      { cmd: 'npx opencastle fleet ../web ../api --json', desc: 'Two repositories, for a script' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
  </head>
  <body>
    <!-- Header -->
    <header class="docs-header">
      <div class="docs-header__inner">
        <div class="docs-header__brand">
          <a href="/" class="docs-header__logo-link">
            <img class="docs-header__icon" src="/icon-192.png" alt="OpenCastle" width="28" height="28" />
          </a>
          <h1 class="docs-header__title">
            <a href="/docs/" class="docs-header__breadcrumb-link">Docs</a>
            <span class="docs-header__breadcrumb-sep">/</span>
            CLI Reference
          </h1>
        </div>
      </div>
    </header>

    <div class="docs-layout">
      <!-- Sidebar Navigation -->
      <nav class="docs-sidebar" id="docs-sidebar">
        <ul class="docs-sidebar__list">
          <li>
            <button class="docs-sidebar__link docs-sidebar__link--active" data-section="all">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
              All
            </button>
          </li>
          {categories.map(cat => (
            <li>
              <button class="docs-sidebar__link" data-section={cat.id}>
                <Fragment set:html={cat.icon} />
                {cat.label}
              </button>
            </li>
          ))}
        </ul>

        <div class="docs-sidebar__divider"></div>
        <p class="docs-sidebar__label">Commands</p>
        <ul class="docs-sidebar__list">
          {commands.map(cmd => (
            <li>
              <a class="docs-sidebar__link docs-sidebar__cmd" href={`#${cmd.id}`} data-cmd={cmd.id}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                {cmd.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main class="docs-main">
        <p class="docs-subtitle">
          All commands are run via <code>npx opencastle &lt;command&gt;</code>.
          Every command supports <code>--help</code> for quick reference. Add <code>--debug</code> to a
          command to see the stack trace of an unexpected error.
        </p>

        <div class="usage-block">
          <pre><code>{`npx opencastle <command> [options]

Commands:
  (none)      Show project status and what to do next
  init        Set up this project (detects your stack and existing config)
  sync        Recompile the generated config for every target
  add         Add an integration, e.g. "add supabase"
  doctor      Diagnose setup problems
  remove      Remove OpenCastle from this project

Teams:
  explain     What every assistant here is given, and what you need to set up
  review      What a change does to the assistants (for pull requests)
  ci          Add the drift and policy check to GitHub Actions
  baseline    Create or check a baseline many repositories extend
  plugin      Check an Agent Plugin, build Claude Code's files, index a marketplace
  promote     Make a skill or memory from your own assistant the team's
  fleet       Versions and drift across many repositories

Experimental:
  convoy      Plan multi-step work and run it with agents in parallel

Options:
  --dry-run        Preview changes without writing files
  --yes            Skip confirmation prompts
  --json           Machine-readable output where supported
  --help, -h       Show help for a command
  --version, -v    Show version number`}</code></pre>
          <p class="docs-subtitle"><code>--debug</code>, with any command, prints the stack trace of an error.</p>
        </div>

        <!-- Setup -->
        <section class="docs-category" id="setup" data-category>
          <h2 class="docs-category__title">Setup</h2>
          {commands.filter(c => c.category === 'setup').map(cmd => (
            <div class="plugin-card" id={cmd.id}>
              <h3 class="plugin-card__name">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                opencastle {cmd.name}
              </h3>
              <p class="plugin-card__desc">{cmd.summary}</p>
              <Fragment set:html={cmd.description} />
              <h4>Usage</h4>
              <pre><code>{cmd.usage}</code></pre>
              <h4>Options</h4>
              <table class="plugin-table">
                <thead><tr><th>Flag</th><th>Description</th></tr></thead>
                <tbody>
                  {cmd.options.map(opt => (
                    <tr><td><code>{opt.flag}</code></td><td>{opt.desc}</td></tr>
                  ))}
                </tbody>
              </table>
              {cmd.details.map(d => (
                <>
                  <h4>{d.heading}</h4>
                  <Fragment set:html={d.content} />
                </>
              ))}
              {cmd.examples.length > 0 && (
                <>
                  <h4>Examples</h4>
                  {cmd.examples.map(ex => (
                    <div class="example-block">
                      <pre><code>{ex.cmd}</code></pre>
                      <p class="example-desc">{ex.desc}</p>
                    </div>
                  ))}
                </>
              )}
            </div>
          ))}
        </section>

        <!-- Lifecycle -->
        <section class="docs-category" id="lifecycle" data-category>
          <h2 class="docs-category__title">Lifecycle</h2>
          {commands.filter(c => c.category === 'lifecycle').map(cmd => (
            <div class="plugin-card" id={cmd.id}>
              <h3 class="plugin-card__name">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                opencastle {cmd.name}
              </h3>
              <p class="plugin-card__desc">{cmd.summary}</p>
              <Fragment set:html={cmd.description} />
              <h4>Usage</h4>
              <pre><code>{cmd.usage}</code></pre>
              <h4>Options</h4>
              <table class="plugin-table">
                <thead><tr><th>Flag</th><th>Description</th></tr></thead>
                <tbody>
                  {cmd.options.map(opt => (
                    <tr><td><code>{opt.flag}</code></td><td>{opt.desc}</td></tr>
                  ))}
                </tbody>
              </table>
              {cmd.details.map(d => (
                <>
                  <h4>{d.heading}</h4>
                  <Fragment set:html={d.content} />
                </>
              ))}
              {cmd.examples.length > 0 && (
                <>
                  <h4>Examples</h4>
                  {cmd.examples.map(ex => (
                    <div class="example-block">
                      <pre><code>{ex.cmd}</code></pre>
                      <p class="example-desc">{ex.desc}</p>
                    </div>
                  ))}
                </>
              )}
            </div>
          ))}
        </section>

        <!-- Runtime -->
        <section class="docs-category" id="runtime" data-category>
          <h2 class="docs-category__title">Runtime</h2>
          {commands.filter(c => c.category === 'runtime').map(cmd => (
            <div class="plugin-card" id={cmd.id}>
              <h3 class="plugin-card__name">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                opencastle {cmd.name}
              </h3>
              <p class="plugin-card__desc">{cmd.summary}</p>
              <Fragment set:html={cmd.description} />
              <h4>Usage</h4>
              <pre><code>{cmd.usage}</code></pre>
              <h4>Options</h4>
              <table class="plugin-table">
                <thead><tr><th>Flag</th><th>Description</th></tr></thead>
                <tbody>
                  {cmd.options.map(opt => (
                    <tr><td><code>{opt.flag}</code></td><td>{opt.desc}</td></tr>
                  ))}
                </tbody>
              </table>
              {cmd.details.map(d => (
                <>
                  <h4>{d.heading}</h4>
                  <Fragment set:html={d.content} />
                </>
              ))}
              {cmd.examples.length > 0 && (
                <>
                  <h4>Examples</h4>
                  {cmd.examples.map(ex => (
                    <div class="example-block">
                      <pre><code>{ex.cmd}</code></pre>
                      <p class="example-desc">{ex.desc}</p>
                    </div>
                  ))}
                </>
              )}
            </div>
          ))}
        </section>

        <!-- Diagnostics -->
        <section class="docs-category" id="diagnostics" data-category>
          <h2 class="docs-category__title">Diagnostics</h2>
          {commands.filter(c => c.category === 'diagnostics').map(cmd => (
            <div class="plugin-card" id={cmd.id}>
              <h3 class="plugin-card__name">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                opencastle {cmd.name}
              </h3>
              <p class="plugin-card__desc">{cmd.summary}</p>
              <Fragment set:html={cmd.description} />
              <h4>Usage</h4>
              <pre><code>{cmd.usage}</code></pre>
              <h4>Options</h4>
              <table class="plugin-table">
                <thead><tr><th>Flag</th><th>Description</th></tr></thead>
                <tbody>
                  {cmd.options.map(opt => (
                    <tr><td><code>{opt.flag}</code></td><td>{opt.desc}</td></tr>
                  ))}
                </tbody>
              </table>
              {cmd.details.map(d => (
                <>
                  <h4>{d.heading}</h4>
                  <Fragment set:html={d.content} />
                </>
              ))}
              {cmd.examples.length > 0 && (
                <>
                  <h4>Examples</h4>
                  {cmd.examples.map(ex => (
                    <div class="example-block">
                      <pre><code>{ex.cmd}</code></pre>
                      <p class="example-desc">{ex.desc}</p>
                    </div>
                  ))}
                </>
              )}
              {cmd.id === 'doctor' && (
                <>
                  <h4>Exit codes</h4>
                  <div class="exit-codes">
                    <div class="exit-code"><span class="exit-code__num exit-code--pass">0</span><span>All checks passed (may have warnings)</span></div>
                    <div class="exit-code"><span class="exit-code__num exit-code--fail">1</span><span>One or more checks failed</span></div>
                  </div>
                </>
              )}
            </div>
          ))}
        </section>

        <!-- Teams -->
        <section class="docs-category" id="teams" data-category>
          <h2 class="docs-category__title">Teams</h2>
          <p class="docs-subtitle">
            Baselines, policy and the lock these commands work with are explained in
            <a href="/docs/teams">OpenCastle for Teams</a>.
          </p>
          {commands.filter(c => c.category === 'teams').map(cmd => (
            <div class="plugin-card" id={cmd.id}>
              <h3 class="plugin-card__name">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                opencastle {cmd.name}
              </h3>
              <p class="plugin-card__desc">{cmd.summary}</p>
              <Fragment set:html={cmd.description} />
              <h4>Usage</h4>
              <pre><code>{cmd.usage}</code></pre>
              <h4>Options</h4>
              <table class="plugin-table">
                <thead><tr><th>Flag</th><th>Description</th></tr></thead>
                <tbody>
                  {cmd.options.map(opt => (
                    <tr><td><code>{opt.flag}</code></td><td>{opt.desc}</td></tr>
                  ))}
                </tbody>
              </table>
              {cmd.details.map(d => (
                <>
                  <h4>{d.heading}</h4>
                  <Fragment set:html={d.content} />
                </>
              ))}
              {cmd.examples.length > 0 && (
                <>
                  <h4>Examples</h4>
                  {cmd.examples.map(ex => (
                    <div class="example-block">
                      <pre><code>{ex.cmd}</code></pre>
                      <p class="example-desc">{ex.desc}</p>
                    </div>
                  ))}
                </>
              )}
            </div>
          ))}
        </section>

      </main>
    </div>

    <footer class="footer">
      <div class="footer__inner">
        <span class="footer__copyright">
          MIT License · Filip Mares · 2026
        </span>
        <ul class="footer__links">
          <li><a href="/docs/">Docs</a></li>
          <li><a href="https://github.com/monkilabs/opencastle" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/monkilabs/opencastle/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">License</a></li>
        </ul>
      </div>
    </footer>

    <style>
      /* ── Design tokens (matching dashboard) ── */
      :root {
        --bg-primary: #0a0a0f;
        --bg-secondary: #111118;
        --bg-tertiary: #1a1a24;
        --bg-card: rgba(255, 255, 255, 0.03);
        --text-primary: #f0f0f5;
        --text-secondary: #8a8a9a;
        --text-tertiary: #5a5a6e;
        --text-accent: #a78bfa;
        --border-color: rgba(255, 255, 255, 0.06);
        --gradient-glow: radial-gradient(ellipse 800px 400px at 50% 0%, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
        --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 300ms cubic-bezier(0.4, 0, 0.2, 1);
        --max-width: 1280px;
      }

      /* ── Header ── */
      .docs-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 15, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
      }
      .docs-header__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 24px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .docs-header__brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .docs-header__logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
      }
      .docs-header__breadcrumb-link {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--transition-fast);
      }
      .docs-header__breadcrumb-link:hover {
        color: var(--text-accent);
      }
      .docs-header__breadcrumb-sep {
        color: var(--text-tertiary);
        margin: 0 2px;
        font-weight: 400;
      }
      .docs-header__icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        object-fit: contain;
      }
      .docs-header__title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
      }

      /* ── Layout ── */
      .docs-layout {
        display: flex;
        max-width: var(--max-width);
        margin: 0 auto;
        position: relative;
      }

      /* ── Sidebar ── */
      .docs-sidebar {
        position: sticky;
        top: 56px;
        height: calc(100vh - 56px);
        width: 180px;
        flex-shrink: 0;
        padding: 24px 0 24px 24px;
        overflow-y: auto;
        display: none;
      }
      @media (min-width: 1024px) {
        .docs-sidebar { display: block; }
      }
      .docs-sidebar__list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .docs-sidebar__link {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-tertiary);
        text-decoration: none;
        border-radius: 8px;
        border: none;
        background: none;
        cursor: pointer;
        transition: color var(--transition-fast), background var(--transition-fast);
        text-align: left;
        font-family: inherit;
        line-height: 1.4;
      }
      .docs-sidebar__link:hover {
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.04);
      }
      .docs-sidebar__link--active {
        color: var(--text-accent);
        background: rgba(167, 139, 250, 0.08);
        font-weight: 600;
      }
      .docs-sidebar__link svg {
        flex-shrink: 0;
        opacity: 0.7;
      }
      .docs-sidebar__link--active svg {
        opacity: 1;
      }
      .docs-sidebar__cmd {
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 0.75rem;
      }
      .docs-sidebar__divider {
        height: 1px;
        background: var(--border-color);
        margin: 16px 14px 12px 14px;
      }
      .docs-sidebar__label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0 14px 4px;
      }

      /* ── Main ── */
      .docs-main {
        flex: 1;
        min-width: 0;
        max-width: 860px;
        padding: 32px 24px 64px;
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
      }
      .docs-main::before {
        content: '';
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        height: 600px;
        background: var(--gradient-glow);
        pointer-events: none;
        z-index: 0;
      }
      .docs-main > * {
        position: relative;
        z-index: 1;
      }
      .docs-subtitle {
        color: var(--text-secondary);
        font-size: 0.9375rem;
        margin-bottom: 24px;
        line-height: 1.6;
      }

      /* ── Usage block ── */
      .usage-block {
        margin-bottom: 32px;
      }
      .usage-block pre {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
      }

      /* ── Category sections ── */
      .docs-category {
        scroll-margin-top: 72px;
        margin-bottom: 20px;
      }
      .docs-category[hidden] {
        display: none;
      }
      .docs-category__title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
        margin-bottom: 16px;
      }

      /* ── Command card ── */
      .plugin-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 16px;
        transition: border-color var(--transition-fast);
        scroll-margin-top: 72px;
      }
      .plugin-card:hover {
        border-color: rgba(255, 255, 255, 0.1);
      }
      .plugin-card__name {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        color: var(--text-primary);
        margin-bottom: 4px;
      }
      .plugin-card__name svg {
        flex-shrink: 0;
        color: var(--text-accent);
      }
      .plugin-card__desc {
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-bottom: 12px;
        line-height: 1.5;
      }
      .plugin-card__desc a {
        color: var(--text-accent);
      }

      /* ── Plugin table (scoped for template-rendered tables) ── */
      .plugin-table {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
        font-size: 0.8125rem;
      }
      .plugin-table th,
      .plugin-table td {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-table th {
        background: none;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(167, 139, 250, .15);
      }
      .plugin-table td {
        color: var(--text-secondary);
      }
      .plugin-table tr:last-child td {
        border-bottom: none;
      }
      .plugin-table a {
        color: var(--text-accent);
        text-decoration: none;
      }
      .plugin-table a:hover {
        text-decoration: underline;
      }

      /* ── Tables inside set:html content ── */
      .plugin-card :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
        font-size: 0.8125rem;
      }
      .plugin-card :global(th),
      .plugin-card :global(td) {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-card :global(th) {
        background: none;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(167, 139, 250, .15);
      }
      .plugin-card :global(td) {
        color: var(--text-secondary);
      }
      .plugin-card :global(tr:last-child td) {
        border-bottom: none;
      }
      .plugin-card :global(table a) {
        color: var(--text-accent);
        text-decoration: none;
      }
      .plugin-card :global(table a:hover) {
        text-decoration: underline;
      }
      .plugin-card :global(td code),
      .plugin-card :global(th code) {
        font-size: 0.75rem;
      }

      /* ── Exit codes ── */
      .exit-codes {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 12px 0;
      }
      .exit-code {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.8125rem;
        color: var(--text-secondary);
      }
      .exit-code__num {
        flex-shrink: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      .exit-code--pass {
        background: rgba(74, 222, 128, .1);
        color: #4ade80;
        border: 1px solid rgba(74, 222, 128, .2);
      }
      .exit-code--fail {
        background: rgba(248, 113, 113, .1);
        color: #f87171;
        border: 1px solid rgba(248, 113, 113, .2);
      }

      /* ── Headings inside cards ── */
      .plugin-card h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-top: 16px;
        margin-bottom: 8px;
      }

      /* ── Lists inside cards (injected via set:html) ── */
      .plugin-card :global(ul),
      .plugin-card :global(ol) {
        margin: 8px 0;
        padding-left: 0;
        list-style: none;
      }
      .plugin-card :global(li) {
        position: relative;
        padding: 6px 0 6px 20px;
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.6;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-card :global(li:last-child) {
        border-bottom: none;
      }
      .plugin-card :global(li::before) {
        content: '';
        position: absolute;
        left: 0;
        top: 14px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(167, 139, 250, .4);
      }
      .plugin-card :global(ol li) {
        counter-increment: step;
      }
      .plugin-card :global(ol) {
        counter-reset: step;
      }
      .plugin-card :global(ol li::before) {
        content: counter(step);
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(167, 139, 250, .12);
        color: var(--text-accent);
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        top: 9px;
      }
      .plugin-card :global(li strong) {
        color: var(--text-primary);
      }
      .plugin-card :global(li code) {
        font-size: 0.75rem;
      }
      .plugin-card :global(p) {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 8px 0;
      }
      .plugin-card :global(p strong) {
        color: var(--text-primary);
      }
      .plugin-card :global(p code) {
        font-size: 0.75rem;
      }
      .plugin-card :global(td strong) {
        color: var(--text-primary);
      }

      /* ── Code blocks ── */
      code {
        background: var(--bg-tertiary);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8125rem;
        color: #c9d1d9;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      pre {
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 8px 0 16px;
        overflow-x: auto;
      }
      pre code {
        display: block;
        padding: 16px;
        background: none;
        font-size: 0.8125rem;
        line-height: 1.5;
      }
      /* Output excerpts in a command's details arrive through set:html, which
         scoped styles never reach; unstyled, a long line widened the page. */
      .plugin-card :global(pre) {
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 8px 0 16px;
        overflow-x: auto;
      }
      .plugin-card :global(pre code) {
        display: block;
        padding: 16px;
        background: none;
        font-size: 0.8125rem;
        line-height: 1.5;
        white-space: pre;
      }

      /* ── Lists inside cards ── */
      .plugin-card ol,
      .plugin-card ul {
        margin: 8px 0;
        padding-left: 1.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        line-height: 1.7;
      }
      .plugin-card li {
        margin: 4px 0;
      }
      .plugin-card li strong {
        color: var(--text-primary);
      }
      .plugin-card p {
        font-size: 0.875rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 8px 0;
      }
      .plugin-card p strong {
        color: var(--text-primary);
      }

      /* ── Example blocks ── */
      .example-block {
        margin-bottom: 12px;
      }
      .example-block pre {
        margin-bottom: 4px;
      }
      .example-desc {
        font-size: 0.8125rem;
        color: var(--text-tertiary);
        font-style: italic;
        margin: 0 0 0 4px;
      }

      a {
        color: var(--text-accent);
      }

      /* ── Mobile sidebar toggle ── */
      .docs-mobile-toggle {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 60;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-primary);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
        transition: background var(--transition-fast);
      }
      .docs-mobile-toggle:hover {
        background: var(--bg-tertiary);
      }
      @media (max-width: 1023px) {
        .docs-mobile-toggle { display: flex; }
        .docs-sidebar--open {
          display: block;
          position: fixed;
          top: 56px;
          left: 0;
          width: 220px;
          height: calc(100vh - 56px);
          background: var(--bg-secondary);
          border-right: 1px solid var(--border-color);
          z-index: 55;
          padding: 16px;
        }
      }
    </style>

    <!-- Mobile sidebar toggle -->
    <button class="docs-mobile-toggle" id="mobile-toggle" type="button" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <script>
      // ── Sidebar navigation: show/hide categories ──
      const sidebar = document.getElementById('docs-sidebar');
      const catLinks = sidebar?.querySelectorAll('[data-section]');
      const sections = document.querySelectorAll('[data-category]');
      const mobileToggle = document.getElementById('mobile-toggle');
      const usageBlock = document.querySelector('.usage-block');

      function setActiveSection(sectionId: string) {
        // Update active category link
        catLinks?.forEach(link => {
          link.classList.toggle('docs-sidebar__link--active',
            link.getAttribute('data-section') === sectionId);
        });

        // Show/hide sections
        if (sectionId === 'all') {
          sections.forEach(s => s.removeAttribute('hidden'));
          usageBlock?.removeAttribute('hidden');
        } else {
          usageBlock?.setAttribute('hidden', '');
          sections.forEach(s => {
            if (s.id === sectionId) {
              s.removeAttribute('hidden');
            } else {
              s.setAttribute('hidden', '');
            }
          });
          const target = document.getElementById(sectionId);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        // Close mobile sidebar
        sidebar?.classList.remove('docs-sidebar--open');

        // Update URL hash
        history.replaceState(null, '', sectionId === 'all' ? location.pathname : `#${sectionId}`);

        // Update command count
        const countEl = document.getElementById('cmd-count');
        if (countEl) {
          if (sectionId === 'all') {
            const total = document.querySelectorAll('.plugin-card').length;
            countEl.textContent = `${total} command${total !== 1 ? 's' : ''}`;
          } else {
            const visible = document.querySelectorAll(`#${sectionId} .plugin-card`);
            countEl.textContent = `${visible.length} command${visible.length !== 1 ? 's' : ''}`;
          }
        }
      }

      // Category button click handlers
      catLinks?.forEach(link => {
        link.addEventListener('click', () => {
          const section = link.getAttribute('data-section');
          if (section) setActiveSection(section);
        });
      });

      // Command anchor click — show all, scroll to command
      const cmdLinks = sidebar?.querySelectorAll('[data-cmd]');
      cmdLinks?.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          // Show all sections so the command card is visible
          sections.forEach(s => s.removeAttribute('hidden'));
          usageBlock?.removeAttribute('hidden');
          catLinks?.forEach(l => {
            l.classList.toggle('docs-sidebar__link--active',
              l.getAttribute('data-section') === 'all');
          });

          const cmdId = link.getAttribute('data-cmd');
          if (cmdId) {
            const target = document.getElementById(cmdId);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            history.replaceState(null, '', `#${cmdId}`);
          }

          sidebar?.classList.remove('docs-sidebar--open');
        });
      });

      // Mobile toggle
      mobileToggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('docs-sidebar--open');
      });

      // Close mobile sidebar on outside click
      document.addEventListener('click', (e) => {
        if (sidebar?.classList.contains('docs-sidebar--open') &&
            !sidebar.contains(e.target as Node) &&
            e.target !== mobileToggle) {
          sidebar.classList.remove('docs-sidebar--open');
        }
      });

      // Restore from URL hash on load
      const hash = location.hash.replace('#', '');
      if (hash) {
        const target = document.getElementById(hash);
        if (target) {
          // Check if it's a category or a command
          if (target.hasAttribute('data-category')) {
            setActiveSection(hash);
          } else {
            // It's a command — scroll to it
            requestAnimationFrame(() => {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
        }
      }
    </script>
  </body>
</html>
