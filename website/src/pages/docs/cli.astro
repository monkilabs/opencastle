    <style>
      /* ── Design tokens (matching dashboard) ── */
      :root {
        --bg-primary: #0a0a0f;
        --bg-secondary: #111118;
        --bg-tertiary: #1a1a24;
        --bg-card: rgba(255, 255, 255, 0.03);
        --text-primary: #f0f0f5;
        --text-secondary: #8a8a9a;
        --text-tertiary: #5a5a6e;
        --text-accent: #a78bfa;
        --border-color: rgba(255, 255, 255, 0.06);
        --gradient-glow: radial-gradient(ellipse 800px 400px at 50% 0%, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
        --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 300ms cubic-bezier(0.4, 0, 0.2, 1);
        --max-width: 1280px;
      }

      /* ── Header ── */
      .docs-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 15, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
      }
      .docs-header__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 24px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .docs-header__brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .docs-header__logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
      }
      .docs-header__breadcrumb-link {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--transition-fast);
      }
      .docs-header__breadcrumb-link:hover {
        color: var(--text-accent);
      }
      .docs-header__breadcrumb-sep {
        color: var(--text-tertiary);
        margin: 0 2px;
        font-weight: 400;
      }
      .docs-header__icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        object-fit: contain;
      }
      .docs-header__title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
      }

      /* ── Layout ── */
      .docs-layout {
        display: flex;
        max-width: var(--max-width);
        margin: 0 auto;
        position: relative;
      }

      /* ── Sidebar ── */
      .docs-sidebar {
        position: sticky;
        top: 56px;
        height: calc(100vh - 56px);
        width: 180px;
        flex-shrink: 0;
        padding: 24px 0 24px 24px;
        overflow-y: auto;
        display: none;
      }
      @media (min-width: 1024px) {
        .docs-sidebar { display: block; }
      }
      .docs-sidebar__list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .docs-sidebar__link {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-tertiary);
        text-decoration: none;
        border-radius: 8px;
        border: none;
        background: none;
        cursor: pointer;
        transition: color var(--transition-fast), background var(--transition-fast);
        text-align: left;
        font-family: inherit;
        line-height: 1.4;
      }
      .docs-sidebar__link:hover {
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.04);
      }
      .docs-sidebar__link--active {
        color: var(--text-accent);
        background: rgba(167, 139, 250, 0.08);
        font-weight: 600;
      }
      .docs-sidebar__link svg {
        flex-shrink: 0;
        opacity: 0.7;
      }
      .docs-sidebar__link--active svg {
        opacity: 1;
      }
      .docs-sidebar__cmd {
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 0.75rem;
      }
      .docs-sidebar__divider {
        height: 1px;
        background: var(--border-color);
        margin: 16px 14px 12px 14px;
      }
      .docs-sidebar__label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0 14px 4px;
      }

      /* ── Main ── */
      .docs-main {
        flex: 1;
        min-width: 0;
        max-width: 860px;
        padding: 32px 24px 64px;
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
      }
      .docs-main::before {
        content: '';
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        height: 600px;
        background: var(--gradient-glow);
        pointer-events: none;
        z-index: 0;
      }
      .docs-main > * {
        position: relative;
        z-index: 1;
      }
      .docs-subtitle {
        color: var(--text-secondary);
        font-size: 0.9375rem;
        margin-bottom: 24px;
        line-height: 1.6;
      }

      /* ── Usage block ── */
      .usage-block {
        margin-bottom: 32px;
      }
      .usage-block pre {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
      }

      /* ── Category sections ── */
      .docs-category {
        scroll-margin-top: 72px;
        margin-bottom: 20px;
      }
      .docs-category[hidden] {
        display: none;
      }
      .docs-category__title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
        margin-bottom: 16px;
      }

      /* ── Command card ── */
      .plugin-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 16px;
        transition: border-color var(--transition-fast);
        scroll-margin-top: 72px;
      }
      .plugin-card:hover {
        border-color: rgba(255, 255, 255, 0.1);
      }
      .plugin-card__name {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        color: var(--text-primary);
        margin-bottom: 4px;
      }
      .plugin-card__name svg {
        flex-shrink: 0;
        color: var(--text-accent);
      }
      .plugin-card__desc {
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-bottom: 12px;
        line-height: 1.5;
      }
      .plugin-card__desc a {
        color: var(--text-accent);
      }

      /* ── Plugin table (scoped for template-rendered tables) ── */
      .plugin-table {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
        font-size: 0.8125rem;
      }
      .plugin-table th,
      .plugin-table td {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-table th {
        background: none;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(167, 139, 250, .15);
      }
      .plugin-table td {
        color: var(--text-secondary);
      }
      .plugin-table tr:last-child td {
        border-bottom: none;
      }
      .plugin-table a {
        color: var(--text-accent);
        text-decoration: none;
      }
      .plugin-table a:hover {
        text-decoration: underline;
      }

      /* ── Tables inside set:html content ── */
      .plugin-card :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
        font-size: 0.8125rem;
      }
      .plugin-card :global(th),
      .plugin-card :global(td) {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-card :global(th) {
        background: none;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(167, 139, 250, .15);
      }
      .plugin-card :global(td) {
        color: var(--text-secondary);
      }
      .plugin-card :global(tr:last-child td) {
        border-bottom: none;
      }
      .plugin-card :global(table a) {
        color: var(--text-accent);
        text-decoration: none;
      }
      .plugin-card :global(table a:hover) {
        text-decoration: underline;
      }
      .plugin-card :global(td code),
      .plugin-card :global(th code) {
        font-size: 0.75rem;
      }

      /* ── Exit codes ── */
      .exit-codes {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 12px 0;
      }
      .exit-code {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.8125rem;
        color: var(--text-secondary);
      }
      .exit-code__num {
        flex-shrink: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      .exit-code--pass {
        background: rgba(74, 222, 128, .1);
        color: #4ade80;
        border: 1px solid rgba(74, 222, 128, .2);
      }
      .exit-code--fail {
        background: rgba(248, 113, 113, .1);
        color: #f87171;
        border: 1px solid rgba(248, 113, 113, .2);
      }

      /* ── Headings inside cards ── */
      .plugin-card h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-top: 16px;
        margin-bottom: 8px;
      }

      /* ── Lists inside cards (injected via set:html) ── */
      .plugin-card :global(ul),
      .plugin-card :global(ol) {
        margin: 8px 0;
        padding-left: 0;
        list-style: none;
      }
      .plugin-card :global(li) {
        position: relative;
        padding: 6px 0 6px 20px;
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.6;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-card :global(li:last-child) {
        border-bottom: none;
      }
      .plugin-card :global(li::before) {
        content: '';
        position: absolute;
        left: 0;
        top: 14px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(167, 139, 250, .4);
      }
      .plugin-card :global(ol li) {
        counter-increment: step;
      }
      .plugin-card :global(ol) {
        counter-reset: step;
      }
      .plugin-card :global(ol li::before) {
        content: counter(step);
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(167, 139, 250, .12);
        color: var(--text-accent);
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        top: 9px;
      }
      .plugin-card :global(li strong) {
        color: var(--text-primary);
      }
      .plugin-card :global(li code) {
        font-size: 0.75rem;
      }
      .plugin-card :global(p) {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 8px 0;
      }
      .plugin-card :global(p strong) {
        color: var(--text-primary);
      }
      .plugin-card :global(p code) {
        font-size: 0.75rem;
      }
      .plugin-card :global(td strong) {
        color: var(--text-primary);
      }

      /* ── Code blocks ── */
      code {
        background: var(--bg-tertiary);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8125rem;
        color: #c9d1d9;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      pre {
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 8px 0 16px;
        overflow-x: auto;
      }
      pre code {
        display: block;
        padding: 16px;
        background: none;
        font-size: 0.8125rem;
        line-height: 1.5;
      }

      /* ── Lists inside cards ── */
      .plugin-card ol,
      .plugin-card ul {
        margin: 8px 0;
        padding-left: 1.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        line-height: 1.7;
      }
      .plugin-card li {
        margin: 4px 0;
      }
      .plugin-card li strong {
        color: var(--text-primary);
      }
      .plugin-card p {
        font-size: 0.875rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 8px 0;
      }
      .plugin-card p strong {
        color: var(--text-primary);
      }

      /* ── Example blocks ── */
      .example-block {
        margin-bottom: 12px;
      }
      .example-block pre {
        margin-bottom: 4px;
      }
      .example-desc {
        font-size: 0.8125rem;
        color: var(--text-tertiary);
        font-style: italic;
        margin: 0 0 0 4px;
      }

      a {
        color: var(--text-accent);
      }

      /* ── Mobile sidebar toggle ── */
      .docs-mobile-toggle {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 60;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-primary);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
        transition: background var(--transition-fast);
      }
      .docs-mobile-toggle:hover {
        background: var(--bg-tertiary);
      }
      @media (max-width: 1023px) {
        .docs-mobile-toggle { display: flex; }
        .docs-sidebar--open {
          display: block;
          position: fixed;
          top: 56px;
          left: 0;
          width: 220px;
          height: calc(100vh - 56px);
          background: var(--bg-secondary);
          border-right: 1px solid var(--border-color);
          z-index: 55;
          padding: 16px;
        }
      }
    </style>

    <!-- Mobile sidebar toggle -->
    <button class="docs-mobile-toggle" id="mobile-toggle" type="button" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <script>
      // ── Sidebar navigation: show/hide categories ──
      const sidebar = document.getElementById('docs-sidebar');
      const catLinks = sidebar?.querySelectorAll('[data-section]');
      const sections = document.querySelectorAll('[data-category]');
      const mobileToggle = document.getElementById('mobile-toggle');
      const usageBlock = document.querySelector('.usage-block');

      function setActiveSection(sectionId: string) {
        // Update active category link
        catLinks?.forEach(link => {
          link.classList.toggle('docs-sidebar__link--active',
            link.getAttribute('data-section') === sectionId);
        });

        // Show/hide sections
        if (sectionId === 'all') {
          sections.forEach(s => s.removeAttribute('hidden'));
          usageBlock?.removeAttribute('hidden');
        } else {
          usageBlock?.setAttribute('hidden', '');
          sections.forEach(s => {
            if (s.id === sectionId) {
              s.removeAttribute('hidden');
            } else {
              s.setAttribute('hidden', '');
            }
          });
          const target = document.getElementById(sectionId);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        // Close mobile sidebar
        sidebar?.classList.remove('docs-sidebar--open');

        // Update URL hash
        history.replaceState(null, '', sectionId === 'all' ? location.pathname : `#${sectionId}`);

        // Update command count
        const countEl = document.getElementById('cmd-count');
        if (countEl) {
          if (sectionId === 'all') {
            const total = document.querySelectorAll('.plugin-card').length;
            countEl.textContent = `${total} command${total !== 1 ? 's' : ''}`;
          } else {
            const visible = document.querySelectorAll(`#${sectionId} .plugin-card`);
            countEl.textContent = `${visible.length} command${visible.length !== 1 ? 's' : ''}`;
          }
        }
      }

      // Category button click handlers
      catLinks?.forEach(link => {
        link.addEventListener('click', () => {
          const section = link.getAttribute('data-section');
          if (section) setActiveSection(section);
        });
      });

      // Command anchor click — show all, scroll to command
      const cmdLinks = sidebar?.querySelectorAll('[data-cmd]');
      cmdLinks?.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          // Show all sections so the command card is visible
          sections.forEach(s => s.removeAttribute('hidden'));
          usageBlock?.removeAttribute('hidden');
          catLinks?.forEach(l => {
            l.classList.toggle('docs-sidebar__link--active',
              l.getAttribute('data-section') === 'all');
          });

          const cmdId = link.getAttribute('data-cmd');
          if (cmdId) {
            const target = document.getElementById(cmdId);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            history.replaceState(null, '', `#${cmdId}`);
          }

          sidebar?.classList.remove('docs-sidebar--open');
        });
      });

      // Mobile toggle
      mobileToggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('docs-sidebar--open');
      });

      // Close mobile sidebar on outside click
      document.addEventListener('click', (e) => {
        if (sidebar?.classList.contains('docs-sidebar--open') &&
            !sidebar.contains(e.target as Node) &&
            e.target !== mobileToggle) {
          sidebar.classList.remove('docs-sidebar--open');
        }
      });

      // Restore from URL hash on load
      const hash = location.hash.replace('#', '');
      if (hash) {
        const target = document.getElementById(hash);
        if (target) {
          // Check if it's a category or a command
          if (target.hasAttribute('data-category')) {
            setActiveSection(hash);
          } else {
            // It's a command — scroll to it
            requestAnimationFrame(() => {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
        }
      }
    </script>
  </body>
</html>
