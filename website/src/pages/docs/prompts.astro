---
import '../../styles/global.css';

const title = 'Prompt Templates — OpenCastle';
const description = 'The 14 prompts OpenCastle compiles for every assistant: brainstorm, implement features, fix bugs, resolve PR comments, set up a project, and the seven steps of the convoy pipeline. Where each assistant keeps them and how to run one.';

/* ---------- Sidebar category icons ---------- */
const categoryIcons: Record<string, string> = {
  planning: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>`,
  implementation: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  collaboration: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  setup: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>`,
  pipeline: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><circle cx="19" cy="6" r="2"/><path d="M5 8v2a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4V8"/><line x1="12" y1="14" x2="12" y2="16"/></svg>`,
};

const categories = [
  { id: 'planning', label: 'Planning', icon: categoryIcons.planning },
  { id: 'implementation', label: 'Implementation', icon: categoryIcons.implementation },
  { id: 'collaboration', label: 'Collaboration', icon: categoryIcons.collaboration },
  { id: 'setup', label: 'Setup', icon: categoryIcons.setup },
  {
    id: 'pipeline',
    label: 'Convoy pipeline',
    title: 'Convoy pipeline (experimental)',
    icon: categoryIcons.pipeline,
    intro: `<p><code>npx opencastle convoy "&lt;task&gt;"</code> runs these seven steps in order and fills in their input itself; <code>npx opencastle convoy plan --prd &lt;path&gt;</code> starts at step 2 with a PRD you already have. Each step returns something the CLI reads — a PRD, a VALID or INVALID verdict, or JSON — so you rarely run one yourself. Run by hand, a step returns that output and nothing else: no file is written. The convoy engine is experimental; its commands are on the <a href="/docs/cli#convoy">CLI page</a>.</p>`,
  },
];

/* ---------- Prompt data ---------- */
const prompts = [
  {
    id: 'brainstorm',
    category: 'planning',
    name: 'Brainstorm',
    summary: 'Collaborative brainstorm to explore requirements, approaches, and trade-offs BEFORE committing to a plan. Use when the task has ambiguity, multiple valid approaches, or significant design decisions.',
    agent: 'Team Lead (OpenCastle)',
    input: 'what you want to explore',
    details: [
      { heading: 'When to use', content: `<p>When a task has ambiguity, multiple valid approaches, or design decisions to make before implementation. Use this <em>before</em> reaching for an implementation prompt.</p>` },
      { heading: 'What it does', content: `<p>Runs a structured brainstorm — clarifies the problem, explores the solution space, generates alternatives, evaluates trade-offs, and defines scope before any code is written. The report it ends with is the input for <code>implement-feature</code>.</p>` },
    ],
  },
  {
    id: 'implement-feature',
    category: 'implementation',
    name: 'Implement Feature',
    summary: 'Instruct the Team Lead to implement a specific task from your roadmap with full orchestration, validation, and traceability.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the roadmap task',
    details: [
      { heading: 'When to use', content: `<p>When implementing a task from <code>.opencastle/project/roadmap.md</code>. Provides full orchestration with issue tracking, validation gates, and multi-agent delegation.</p>` },
      { heading: 'What it does', content: `<ol>
        <li><strong>Research &amp; context gathering</strong> — reads the roadmap, known issues, lessons learned and related code</li>
        <li><strong>Task board setup</strong> — creates one tracker issue per subtask before any code is written</li>
        <li><strong>Convoy spec</strong> — writes a convoy spec for the work, whatever its size, checks it with <code>--dry-run</code>, and asks you to run <code>npx opencastle convoy run .opencastle/convoys/&lt;name&gt;.convoy.yml</code> (the convoy engine is experimental)</li>
        <li><strong>Validation &amp; testing</strong> — after the run: secret scan, lint, tests, build, fast review, browser checks</li>
        <li><strong>Delivery via PR</strong> — opens a pull request from the convoy's branch, linked to the tracker issues</li>
      </ol>` },
    ],
  },
  {
    id: 'bug-fix',
    category: 'implementation',
    name: 'Bug Fix',
    summary: 'Investigate and fix a reported bug with proper triage, root cause analysis, issue tracking, and verification.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the bug report',
    details: [
      { heading: 'When to use', content: `<p>When a bug is reported. Provides structured triage, root cause analysis, and fix verification — rather than jumping straight to editing code.</p>` },
      { heading: 'What it does', content: `<ol>
        <li><strong>Triage &amp; reproduce</strong> — confirms the bug, gathers context</li>
        <li><strong>Create tracker issue</strong> — opens a bug ticket with reproduction steps</li>
        <li><strong>Root cause analysis</strong> — traces the defect to its origin</li>
        <li><strong>Fix via convoy</strong> — writes a convoy spec for the fix, even a single task, and asks you to run it with <code>npx opencastle convoy run …</code> (experimental)</li>
        <li><strong>Validate</strong> — verifies with tests and browser checks before delivering the PR</li>
      </ol>` },
    ],
  },
  {
    id: 'quick-refinement',
    category: 'implementation',
    name: 'Quick Refinement',
    summary: 'Handle follow-up refinements after a roadmap task — bug fixes, UI tweaks, polish, and adjustments that are too small for issue tracking.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the change you want',
    details: [
      { heading: 'When to use', content: `<p>For post-task adjustments like UI tweaks, polish, or minor bug fixes that are too small for full issue tracking. Ideal for iterating after an <code>implement-feature</code> run.</p>` },
      { heading: 'What it does', content: `<p>Triages the request to determine the appropriate tracking level, then delegates focused fixes via sub-agents with the same code quality and verification standards as full feature work. No convoy: if the change grows past 5 files, a migration, or auth, it switches to <code>implement-feature</code>.</p>` },
    ],
  },
  {
    id: 'resolve-pr-comments',
    category: 'collaboration',
    name: 'Resolve PR Comments',
    summary: 'Resolve GitHub PR review comments by reading them, grouping by file, and applying fixes systematically.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the pull request number or URL',
    details: [
      { heading: 'When to use', content: `<p>When a pull request has review comments that need to be addressed. Reads, groups, and resolves comments systematically rather than ad-hoc. It reads the comments with the <code>gh</code> CLI, so <code>gh</code> must be signed in.</p>` },
      { heading: 'What it does', content: `<ol>
        <li><strong>Gather PR comments</strong> — reads all review comments from GitHub</li>
        <li><strong>Group by file</strong> — organises comments into file-level batches</li>
        <li><strong>Classify</strong> — marks each as must-fix, should-fix, or discussion</li>
        <li><strong>Delegate fixes</strong> — sends batches to appropriate specialist agents</li>
        <li><strong>Verify and push</strong> — confirms lint/tests pass, then pushes to the branch</li>
      </ol>` },
    ],
  },
  {
    id: 'bootstrap-customizations',
    category: 'setup',
    name: 'Bootstrap Customizations',
    summary: 'Fills in what opencastle init could not detect — schemas, API routes, environment variables — in the .opencastle/ files init pre-filled, so skills have project-specific context to work from.',
    agent: 'Team Lead (OpenCastle)',
    input: 'optional extra context',
    details: [
      { heading: 'When to use', content: `<p>Once, right after <code>opencastle init</code>, on an existing codebase. Skip it in an empty project: there is nothing to read yet.</p>` },
      { heading: 'What it does', content: `<p>Reads <code>.opencastle/manifest.json</code> for what init detected, then reads the real config files, schemas and route handlers, and completes the files init created — <code>project.instructions.md</code>, <code>stack/*-config.md</code>, the tracker config — instead of regenerating them. Anything it cannot determine is marked <code>&lt;!-- TODO: verify --&gt;</code>.</p>` },
    ],
  },
  {
    id: 'create-skill',
    category: 'setup',
    name: 'Create Skill',
    summary: 'Scaffold a new team skill with proper frontmatter and structure. Use when adding a new domain skill to the AI configuration.',
    agent: 'Team Lead (OpenCastle)',
    input: 'what the skill should cover',
    details: [
      { heading: 'When to use', content: `<p>When your team has knowledge every assistant should load on demand — a deploy runbook, a review checklist, the rules for one part of your stack.</p>` },
      { heading: 'What it does', content: `<p>Checks the compiled skills and the available integrations for overlap, names the skill, and writes <code>.opencastle/skills/&lt;name&gt;/SKILL.md</code>. The next <code>npx opencastle sync</code> compiles it for every assistant in the project. A team skill with the same name as one of OpenCastle's replaces it.</p>` },
    ],
  },
  {
    id: 'generate-prd',
    category: 'pipeline',
    name: '1. Generate PRD',
    summary: 'Turns a feature request into a product requirements document. The CLI writes it to .opencastle/prds/<name>.prd.md, named after the PRD\'s title.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the task you gave opencastle convoy',
    details: [],
  },
  {
    id: 'validate-prd',
    category: 'pipeline',
    name: '2. Validate PRD',
    summary: 'Checks that the PRD has every required section and is consistent enough to plan from. Answers VALID or INVALID with the issues.',
    agent: 'Reviewer',
    input: 'the PRD',
    details: [],
  },
  {
    id: 'fix-prd',
    category: 'pipeline',
    name: '3. Fix PRD',
    summary: 'Rewrites the PRD to fix the issues validate-prd found. Runs only when validation fails, up to two attempts.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the PRD and the issues',
    details: [],
  },
  {
    id: 'assess-complexity',
    category: 'pipeline',
    name: '4. Assess Complexity',
    summary: 'Scores the PRD and decides between one convoy and a chain of convoys. Runs at the same time as validate-prd; the CLI saves its JSON beside the PRD as <name>.complexity.json and reuses it on the next run.',
    agent: 'Reviewer',
    input: 'the PRD and your original task',
    details: [],
  },
  {
    id: 'generate-convoy',
    category: 'pipeline',
    name: '5. Generate Convoy',
    summary: 'Turns the PRD into a JSON task plan. The CLI converts it and writes .opencastle/convoys/<name>.convoy.yml; run by hand, it returns the JSON only.',
    agent: 'Team Lead (OpenCastle)',
    input: 'your task, and the PRD with its complexity scores',
    details: [],
  },
  {
    id: 'validate-convoy',
    category: 'pipeline',
    name: '6. Validate Convoy',
    summary: 'After the CLI\'s own schema check, looks for tasks that run in parallel on the same files, missing dependencies, and missing or redundant tasks. Answers VALID or INVALID.',
    agent: 'Reviewer',
    input: 'the convoy spec',
    details: [],
  },
  {
    id: 'fix-convoy',
    category: 'pipeline',
    name: '7. Fix Convoy',
    summary: 'Returns JSON patches for the issues the schema check or validate-convoy found; the CLI applies them and rewrites the spec. Up to two attempts.',
    agent: 'Team Lead (OpenCastle)',
    input: 'the task plan and the issues',
    details: [],
  },
];

/* ---------- Where each assistant keeps the prompts ---------- */
const assistants = [
  { name: 'Claude Code', path: '.claude/commands/oc/<name>.md', run: 'Type <code>/oc:</code> and pick one — <code>/oc:bug-fix</code> — then describe the task' },
  { name: 'VS Code (GitHub Copilot)', path: '.github/prompts/oc.<name>.prompt.md', run: 'In Copilot Chat, type <code>/oc:</code> and pick one; it also selects the agent' },
  { name: 'Cursor', path: '.cursor/rules/prompts/<name>.mdc', run: 'Ask for it by name: “run the bug-fix prompt: …”' },
  { name: 'Windsurf (Devin Desktop)', path: '.windsurf/rules/prompts/<name>.md', run: 'Ask for it by name' },
  { name: 'OpenCode', path: '.opencode/prompts/<name>.md', run: 'Ask for it by name' },
  { name: 'Codex CLI', path: '.codex/prompts/<name>.md', run: 'Ask for it by name' },
  { name: 'Antigravity', path: '.agents/prompts/<name>.md', run: 'Ask for it by name' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
  </head>
  <body>
    <!-- Header -->
    <header class="docs-header">
      <div class="docs-header__inner">
        <div class="docs-header__brand">
          <a href="/" class="docs-header__logo-link">
            <img class="docs-header__icon" src="/icon-192.png" alt="OpenCastle" width="28" height="28" />
          </a>
          <h1 class="docs-header__title">
            <a href="/docs/" class="docs-header__breadcrumb-link">Docs</a>
            <span class="docs-header__breadcrumb-sep">/</span>
            Prompt Templates
          </h1>
        </div>
      </div>
    </header>

    <div class="docs-layout">
      <!-- Sidebar Navigation -->
      <nav class="docs-sidebar" id="docs-sidebar">
        <ul class="docs-sidebar__list">
          <li>
            <button class="docs-sidebar__link docs-sidebar__link--active" data-section="all">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
              All
            </button>
          </li>
          {categories.map(cat => (
            <li>
              <button class="docs-sidebar__link" data-section={cat.id}>
                <Fragment set:html={cat.icon} />
                {cat.label}
              </button>
            </li>
          ))}
        </ul>

        <div class="docs-sidebar__divider"></div>
        <p class="docs-sidebar__label">Prompts</p>
        <ul class="docs-sidebar__list">
          <li>
            <a class="docs-sidebar__link docs-sidebar__cmd" href="#how-to-use" data-prompt="how-to-use">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              How to use
            </a>
          </li>
          {prompts.map(prompt => (
            <li>
              <a class="docs-sidebar__link docs-sidebar__cmd" href={`#${prompt.id}`} data-prompt={prompt.id}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {prompt.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main class="docs-main">
        <p class="docs-subtitle">
          OpenCastle compiles 14 prompts for every assistant in your project: seven you run yourself,
          and the seven steps of the convoy pipeline. In Claude Code and VS Code Copilot Chat each one is a
          slash command under one namespace — <code>/oc:bug-fix</code> — so it never collides with a command
          of your own. Each tells your assistant to act as the Team Lead (three pipeline steps, as the
          Reviewer); in Copilot Chat it also selects that agent.
        </p>

        <!-- How to use -->
        <section class="usage-block" id="how-to-use">
          <h2 class="docs-category__title">How to use</h2>
          <div class="usage-table-wrap">
            <table class="usage-table">
              <thead>
                <tr><th>Assistant</th><th>Where the prompts are</th><th>How to run one</th></tr>
              </thead>
              <tbody>
                {assistants.map(a => (
                  <tr>
                    <td>{a.name}</td>
                    <td><code>{a.path}</code></td>
                    <td set:html={a.run} />
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="usage-note">
            What you type after the command, or after the prompt's name, is the input. The
            <code>{'{{…}}'}</code> placeholders in a prompt file only mark where it goes; no assistant
            substitutes them. <code>npx opencastle explain</code> lists the prompts compiled in your project
            and where each assistant reads them. The workflow templates sit beside the prompts:
            <code>/oc:workflow-&lt;name&gt;</code> in Claude Code, and an <code>agent-workflows/</code> or
            <code>workflows/</code> directory for the other assistants.
          </p>
        </section>

        {categories.map(cat => (
          <section class="docs-category" id={cat.id} data-category>
            <h2 class="docs-category__title">{cat.title ?? cat.label}</h2>
            {cat.intro && <div class="docs-category__intro" set:html={cat.intro} />}
            {prompts.filter(p => p.category === cat.id).map(prompt => (
            <div class="plugin-card" id={prompt.id}>
              <h3 class="plugin-card__name">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {prompt.name}
              </h3>
              <p class="plugin-card__desc">{prompt.summary}</p>
              <div class="prompt-meta">
                <span class="prompt-meta__agent">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  {prompt.agent}
                </span>
                <span class="prompt-meta__sep">·</span>
                <span class="prompt-meta__vars">Input:&nbsp;{prompt.input}</span>
              </div>
              {prompt.details.map(d => (
                <Fragment key={d.heading}>
                  <h4>{d.heading}</h4>
                  <Fragment set:html={d.content} />
                </Fragment>
              ))}
              <div class="prompt-filename">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                <code>/oc:{prompt.id}</code>
              </div>
            </div>
            ))}
          </section>
        ))}

      </main>
    </div>

    <footer class="footer">
      <div class="footer__inner">
        <span class="footer__copyright">
          MIT License · Filip Mares · 2026
        </span>
        <ul class="footer__links">
          <li><a href="/docs/">Docs</a></li>
          <li><a href="https://github.com/monkilabs/opencastle" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/monkilabs/opencastle/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">License</a></li>
        </ul>
      </div>
    </footer>

    <style>
      /* ── Design tokens (matching dashboard) ── */
      :root {
        --bg-primary: #0a0a0f;
        --bg-secondary: #111118;
        --bg-tertiary: #1a1a24;
        --bg-card: rgba(255, 255, 255, 0.03);
        --text-primary: #f0f0f5;
        --text-secondary: #8a8a9a;
        --text-tertiary: #5a5a6e;
        --text-accent: #a78bfa;
        --border-color: rgba(255, 255, 255, 0.06);
        --gradient-glow: radial-gradient(ellipse 800px 400px at 50% 0%, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
        --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 300ms cubic-bezier(0.4, 0, 0.2, 1);
        --max-width: 1280px;
      }

      /* ── Header ── */
      .docs-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 15, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
      }
      .docs-header__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 24px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .docs-header__brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .docs-header__logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
      }
      .docs-header__breadcrumb-link {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--transition-fast);
      }
      .docs-header__breadcrumb-link:hover {
        color: var(--text-accent);
      }
      .docs-header__breadcrumb-sep {
        color: var(--text-tertiary);
        margin: 0 2px;
        font-weight: 400;
      }
      .docs-header__icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        object-fit: contain;
      }
      .docs-header__title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
      }

      /* ── Layout ── */
      .docs-layout {
        display: flex;
        max-width: var(--max-width);
        margin: 0 auto;
        position: relative;
      }

      /* ── Sidebar ── */
      .docs-sidebar {
        position: sticky;
        top: 56px;
        height: calc(100vh - 56px);
        width: 180px;
        flex-shrink: 0;
        padding: 24px 0 24px 24px;
        overflow-y: auto;
        display: none;
      }
      @media (min-width: 1024px) {
        .docs-sidebar { display: block; }
      }
      .docs-sidebar__list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .docs-sidebar__link {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-tertiary);
        text-decoration: none;
        border-radius: 8px;
        border: none;
        background: none;
        cursor: pointer;
        transition: color var(--transition-fast), background var(--transition-fast);
        text-align: left;
        font-family: inherit;
        line-height: 1.4;
      }
      .docs-sidebar__link:hover {
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.04);
      }
      .docs-sidebar__link--active {
        color: var(--text-accent);
        background: rgba(167, 139, 250, 0.08);
        font-weight: 600;
      }
      .docs-sidebar__link svg {
        flex-shrink: 0;
        opacity: 0.7;
      }
      .docs-sidebar__link--active svg {
        opacity: 1;
      }
      .docs-sidebar__cmd {
        font-size: 0.8125rem;
      }
      .docs-sidebar__divider {
        height: 1px;
        background: var(--border-color);
        margin: 16px 14px 12px 14px;
      }
      .docs-sidebar__label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0 14px 4px;
      }

      /* ── Main ── */
      .docs-main {
        flex: 1;
        min-width: 0;
        max-width: 860px;
        padding: 32px 24px 64px;
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
      }
      .docs-main::before {
        content: '';
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        height: 600px;
        background: var(--gradient-glow);
        pointer-events: none;
        z-index: 0;
      }
      .docs-main > * {
        position: relative;
        z-index: 1;
      }
      .docs-subtitle {
        color: var(--text-secondary);
        font-size: 0.9375rem;
        margin-bottom: 24px;
        line-height: 1.6;
      }

      /* ── Usage block ── */
      .usage-block {
        margin-bottom: 32px;
        scroll-margin-top: 72px;
      }
      .usage-block[hidden] {
        display: none;
      }
      .usage-table-wrap {
        overflow-x: auto;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
      }
      .usage-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8125rem;
      }
      .usage-table th,
      .usage-table td {
        text-align: left;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border-color);
        vertical-align: top;
        color: var(--text-secondary);
      }
      .usage-table th {
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(167, 139, 250, .15);
      }
      .usage-table tr:last-child td {
        border-bottom: none;
      }
      .usage-table td:first-child {
        color: var(--text-primary);
        white-space: nowrap;
      }
      .usage-table code {
        font-size: 0.75rem;
        white-space: nowrap;
      }
      .usage-note,
      .docs-category__intro :global(p) {
        color: var(--text-secondary);
        font-size: 0.875rem;
        line-height: 1.6;
        margin: 12px 0 16px;
      }

      /* ── Category sections ── */
      .docs-category {
        scroll-margin-top: 72px;
        margin-bottom: 20px;
      }
      .docs-category[hidden] {
        display: none;
      }
      .docs-category__title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
        margin-bottom: 16px;
      }

      /* ── Prompt card ── */
      .plugin-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 16px;
        transition: border-color var(--transition-fast);
        scroll-margin-top: 72px;
      }
      .plugin-card:hover {
        border-color: rgba(255, 255, 255, 0.1);
      }
      .plugin-card__name {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 4px;
      }
      .plugin-card__name svg {
        flex-shrink: 0;
        color: var(--text-accent);
      }
      .plugin-card__desc {
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-bottom: 12px;
        line-height: 1.5;
      }

      /* ── Prompt meta (agent + variables) ── */
      .prompt-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 16px;
        font-size: 0.8125rem;
        color: var(--text-tertiary);
      }
      .prompt-meta__agent {
        display: flex;
        align-items: center;
        gap: 5px;
        color: var(--text-tertiary);
      }
      .prompt-meta__agent svg {
        flex-shrink: 0;
      }
      .prompt-meta__sep {
        color: var(--text-tertiary);
        opacity: 0.5;
      }
      .prompt-meta__vars {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
      }

      /* ── Prompt filename footer ── */
      .prompt-filename {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--border-color);
        font-size: 0.75rem;
        color: var(--text-tertiary);
      }
      .prompt-filename svg {
        flex-shrink: 0;
        opacity: 0.6;
      }
      .prompt-filename code {
        font-size: 0.75rem;
        color: var(--text-tertiary);
        background: none;
        padding: 0;
      }

      /* ── Tables inside set:html content ── */
      .plugin-card :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
        font-size: 0.8125rem;
      }
      .plugin-card :global(th),
      .plugin-card :global(td) {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-card :global(th) {
        background: none;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(167, 139, 250, .15);
      }
      .plugin-card :global(td) {
        color: var(--text-secondary);
      }
      .plugin-card :global(tr:last-child td) {
        border-bottom: none;
      }

      /* ── Headings inside cards ── */
      .plugin-card h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-top: 16px;
        margin-bottom: 8px;
      }

      /* ── Lists inside cards (injected via set:html) ── */
      .plugin-card :global(ul),
      .plugin-card :global(ol) {
        margin: 8px 0;
        padding-left: 0;
        list-style: none;
      }
      .plugin-card :global(li) {
        position: relative;
        padding: 6px 0 6px 20px;
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.6;
        border-bottom: 1px solid var(--border-color);
      }
      .plugin-card :global(li:last-child) {
        border-bottom: none;
      }
      .plugin-card :global(li::before) {
        content: '';
        position: absolute;
        left: 0;
        top: 14px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(167, 139, 250, .4);
      }
      .plugin-card :global(ol li) {
        counter-increment: step;
      }
      .plugin-card :global(ol) {
        counter-reset: step;
      }
      .plugin-card :global(ol li::before) {
        content: counter(step);
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(167, 139, 250, .12);
        color: var(--text-accent);
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        top: 9px;
      }
      .plugin-card :global(li strong) {
        color: var(--text-primary);
      }
      .plugin-card :global(li code) {
        font-size: 0.75rem;
      }
      .plugin-card :global(p) {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 8px 0;
      }
      .plugin-card :global(p strong) {
        color: var(--text-primary);
      }
      .plugin-card :global(p code) {
        font-size: 0.75rem;
      }
      .plugin-card :global(em) {
        color: var(--text-tertiary);
        font-style: italic;
      }

      /* ── Code blocks ── */
      code {
        background: var(--bg-tertiary);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8125rem;
        color: #c9d1d9;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      pre {
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 8px 0 16px;
        overflow-x: auto;
      }
      pre code {
        display: block;
        padding: 16px;
        background: none;
        font-size: 0.8125rem;
        line-height: 1.5;
      }

      a {
        color: var(--text-accent);
      }

      /* ── Mobile sidebar toggle ── */
      .docs-mobile-toggle {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 60;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-primary);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
        transition: background var(--transition-fast);
      }
      .docs-mobile-toggle:hover {
        background: var(--bg-tertiary);
      }
      @media (max-width: 1023px) {
        .docs-mobile-toggle { display: flex; }
        .docs-sidebar--open {
          display: block;
          position: fixed;
          top: 56px;
          left: 0;
          width: 220px;
          height: calc(100vh - 56px);
          background: var(--bg-secondary);
          border-right: 1px solid var(--border-color);
          z-index: 55;
          padding: 16px;
        }
      }
    </style>

    <!-- Mobile sidebar toggle -->
    <button class="docs-mobile-toggle" id="mobile-toggle" type="button" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <script>
      // ── Sidebar navigation: show/hide categories ──
      const sidebar = document.getElementById('docs-sidebar');
      const catLinks = sidebar?.querySelectorAll('[data-section]');
      const sections = document.querySelectorAll('[data-category]');
      const mobileToggle = document.getElementById('mobile-toggle');
      const usageBlock = document.querySelector('.usage-block');

      function setActiveSection(sectionId: string) {
        catLinks?.forEach(link => {
          link.classList.toggle('docs-sidebar__link--active',
            link.getAttribute('data-section') === sectionId);
        });

        if (sectionId === 'all') {
          sections.forEach(s => s.removeAttribute('hidden'));
          usageBlock?.removeAttribute('hidden');
        } else {
          usageBlock?.setAttribute('hidden', '');
          sections.forEach(s => {
            if (s.id === sectionId) {
              s.removeAttribute('hidden');
            } else {
              s.setAttribute('hidden', '');
            }
          });
          const target = document.getElementById(sectionId);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        sidebar?.classList.remove('docs-sidebar--open');
        history.replaceState(null, '', sectionId === 'all' ? location.pathname : `#${sectionId}`);
      }

      catLinks?.forEach(link => {
        link.addEventListener('click', () => {
          const section = link.getAttribute('data-section');
          if (section) setActiveSection(section);
        });
      });

      const promptLinks = sidebar?.querySelectorAll('[data-prompt]');
      promptLinks?.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          sections.forEach(s => s.removeAttribute('hidden'));
          usageBlock?.removeAttribute('hidden');
          catLinks?.forEach(l => {
            l.classList.toggle('docs-sidebar__link--active',
              l.getAttribute('data-section') === 'all');
          });

          const promptId = link.getAttribute('data-prompt');
          if (promptId) {
            const target = document.getElementById(promptId);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            history.replaceState(null, '', `#${promptId}`);
          }

          sidebar?.classList.remove('docs-sidebar--open');
        });
      });

      mobileToggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('docs-sidebar--open');
      });

      document.addEventListener('click', (e) => {
        if (sidebar?.classList.contains('docs-sidebar--open') &&
            !sidebar.contains(e.target as Node) &&
            e.target !== mobileToggle) {
          sidebar.classList.remove('docs-sidebar--open');
        }
      });

      const hash = location.hash.replace('#', '');
      if (hash) {
        const target = document.getElementById(hash);
        if (target) {
          if (target.hasAttribute('data-category')) {
            setActiveSection(hash);
          } else {
            requestAnimationFrame(() => {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
        }
      }
    </script>
  </body>
</html>
