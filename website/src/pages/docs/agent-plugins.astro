---
import '../../styles/global.css';
import { PLUGINS } from '../../../../src/orchestrator/plugins/index';

const title = 'Agent Plugins — OpenCastle';
const description = 'OpenCastle follows the open standards for AI coding assistants: AGENTS.md, Agent Skills, MCP and Agent Plugins 1.0. Use any Agent Plugin in every assistant — including the ones that do not read them yet — and publish your team’s standard as one.';
const integrationCount = Object.keys(PLUGINS).length;

const overviewSections = [
  { id: 'standards', label: 'The Standards' },
  { id: 'format', label: 'What a Plugin Is' },
];
const usingSections = [
  { id: 'extend', label: 'Use One Everywhere' },
  { id: 'publish', label: 'Publish Your Standard' },
  { id: 'marketplace', label: 'Distribute It' },
];
const referenceSections = [
  { id: 'integrations', label: 'Integrations' },
  { id: 'check', label: 'What check Checks' },
  { id: 'limits', label: 'Limits' },
];

const sectionIcons: Record<string, string> = {
  standards: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>`,
  format: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
  extend: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  publish: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>`,
  marketplace: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  integrations: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  check: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
  limits: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
};

/* ---------- Code and output shown on the page ---------- */
/* Real: from `opencastle baseline init ai-standard --name @acme/ai-standard`,
   with one server added to mcp.json, run with the release this page documents. */

const pluginTree = `my-plugin/
├── plugin.json          the manifest — $schema and name are required
├── skills/
│   └── summarize/
│       ├── SKILL.md     an Agent Skill, named as its directory
│       └── references/
├── mcp.json             MCP servers: stdio, streamable-http or sse
└── com.example.client/  anything one assistant adds, under its own namespace`;

const extendConfig = `// .opencastle/config.json
{
  "extends": ["@acme/ai-standard"]   // an installed package, or a path from this file: "../plugins/ai-standard"
}`;

const baselineTree = `ai-standard/
├── package.json             "opencastle": { "baseline": "." }
├── README.md
├── plugin.json              the Agent Plugins manifest
├── mcp.json                 servers every assistant can start as they are
├── skills/
│   └── code-review/
│       └── SKILL.md
├── dev.opencastle/          OpenCastle's namespace: what the standard does not cover yet
│   ├── config.json          the policy, and servers that need \${NAME} variables
│   └── instructions/
│       └── engineering-standards.md
├── .github/workflows/
│   └── check.yml            runs opencastle baseline check on every push and pull request
├── .claude-plugin/
│   └── plugin.json          Claude Code's copy — opencastle plugin build writes it
└── .mcp.json                Claude Code's copy of mcp.json, once mcp.json has a server`;

const manifest = `{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "acme.ai-standard",
  "version": "0.1.0",
  "description": "Our AI assistant standard: compiled by OpenCastle into every assistant …",
  "license": "UNLICENSED"
}`;

const checkOutput = `$ npx opencastle plugin check ai-standard

  🏰 Agent Plugin acme.ai-standard 0.1.0 · Agent Plugins 1.0.0

  Skills: code-review
  MCP servers: internal-docs
  dev.opencastle/: OpenCastle content — check it with opencastle baseline check
  ✗ .mcp.json does not match plugin.json and mcp.json — run opencastle plugin build

  1 problem(s) to fix.

$ npx opencastle plugin build ai-standard
  ✓ Wrote .mcp.json

$ npx opencastle plugin check ai-standard
  …
  ✓ Loads in GitHub Copilot, VS Code, Cursor, Codex and Kiro as it is, and in Claude Code.`;

const marketTree = `agent-plugins/
├── package.json
├── plugins/
│   ├── ai-standard/      an Agent Plugin
│   └── payments/         another
├── .claude-plugin/marketplace.json     Claude Code, Copilot CLI
├── .cursor-plugin/marketplace.json     Cursor team marketplaces
└── .agents/plugins/marketplace.json    Codex`;

const indexOutput = `$ npx opencastle plugin index
  ✓ Listed 2 plugin(s) in .claude-plugin/marketplace.json, .cursor-plugin/marketplace.json, .agents/plugins/marketplace.json
  …`;

const marketJson = `{
  "name": "acme.agent-plugins",
  "owner": { "name": "Acme Platform" },
  "metadata": { "description": "Acme's plugins for every assistant" },
  "plugins": [
    {
      "name": "acme.ai-standard",
      "source": "./plugins/ai-standard",
      "description": "Our AI assistant standard: …"
    },
    …
  ]
}`;

const integrationTree = `src/orchestrator/plugins/supabase/
├── plugin.json        compiled from config.ts; OpenCastle's own data under extensions."dev.opencastle"
├── mcp.json           the Supabase remote server, as streamable-http
├── skills/
│   └── supabase-database/
│       └── SKILL.md
└── config.ts          detection, agent tools, earlier defaults — what only OpenCastle reads`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://www.opencastle.dev/docs/agent-plugins/" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://www.opencastle.dev/docs/agent-plugins/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.opencastle.dev/og-image.png" />
