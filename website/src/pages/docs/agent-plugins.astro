        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        letter-spacing: -.01em;
      }

      /* ── Layout ── */
      .docs-layout {
        display: flex;
        max-width: var(--max-width);
        margin: 0 auto;
        position: relative;
      }

      /* ── Sidebar ── */
      .docs-sidebar {
        position: sticky;
        top: 56px;
        height: calc(100vh - 56px);
        width: 200px;
        flex-shrink: 0;
        padding: 24px 0 24px 24px;
        overflow-y: auto;
        display: none;
      }
      @media (min-width: 1024px) {
        .docs-sidebar { display: block; }
      }
      .docs-sidebar__list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .docs-sidebar__link {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-tertiary);
        text-decoration: none;
        border-radius: 8px;
        transition: color var(--transition-fast), background var(--transition-fast);
        line-height: 1.4;
      }
      .docs-sidebar__link:hover {
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.04);
      }
      .docs-sidebar__link--active {
        color: var(--text-accent);
        background: rgba(167, 139, 250, 0.08);
        font-weight: 600;
      }
      .docs-sidebar__link :global(svg) {
        flex-shrink: 0;
        opacity: 0.7;
      }
      .docs-sidebar__link--active :global(svg) {
        opacity: 1;
      }
      .docs-sidebar__divider {
        height: 1px;
        background: var(--border-primary);
        margin: 12px 14px;
      }
      .docs-sidebar__label {
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--text-tertiary);
        padding: 8px 14px 4px;
      }

      /* ── Main ── */
      .docs-main {
        flex: 1;
        min-width: 0;
        max-width: 860px;
        padding: 32px 24px 64px;
      }

      /* ── Hero ── */
      .docs-hero {
        margin-bottom: 2.5rem;
      }
      .docs-hero__heading {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -.02em;
        margin-bottom: .5rem;
      }
      .docs-hero__sub {
        color: var(--text-secondary);
        font-size: 1.05rem;
        line-height: 1.6;
      }

      /* ── Sections ── */
      .docs-section {
        margin-bottom: 3rem;
        scroll-margin-top: 72px;
      }
      .docs-section p {
        color: var(--text-secondary);
        font-size: .95rem;
        line-height: 1.7;
        margin-bottom: 1rem;
      }
      .docs-section p strong,
      .docs-section p em {
        color: var(--text-primary);
      }
      .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -.01em;
        margin-bottom: .75rem;
        padding-bottom: .5rem;
        border-bottom: 1px solid var(--border-color);
      }
      .arch-subheading {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -.01em;
        margin: 1.75rem 0 .6rem;
      }
      .section-divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 3rem 0 2rem;
      }
      .section-divider__line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border-secondary), transparent);
      }
      .section-divider__label {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--text-accent);
        white-space: nowrap;
      }

      /* ── Lists ── */
      .docs-list {
        list-style: none;
        padding: 0;
        margin-bottom: 1.5rem;
      }
      .docs-list li {
        color: var(--text-secondary);
        font-size: .9rem;
        line-height: 1.6;
        padding-left: 1.25rem;
        position: relative;
        margin-bottom: .5rem;
      }
      .docs-list li::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--text-accent);
      }
      .docs-list li strong {
        color: var(--text-primary);
      }
      .steps {
        list-style: none;
        padding: 0;
        margin-bottom: 1.5rem;
        counter-reset: step;
      }
      .steps li {
        counter-increment: step;
        position: relative;
        padding: .75rem 0 .75rem 2.5rem;
        color: var(--text-secondary);
        font-size: .9rem;
        line-height: 1.7;
        border-bottom: 1px solid var(--border-color);
      }
      .steps li:last-child {
        border-bottom: none;
      }
      .steps li::before {
        content: counter(step);
        position: absolute;
        left: 0;
        top: .85rem;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 50%;
        background: rgba(167, 139, 250, .12);
        color: var(--text-accent);
        font-size: .75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .steps li strong {
        color: var(--text-primary);
      }
      .docs-link { color: var(--text-accent); text-decoration: none; }
      .docs-link:hover { text-decoration: underline; }

      /* ── Key insight ── */
      .key-insight {
        padding: 1.25rem;
        background: var(--accent-glow);
        border: 1px solid rgba(167, 139, 250, .2);
        border-radius: 10px;
        margin: 1rem 0 1.5rem;
      }
      .key-insight p {
        color: var(--text-secondary);
        font-size: .9rem;
        line-height: 1.6;
        margin: 0;
      }
      .key-insight strong {
        color: var(--text-accent);
      }

      /* ── Layer diagram ── */
      .architecture-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-primary);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1.5rem;
      }
      .architecture-card__header {
        padding: .75rem 1.25rem;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-accent);
        border-bottom: 1px solid var(--border-primary);
        background: rgba(167, 139, 250, 0.04);
      }
      .architecture-card__flow {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        padding: 1.5rem;
        text-align: center;
      }
      .architecture-card__node {
        padding: .5rem 1.25rem;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 600;
        background: var(--bg-tertiary);
        border: 1px solid var(--border-secondary);
        color: var(--text-primary);
      }
      .architecture-card__node--lead {
        background: rgba(167, 139, 250, 0.1);
        border-color: rgba(167, 139, 250, 0.3);
        color: var(--text-accent);
      }
      .architecture-card__arrow {
        font-size: .75rem;
        color: var(--text-tertiary);
        font-style: italic;
      }
      .architecture-card__row {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      .architecture-card__row .architecture-card__node {
        font-size: .75rem;
        padding: .35rem .75rem;
      }

      /* ── Tables ── */
      .comparison-table-wrap {
        overflow-x: auto;
        margin-bottom: 1.5rem;
        border-radius: 10px;
        border: 1px solid var(--border-primary);
      }
      .comparison-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
      }
      .comparison-table thead tr {
        background: rgba(167, 139, 250, 0.06);
        border-bottom: 1px solid var(--border-secondary);
      }
      .comparison-table th {
        padding: .65rem 1rem;
        text-align: left;
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-accent);
        white-space: nowrap;
      }
      .comparison-table td {
        padding: .65rem 1rem;
        color: var(--text-secondary);
        line-height: 1.5;
        border-bottom: 1px solid var(--border-color);
        vertical-align: top;
      }
      .comparison-table tbody tr:last-child td {
        border-bottom: none;
      }
      .comparison-table tbody tr:nth-child(even) td {
        background: rgba(255, 255, 255, 0.015);
      }
      .comparison-table td:first-child {
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
      }

      /* ── Code ── */
      code {
        background: var(--bg-tertiary);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.8rem;
        color: #c9d1d9;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      pre {
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 8px 0 16px;
        overflow-x: auto;
      }
      pre code {
        display: block;
        padding: 16px;
        background: none;
        font-size: 0.8rem;
        line-height: 1.5;
        white-space: pre;
      }

      /* ── Mobile sidebar toggle ── */
      .docs-mobile-toggle {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 60;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-primary);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
        transition: background var(--transition-fast);
      }
      .docs-mobile-toggle:hover { background: var(--bg-tertiary); }
      @media (max-width: 1023px) {
        .docs-mobile-toggle { display: flex; }
        .docs-sidebar--open {
          display: block;
          position: fixed;
          top: 56px;
          left: 0;
          width: 220px;
          height: calc(100vh - 56px);
          background: var(--bg-secondary);
          border-right: 1px solid var(--border-color);
          z-index: 55;
          padding: 16px;
        }
      }
      @media (max-width: 640px) {
        .comparison-table td:first-child { white-space: normal; }
      }
    </style>

    <button class="docs-mobile-toggle" id="mobile-toggle" type="button" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <script>
      const sidebar = document.getElementById('docs-sidebar');
      const mobileToggle = document.getElementById('mobile-toggle');
      const sidebarLinks = sidebar?.querySelectorAll('.docs-sidebar__link');

      // Highlight the section in view
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sidebarLinks?.forEach(link => {
              link.classList.toggle('docs-sidebar__link--active',
                link.getAttribute('href') === `#${entry.target.id}`);
            });
          }
        });
      }, { rootMargin: '-80px 0px -60% 0px' });

      document.querySelectorAll('.docs-section').forEach(s => observer.observe(s));

      mobileToggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('docs-sidebar--open');
      });

      sidebarLinks?.forEach(link => {
        link.addEventListener('click', () => {
          sidebar?.classList.remove('docs-sidebar--open');
        });
      });

      document.addEventListener('click', (e) => {
        if (sidebar?.classList.contains('docs-sidebar--open') &&
            !sidebar.contains(e.target as Node) &&
            e.target !== mobileToggle) {
          sidebar.classList.remove('docs-sidebar--open');
        }
      });
    </script>
  </body>
</html>
