---
import '../../styles/global.css';
import { PLUGINS } from '../../../../src/orchestrator/plugins/index';

const title = 'Docs — OpenCastle';
const description = 'OpenCastle documentation: compile one AI assistant config for every assistant, share it across your repositories, and check it on every pull request.';
const integrationCount = Object.keys(PLUGINS).length;

const pages = [
  {
    href: '/docs/agentic-development',
    title: 'Agentic Development',
    description: 'Guide to agentic development and multi-agent orchestration. Vibecoding best practices, prompt patterns, specialist agents, quality gates, and how to coordinate AI agent teams.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"/><line x1="9" y1="21" x2="15" y2="21"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"/><line x1="9" y1="21" x2="15" y2="21"/></svg>`,
    badge: 'guide',
  },
  {
    href: '/docs/cli',
    title: 'CLI Reference',
    description: 'Complete reference for every opencastle command — init, sync, add, doctor, remove, the team commands explain, review, ci, baseline, plugin, promote and fleet, and the experimental convoy namespace.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
    badge: '13 commands',
  },
  {
    href: '/docs/teams',
    title: 'OpenCastle for Teams',
    description: 'Share one standard across every repository: baselines your repositories extend, a policy for the MCP servers agents may start, a lock file that records what every assistant is given, and a review of what each change does.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    badge: 'guide',
  },
  {
    href: '/docs/prompts',
    title: 'Prompt Templates',
    description: 'Ready-to-use prompt templates for the Team Lead agent. Brainstorm ideas, implement features, fix bugs, resolve PR comments, and generate task specs.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    badge: '14 prompts',
  },
  {
    href: '/docs/agent-plugins',
    title: 'Agent Plugins & Open Standards',
    description: 'AGENTS.md, Agent Skills, MCP and Agent Plugins 1.0 — what each covers and where OpenCastle writes it. Use any Agent Plugin in every assistant, and publish your team\'s standard as one.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    badge: 'standard',
  },
  {
    href: '/docs/plugins',
    title: 'Integrations',
    description: 'Set up each integration: the skill it adds, how its MCP server signs in, and the config init writes for it.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>`,
    badge: `${integrationCount} integrations`,
  },
  {
    href: '/docs/use-cases',
    title: 'Use Cases',
    description: 'Convoy runs, end to end, with real output: plan and run a feature, stop and resume a run, and run a spec you wrote. Each with its time and cost.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>`,
    sidebarIcon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>`,
    badge: '3 recipes',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
  </head>
  <body>
    <header class="docs-header">
      <div class="docs-header__inner">
        <div class="docs-header__brand">
          <a href="/" class="docs-header__logo-link">
            <img class="docs-header__icon" src="/icon-192.png" alt="OpenCastle" width="28" height="28" />
          </a>
          <h1 class="docs-header__title">Docs</h1>
        </div>
      </div>
    </header>

    <div class="docs-layout">
      <!-- Sidebar Navigation -->
      <nav class="docs-sidebar">
        <ul class="docs-sidebar__list">
          <li>
            <a class="docs-sidebar__link docs-sidebar__link--active" href="#quick-start">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              Quick Start
            </a>
          </li>
          <li>
            <a class="docs-sidebar__link" href="#demo-video">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Demo Video
            </a>
          </li>
          <li>
            <a class="docs-sidebar__link" href="#staying-in-sync">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
              Staying in Sync
            </a>
          </li>
        </ul>

        <div class="docs-sidebar__divider"></div>
        <p class="docs-sidebar__label">Pages</p>
        <ul class="docs-sidebar__list">
          {pages.map((page) => (
            <li>
              <a class="docs-sidebar__link" href={page.href}>
                <Fragment set:html={page.sidebarIcon} />
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main class="docs-main">
        <section class="docs-hero">
          <h2 class="docs-hero__heading">OpenCastle Documentation</h2>
          <p class="docs-hero__sub">Everything you need to compile one AI config for every assistant, share it across your team's repositories, and check it on every pull request.</p>
        </section>

        <!-- Quick start -->
        <section class="quickstart" id="quick-start">
          <h3 class="quickstart__heading">Quick Start</h3>
          <div class="quickstart__steps">
            <!-- Step 1: Install -->
            <div class="quickstart__step">
              <span class="quickstart__num">1</span>
              <div>
                <p class="quickstart__label">Install</p>
                <code class="quickstart__code">npx opencastle init</code>
                <p class="quickstart__hint">Needs Node.js 22.5 or newer.</p>
              </div>
            </div>

            <!-- Step 2: Confirm what it found -->
            <div class="quickstart__step">
              <span class="quickstart__num">2</span>
              <div>
                <p class="quickstart__label">Confirm what it found</p>
                <p class="quickstart__desc">It reads your repository first &mdash; which assistants already have config, which framework, database, and test runner you use &mdash; shows the plan, and asks once: <em>Set this up? [Y/n]</em>. <code class="quickstart__code">--yes</code> accepts without asking. Prefer to choose by hand? <code class="quickstart__code">npx opencastle init --customize</code>.</p>
                <p class="quickstart__desc">Root files you wrote &mdash; <code class="quickstart__code">CLAUDE.md</code>, <code class="quickstart__code">.cursorrules</code>, <code class="quickstart__code">AGENTS.md</code>, <code class="quickstart__code">copilot-instructions.md</code> &mdash; keep your content above a managed block. A file of yours inside a directory OpenCastle generates, such as <code class="quickstart__code">.cursor/rules/</code> or <code class="quickstart__code">.claude/agents/</code>, is named by <code class="quickstart__code">init</code> and removed by the next <code class="quickstart__code">sync</code>: move it into <code class="quickstart__code">.opencastle/</code> and it is compiled for every assistant.</p>
              </div>
            </div>
          </div>

          <!-- Single assistant switcher for steps 3–5 -->
          <div class="quickstart__ide-switcher">
            <div class="quickstart__tabs" role="tablist" aria-label="Assistant">
              <button class="quickstart__tab quickstart__tab--active" role="tab" aria-selected="true" data-ide="vscode">VS Code</button>
              <button class="quickstart__tab" role="tab" aria-selected="false" data-ide="cursor">Cursor</button>
              <button class="quickstart__tab" role="tab" aria-selected="false" data-ide="claude-code">Claude Code</button>
              <button class="quickstart__tab" role="tab" aria-selected="false" data-ide="opencode">OpenCode</button>
              <button class="quickstart__tab" role="tab" aria-selected="false" data-ide="windsurf">Windsurf</button>
              <button class="quickstart__tab" role="tab" aria-selected="false" data-ide="codex">Codex</button>
              <button class="quickstart__tab" role="tab" aria-selected="false" data-ide="gemini">Antigravity</button>
            </div>
          </div>

          <div class="quickstart__steps">
            <!-- Step 3: Open your assistant -->
            <div class="quickstart__step">
              <span class="quickstart__num">3</span>
              <div>
                <p class="quickstart__label">Open your assistant</p>
                <div class="quickstart__panels" data-panel-group="step3">
                  <div class="quickstart__panel quickstart__panel--active" data-ide="vscode" role="tabpanel">
                    <p class="quickstart__desc">Open VS Code and reload the window (<code class="quickstart__code">Cmd+Shift+P</code> &rarr; <em>&ldquo;Developer: Reload Window&rdquo;</em>). This loads the OpenCastle agents, skills, and instructions.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="cursor" role="tabpanel" hidden>
                    <p class="quickstart__desc">Open Cursor &mdash; the rules load from <code class="quickstart__code">.cursor/rules/</code>, and skills from <code class="quickstart__code">.agents/skills/</code> when a task matches or you type <code class="quickstart__code">/</code> and the skill's name.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="claude-code" role="tabpanel" hidden>
                    <p class="quickstart__desc">Run <code class="quickstart__code">claude</code> in your terminal from the project root. It loads CLAUDE.md; skills come from <code class="quickstart__code">.claude/skills/</code> and MCP servers from <code class="quickstart__code">.mcp.json</code>.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="opencode" role="tabpanel" hidden>
                    <p class="quickstart__desc">Run <code class="quickstart__code">opencode</code> in your terminal from the project root. It loads AGENTS.md; skills come from <code class="quickstart__code">.agents/skills/</code> and MCP servers from <code class="quickstart__code">opencode.json</code>.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="windsurf" role="tabpanel" hidden>
                    <p class="quickstart__desc">Open Windsurf (Devin Desktop) &mdash; rules load from <code class="quickstart__code">.windsurf/rules/</code>, skills from <code class="quickstart__code">.agents/skills/</code>, and the Devin Local agent starts the MCP servers in <code class="quickstart__code">.devin/mcp_config.json</code>.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="codex" role="tabpanel" hidden>
                    <p class="quickstart__desc">Run <code class="quickstart__code">codex</code> in your terminal from the project root and trust the project when it asks. AGENTS.md is loaded, skills come from <code class="quickstart__code">.agents/skills/</code> and MCP servers from <code class="quickstart__code">.codex/config.toml</code>.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="gemini" role="tabpanel" hidden>
                    <p class="quickstart__desc">Open Antigravity &mdash; it loads GEMINI.md, and AGENTS.md when Codex or OpenCode is set up too; skills come from <code class="quickstart__code">.agents/skills/</code> and MCP servers from <code class="quickstart__code">.agents/mcp_config.json</code>.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 4: Bootstrap your project -->
            <div class="quickstart__step">
              <span class="quickstart__num">4</span>
              <div>
                <p class="quickstart__label">Bootstrap an existing codebase</p>
                <p class="quickstart__desc">Run the <code class="quickstart__code">bootstrap-customizations</code> prompt once. It fills in what <code class="quickstart__code">init</code> could not detect &mdash; schemas, API routes, environment variables &mdash; in the <code class="quickstart__code">.opencastle/</code> files init pre-filled.</p>
                <div class="quickstart__panels" data-panel-group="step4">
                  <div class="quickstart__panel quickstart__panel--active" data-ide="vscode" role="tabpanel">
                    <p class="quickstart__desc">In Copilot Chat type <code class="quickstart__code">/oc:bootstrap-customizations</code> &mdash; it runs as the Team Lead (OpenCastle) agent.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="cursor" role="tabpanel" hidden>
                    <p class="quickstart__desc">No slash command here &mdash; ask for the prompt by name: <em>&ldquo;Run the bootstrap-customizations prompt in .cursor/rules/prompts/.&rdquo;</em></p>
                  </div>
                  <div class="quickstart__panel" data-ide="claude-code" role="tabpanel" hidden>
                    <p class="quickstart__desc">Type <code class="quickstart__code">/oc:bootstrap-customizations</code>.</p>
                  </div>
                  <div class="quickstart__panel" data-ide="opencode" role="tabpanel" hidden>
                    <p class="quickstart__desc">No slash command here &mdash; ask for the prompt by name: <em>&ldquo;Run the bootstrap-customizations prompt in .opencode/prompts/.&rdquo;</em></p>
                  </div>
                  <div class="quickstart__panel" data-ide="windsurf" role="tabpanel" hidden>
                    <p class="quickstart__desc">No slash command here &mdash; ask for the prompt by name: <em>&ldquo;Run the bootstrap-customizations prompt in .windsurf/rules/prompts/.&rdquo;</em></p>
                  </div>
                  <div class="quickstart__panel" data-ide="codex" role="tabpanel" hidden>
                    <p class="quickstart__desc">No slash command here &mdash; ask for the prompt by name: <em>&ldquo;Run the bootstrap-customizations prompt in .codex/prompts/.&rdquo;</em></p>
                  </div>
                  <div class="quickstart__panel" data-ide="gemini" role="tabpanel" hidden>
                    <p class="quickstart__desc">No slash command here &mdash; ask for the prompt by name: <em>&ldquo;Run the bootstrap-customizations prompt in .agents/prompts/.&rdquo;</em></p>
                  </div>
                </div>
                <p class="quickstart__hint">Skip this step for brand-new projects &mdash; there&rsquo;s nothing to detect yet. How each assistant runs a prompt: <a href="/docs/prompts#how-to-use">Prompt Templates</a>.</p>
              </div>
            </div>

            <!-- Step 5: Start building -->
            <div class="quickstart__step">
              <span class="quickstart__num">5</span>
              <div>
                <p class="quickstart__label">Start building</p>
                <p class="quickstart__desc">Choose how you want to work:</p>

                <div class="quickstart__options">
                  <!-- Option A: In chat -->
                  <div class="quickstart__option">
                    <span class="quickstart__option-letter">A</span>
                    <div>
                      <p class="quickstart__option-title">In your assistant&rsquo;s chat <span class="quickstart__option-badge">recommended</span></p>
                      <p class="quickstart__desc">Ask the <strong>Team Lead</strong> for a feature, a fix, or a refinement. It scores the work, delegates a small task to a specialist agent in the same session, and writes larger work up as a convoy spec for you to run (option B).</p>
                      <div class="quickstart__panels" data-panel-group="step5a">
                        <div class="quickstart__panel quickstart__panel--active" data-ide="vscode" role="tabpanel">
                          <p class="quickstart__desc">In Copilot Chat pick the <strong>Team Lead (OpenCastle)</strong> agent and describe what you want built.</p>
                        </div>
                        <div class="quickstart__panel" data-ide="cursor" role="tabpanel" hidden>
                          <p class="quickstart__desc">Start a new chat, mention the Team Lead, and describe what you want built. Its rule loads when the model judges that a request matches it; naming it makes sure.</p>
                        </div>
                        <div class="quickstart__panel" data-ide="claude-code" role="tabpanel" hidden>
                          <p class="quickstart__desc">Ask Claude to act as the Team Lead and describe what you want built &mdash; CLAUDE.md tells it where the Team Lead&rsquo;s definition is.</p>
                        </div>
                        <div class="quickstart__panel" data-ide="opencode" role="tabpanel" hidden>
                          <p class="quickstart__desc">Ask it to act as the Team Lead and describe what you want built &mdash; AGENTS.md tells it where the Team Lead&rsquo;s definition is.</p>
                        </div>
                        <div class="quickstart__panel" data-ide="windsurf" role="tabpanel" hidden>
                          <p class="quickstart__desc">Start a new chat, mention the Team Lead, and describe what you want built. Its rule loads when the model judges that a request matches it; naming it makes sure.</p>
                        </div>
                        <div class="quickstart__panel" data-ide="codex" role="tabpanel" hidden>
                          <p class="quickstart__desc">Ask it to act as the Team Lead and describe what you want built &mdash; AGENTS.md tells it where the Team Lead&rsquo;s definition is.</p>
                        </div>
                        <div class="quickstart__panel" data-ide="gemini" role="tabpanel" hidden>
                          <p class="quickstart__desc">Ask it to act as the Team Lead and describe what you want built &mdash; GEMINI.md tells it where the Team Lead&rsquo;s definition is.</p>
                        </div>
                      </div>
                      <p class="quickstart__desc">For common jobs a prompt gives it a fixed procedure &mdash; brainstorm, bug-fix, implement-feature and more; bug-fix and implement-feature end in a convoy spec for you to run. <a href="/docs/prompts#how-to-use">How each assistant runs them</a>.</p>
                    </div>
                  </div>

                  <!-- Option B: Convoy -->
                  <div class="quickstart__option">
                    <span class="quickstart__option-letter">B</span>
                    <div>
                      <p class="quickstart__option-title">Convoy <span class="quickstart__option-badge">autonomous</span> <span class="quickstart__option-badge">experimental</span></p>
                      <p class="quickstart__desc">For larger work, the convoy engine plans the work, then runs its tasks in parallel, each in its own git worktree, on the agent CLI init set up. It is experimental and may change.</p>
                      <div class="quickstart__substeps">
                        <div class="quickstart__substep">
                          <span class="quickstart__substep-num">1</span>
                          <p class="quickstart__desc"><strong>Plan:</strong> <code class="quickstart__code">npx opencastle convoy "Add tags to notes, and reject a note without a title"</code>. Planning changes no code: it writes a PRD and a spec to <code class="quickstart__code">.opencastle/</code>, shows the plan as a table, and asks <em>&ldquo;Run it? [Y/n]&rdquo;</em>. Answer <em>n</em> to edit the spec first and run it later with <code class="quickstart__code">npx opencastle convoy run</code>.</p>
                        </div>
                        <div class="quickstart__substep">
                          <span class="quickstart__substep-num">2</span>
                          <p class="quickstart__desc"><strong>Watch:</strong> the run prints each task as it finishes, with its time and cost; on a terminal it also prints the address of a live viewer. <code class="quickstart__code">npx opencastle convoy</code> says where the last run stands; after Ctrl+C or a failure, <code class="quickstart__code">npx opencastle convoy resume</code> carries on.</p>
                        </div>
                        <div class="quickstart__substep">
                          <span class="quickstart__substep-num">3</span>
                          <p class="quickstart__desc"><strong>Merge:</strong> the work is on a branch of its own, and the run ends with the <code class="quickstart__code">git diff</code> and <code class="quickstart__code">git merge</code> commands for it. Your checkout is not touched.</p>
                        </div>
                      </div>
                      <p class="quickstart__hint">Worked runs, with their time and cost: <a href="/docs/use-cases">Use cases</a>. Every command and option: <a href="/docs/cli#convoy">CLI reference</a>.</p>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </section>

        <!-- Demo Video -->
        <section class="demo-video-section" id="demo-video">
          <h3 class="demo-video-section__heading">Demo: from init to a drift check</h3>
          <div class="demo-video-section__wrapper">
            <video
              class="demo-video-section__player"
              controls
              playsinline
              preload="metadata"
              webkit-playsinline
              aria-describedby="demo-video-caption"
            >
              <source src="/opencastle-demo.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <p class="demo-video-section__caption" id="demo-video-caption">
            A Next.js and Supabase project that already has a <code class="quickstart__code">CLAUDE.md</code> and a
            <code class="quickstart__code">.cursorrules</code>. <code class="quickstart__code">npx opencastle</code> reports
            that it is not set up. <code class="quickstart__code">npx opencastle init</code> finds Claude Code and Cursor,
            Next.js, Supabase and Vitest, and asks once. <code class="quickstart__code">npx opencastle add linear slack</code>
            adds two integrations, and <code class="quickstart__code">npx opencastle explain</code> shows what every
            assistant is given and what is left to set up. Last, a hand edit to a generated skill:
            <code class="quickstart__code">npx opencastle sync --check</code> catches it, and
            <code class="quickstart__code">npx opencastle sync</code> restores the file.
          </p>
        </section>

        <!-- Staying in sync -->
        <section class="quickstart" id="staying-in-sync">
          <h3 class="quickstart__heading">Staying in sync</h3>
          <div class="quickstart__steps">
            <div class="quickstart__step">
              <span class="quickstart__num">&bull;</span>
              <div>
                <p class="quickstart__label">Ask what needs doing</p>
                <p class="quickstart__desc">Run <code class="quickstart__code">opencastle</code> with no arguments. It reports which targets exist, whether the generated files are still current, which assistants are configured but not being compiled, and the one command to run next.</p>
              </div>
            </div>
            <div class="quickstart__step">
              <span class="quickstart__num">&bull;</span>
              <div>
                <p class="quickstart__label">Recompile</p>
                <p class="quickstart__desc"><code class="quickstart__code">opencastle sync</code> regenerates every target from source. Your customizations in <code class="quickstart__code">.opencastle/</code> are kept, and so is your content above the managed block of a root file such as <code class="quickstart__code">CLAUDE.md</code>. A file added by hand inside a generated directory, such as <code class="quickstart__code">.cursor/rules/</code>, is removed &mdash; put it in <code class="quickstart__code">.opencastle/</code> and it is compiled for every assistant.</p>
              </div>
            </div>
            <div class="quickstart__step">
              <span class="quickstart__num">&bull;</span>
              <div>
                <p class="quickstart__label">Catch drift in CI</p>
                <p class="quickstart__desc"><code class="quickstart__code">opencastle sync --check</code> compiles to a scratch directory and compares. It writes nothing and exits non-zero when a generated file no longer matches its source &mdash; someone edited <code class="quickstart__code">.cursor/rules/foo.mdc</code> by hand, dropped a file into a generated directory, or upgraded without recompiling. Without it, drift is invisible: a stale rule file still loads fine.</p>
                <p class="quickstart__desc">Commit the generated config, like a lockfile &mdash; that is what gives the check something to compare, and what lets a teammate clone the repo and have working rules without running anything. Only <code class="quickstart__code">.env</code> and run artefacts are gitignored.</p>
                <p class="quickstart__desc">Run <code class="quickstart__code">opencastle ci</code> once. It writes <code class="quickstart__code">.github/workflows/opencastle.yml</code>: checkout, install, <code class="quickstart__code">sync --check</code> with the OpenCastle version the project uses, and <code class="quickstart__code">review</code> on pull requests. On another CI, run <code class="quickstart__code">npx opencastle sync --check</code> with opencastle as a devDependency. See <a href="/docs/cli#ci">opencastle ci</a>.</p>
              </div>
            </div>
            <div class="quickstart__step">
              <span class="quickstart__num">&bull;</span>
              <div>
                <p class="quickstart__label">Adopt a new tool</p>
                <p class="quickstart__desc"><code class="quickstart__code">opencastle add supabase</code> updates the stored stack and recompiles, so the integration's skills and MCP config reach every target. <code class="quickstart__code">opencastle add --list</code> shows what is available.</p>
              </div>
            </div>
            <div class="quickstart__step">
              <span class="quickstart__num">&bull;</span>
              <div>
                <p class="quickstart__label">Share it across a team</p>
                <p class="quickstart__desc"><code class="quickstart__code">opencastle baseline init</code> starts a standard every repository can extend, and <code class="quickstart__code">opencastle explain</code> shows a new teammate what their assistant is given and what they still need to set up. See <a href="/docs/teams">OpenCastle for Teams</a>.</p>
              </div>
            </div>
          </div>
        </section>

