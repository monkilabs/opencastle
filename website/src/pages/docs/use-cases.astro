---
import '../../styles/global.css';

const title = 'Use Cases — OpenCastle';
const description = 'Cookbook-style recipes for building real applications with OpenCastle. Follow step-by-step guides to build personal portfolios, SaaS dashboards, and more using your AI agent team.';

const recipes = [
  {
    id: 'portfolio',
    title: 'Build a Personal Portfolio Website',
    status: 'published' as const,
    steps: [
      { id: 'intro', label: 'Introduction' },
      { id: 'what-youll-build', label: "What you'll build" },
      { id: 'prerequisites', label: 'Prerequisites' },
      { id: 'step-1', label: 'Step 1: Initialize' },
      { id: 'step-2', label: 'Step 2: Describe project' },
      { id: 'step-3', label: 'Step 3: Review the spec' },
      { id: 'step-4', label: 'Step 4: Preview the plan' },
      { id: 'step-5', label: 'Step 5: Execute' },
      { id: 'step-6', label: 'Step 6: Monitor' },
      { id: 'step-7', label: 'Step 7: Review & iterate' },
      { id: 'troubleshooting', label: 'Tips & Troubleshooting' },
      { id: 'whats-next', label: "What's next" },
    ],
  },
  {
    id: 'team-work',
    title: 'Team Work with Linear',
    status: 'published' as const,
    steps: [
      { id: 'team-intro', label: 'Introduction' },
      { id: 'team-what-youll-build', label: "What you'll set up" },
      { id: 'team-prerequisites', label: 'Prerequisites' },
      { id: 'team-step-1', label: 'Step 1: Initialize' },
      { id: 'team-step-2', label: 'Step 2: Connect Linear' },
      { id: 'team-step-3', label: 'Step 3: Create issues' },
      { id: 'team-step-4', label: 'Step 4: Assign & partition' },
      { id: 'team-step-5', label: 'Step 5: Execute convoy' },
      { id: 'team-step-6', label: 'Step 6: Review together' },
      { id: 'team-step-7', label: 'Step 7: Ship the PR' },
      { id: 'team-troubleshooting', label: 'Tips & Troubleshooting' },
      { id: 'team-whats-next', label: "What's next" },
    ],
  },
  {
    id: 'api-backend',
    title: 'Build a REST API Backend',
    status: 'published' as const,
    steps: [
      { id: 'api-intro', label: 'Introduction' },
      { id: 'api-what-youll-build', label: "What you'll build" },
      { id: 'api-prerequisites', label: 'Prerequisites' },
      { id: 'api-step-1', label: 'Step 1: Initialize' },
      { id: 'api-step-2', label: 'Step 2: Describe the API' },
      { id: 'api-step-3', label: 'Step 3: Review the PRD' },
      { id: 'api-step-4', label: 'Step 4: Preview the plan' },
      { id: 'api-step-5', label: 'Step 5: Execute' },
      { id: 'api-step-6', label: 'Step 6: Test the API' },
      { id: 'api-step-7', label: 'Step 7: Review & iterate' },
      { id: 'api-troubleshooting', label: 'Tips & Troubleshooting' },
      { id: 'api-whats-next', label: "What's next" },
    ],
  },
  {
    id: 'existing-project',
    title: 'Add OpenCastle to an Existing Project',
    status: 'published' as const,
    steps: [
      { id: 'existing-intro', label: 'Introduction' },
      { id: 'existing-what-youll-set-up', label: "What you'll set up" },
      { id: 'existing-prerequisites', label: 'Prerequisites' },
      { id: 'existing-step-1', label: 'Step 1: Initialize' },
      { id: 'existing-step-2', label: 'Step 2: Review integrations' },
      { id: 'existing-step-3', label: 'Step 3: Verify setup' },
      { id: 'existing-step-4', label: 'Step 4: Generate a PRD' },
      { id: 'existing-step-5', label: 'Step 5: Review PRD & run' },
      { id: 'existing-step-6', label: 'Step 6: Verify compatibility' },
      { id: 'existing-step-7', label: 'Step 7: Iterate & expand' },
      { id: 'existing-troubleshooting', label: 'Tips & Troubleshooting' },
      { id: 'existing-whats-next', label: "What's next" },
    ],
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
  </head>
  <body>
    <header class="docs-header">
      <div class="docs-header__inner">
        <div class="docs-header__brand">
          <a href="/" class="docs-header__logo-link">
            <img class="docs-header__icon" src="/icon-192.png" alt="OpenCastle" width="28" height="28" />
          </a>
          <h1 class="docs-header__title">
            <a href="/docs/" class="docs-header__breadcrumb-link">Docs</a>
            <span class="docs-header__breadcrumb-sep">/</span>
            Use Cases
          </h1>
        </div>
      </div>
    </header>

    <div class="docs-layout">
      <nav class="docs-sidebar" id="docs-sidebar">
        <p class="docs-sidebar__label">Use Cases</p>
        {recipes.map((r, i) => (
          <div class="docs-sidebar__group" data-recipe={r.id}>
            <a class={`docs-sidebar__link ${i === 0 ? 'docs-sidebar__link--active' : ''}`} href={`#${r.id}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
              {r.title}
            </a>
            <ul class="docs-sidebar__list docs-sidebar__steps">
              {r.steps.map(step => (
                <li>
                  <a class="docs-sidebar__link docs-sidebar__cmd" href={`#${step.id}`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    {step.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <main class="docs-main">
        <p class="docs-subtitle">
          Cookbook-style recipes that walk you through building real applications end-to-end
          using OpenCastle's AI agent team. Each recipe covers setup, execution, iteration, and delivery.
        </p>
        <div class="recipe-tip">
          <strong>Experimental:</strong> these recipes run their work through the convoy engine
          (<code>opencastle convoy</code>), which is experimental and may change. Its commands are on the
          <a href="/docs/cli#convoy">CLI page</a>.
        </div>

        <article class="recipe" id="portfolio">
          <h2 class="recipe__title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
            Build a Personal Portfolio Website
          </h2>

          <!-- Introduction -->
          <section class="recipe-section" id="intro">
            <h3 class="recipe-section__heading">Introduction</h3>
            <p class="recipe-section__body">
              This recipe builds a personal portfolio website with OpenCastle's AI agent team, from an
              empty directory to code on a feature branch ready for review. One <code>opencastle convoy</code>
              command turns your description into a plan; the convoy engine then runs specialist agents
              on it, in parallel where the plan allows.
            </p>
          </section>

          <!-- What you'll build -->
          <section class="recipe-section" id="what-youll-build">
            <h3 class="recipe-section__heading">What you'll build</h3>
            <p class="recipe-section__body">A personal portfolio site with four pages:</p>
            <ul class="recipe-section__list">
              <li><strong>Home</strong> — Hero section with name/tagline, recent projects grid, and a call to action</li>
              <li><strong>About</strong> — Bio paragraph, skills grid, timeline, and social links</li>
              <li><strong>Projects</strong> — Filterable project cards with tags, links, and screenshots</li>
              <li><strong>Contact</strong> — Accessible contact form with client and server-side validation</li>
            </ul>
            <p class="recipe-section__body">
              The stack goes in your description: this recipe asks for Next.js with Tailwind CSS. Responsive
              layout, dark mode and SEO are in the description too, so they end up in the plan.
            </p>
          </section>

          <!-- Prerequisites -->
          <section class="recipe-section" id="prerequisites">
            <h3 class="recipe-section__heading">Prerequisites</h3>
            <ul class="recipe-prereq">
              <li>Node.js 22.5 or later</li>
              <li>Git</li>
              <li>An AI coding assistant OpenCastle compiles for — Claude Code, VS Code with GitHub Copilot, Cursor, Windsurf, OpenCode, Codex CLI or Antigravity</li>
              <li>An agent runtime the convoy can drive, signed in: GitHub Copilot, Claude Code (<code>claude</code>), Cursor's agent CLI (<code>agent</code>), OpenCode (<code>opencode</code>) or Codex (<code>codex</code>). OpenCastle uses the first it finds, Copilot first; <code>--adapter &lt;name&gt;</code> picks one</li>
              <li>An empty directory</li>
            </ul>
          </section>

          <!-- Step 1 -->
          <section class="recipe-section recipe-step" id="step-1">
            <div class="recipe-step__number">1</div>
            <h3 class="recipe-section__heading">Step 1: Initialize your project</h3>
            <p class="recipe-section__body">
              Create a git repository and run the initializer. It reads the repository, shows what it found
              and asks once; press Enter to accept. An empty directory has no stack to find, so it sets up
              VS Code with Chrome DevTools and writes <code>.github/</code>, <code>.vscode/mcp.json</code> and
              <code>.opencastle/</code>. For another assistant, run <code>npx opencastle init --customize</code>
              instead.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ mkdir my-portfolio &amp;&amp; cd my-portfolio
$ git init
$ npm init -y
$ npx opencastle init</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  🏰 OpenCastle v1.0.0
  Compiles your AI assistant config for every assistant you use

  Scanning repository…

  Will compile for:
    → VS Code (new)

  Integrations detected:
    chrome-devtools

  Set this up? [Y/n]
  Configuring project...
  ✓ Populated 2 config files
  → Removed 9 unused template(s)
  ✓ Created 113 files
  ✓ Created .gitignore with OpenCastle entries

  Next steps:
  1. Reload VS Code window (Cmd+Shift+P → "Developer: Reload Window")
  2. Type /oc: in Copilot Chat for OpenCastle's commands — /oc:bootstrap-customizations first on an existing codebase
  3. Commit what this wrote, .opencastle/ included — teammates get the same setup on clone
  4. opencastle ci — fail a pull request whose generated config no longer matches

  Also used by your team? opencastle init --customize
  compiles the same config for Cursor, Claude Code, OpenCode, Windsurf, Codex CLI, Antigravity</code></pre>
            </div>
            <p class="recipe-section__body">
              Commit what init wrote. The convoy runs each task in a git worktree made from your last commit,
              so files that aren't committed aren't there.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ git add -A
$ git commit -m "Add OpenCastle"</code></pre>
            </div>
            <div class="recipe-tip">
              <strong>Tip:</strong> init picks integrations from your <code>package.json</code> and config
              files. Add one later with <code>npx opencastle add &lt;pack&gt;</code> —
              <code>npx opencastle add --list</code> shows them all. Every init flag is on the
              <a href="/docs/cli#init">CLI page</a>.
            </div>
          </section>

          <!-- Step 2 -->
          <section class="recipe-section recipe-step" id="step-2">
            <div class="recipe-step__number">2</div>
            <h3 class="recipe-section__heading">Step 2: Describe your project</h3>
            <p class="recipe-section__body">
              Run <code>npx opencastle convoy "&lt;task&gt;"</code> with a plain-English description of what you
              want. OpenCastle writes a product requirements document (PRD), validates it, assesses its
              complexity, turns it into a convoy spec and validates that too. Each step is one of the
              <a href="/docs/prompts#pipeline">convoy pipeline prompts</a>; the fix steps run only when a
              validation fails, which is why this run goes from step 2 to step 4.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy "Build a personal portfolio website with Next.js and \
  Tailwind CSS: a home page featuring a hero section and recent projects, an \
  about page with bio and skills, a projects page with filterable cards, and a \
  contact page with a form. Use modern design, dark mode support, responsive \
  layout, and SEO optimization."</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  opencastle convoy

  [1/7] Generating PRD…

  ✓ PRD written to .opencastle/prds/portfolio.prd.md

  [2/7] Validating PRD…
  [4/7] Assessing complexity…
  (running in parallel)

  ✓ Complexity assessment saved to .opencastle/prds/portfolio.complexity.json
  ✓ PRD is valid

  ℹ Complexity: medium | Strategy: single

  Generating task plan…

  ✓ Task plan generated (6 tasks)
  ✓ Convoy spec written to .opencastle/convoys/portfolio.convoy.yml

  ✓ Schema validation passed
  Validating convoy spec…

  ✓ Spec is valid

  Pipeline complete!

  PRD:           .opencastle/prds/portfolio.prd.md
  Convoy spec:   .opencastle/convoys/portfolio.convoy.yml

  Preview: npx opencastle convoy run .opencastle/convoys/portfolio.convoy.yml --dry-run
  Execute: npx opencastle convoy run .opencastle/convoys/portfolio.convoy.yml

  Run it? [Y/n]</code></pre>
            </div>
            <div class="recipe-tip">
              <strong>Answer n.</strong> The run ends by asking <code>Run it? [Y/n]</code>, and
              Enter means yes. This recipe reviews the spec and previews the plan first, so answer
              <strong>n</strong>; the <code>Preview:</code> and <code>Execute:</code> lines are the commands for
              Steps 4 and 5.
            </div>
            <div class="recipe-tip">
              <strong>Tip:</strong> <code>--dry-run</code> plans, shows the plan and writes the spec, and
              stops there. <code>--yes</code> runs the plan without asking.
            </div>
          </section>

          <!-- Step 3 -->
          <section class="recipe-section recipe-step" id="step-3">
            <div class="recipe-step__number">3</div>
            <h3 class="recipe-section__heading">Step 3: Review the generated spec</h3>
            <p class="recipe-section__body">
              Open <code>.opencastle/convoys/portfolio.convoy.yml</code>. It lists every task with its agent,
              the files it may change, and the tasks it waits for; the CLI adds the defaults — timeouts,
              retries, review.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">.opencastle/convoys/portfolio.convoy.yml (excerpt)</div>
              <pre><code># .opencastle/convoys/portfolio.convoy.yml
name: Portfolio
version: 1
concurrency: 3
on_failure: stop
branch: feat/portfolio
defaults:
  timeout: 30m
  max_retries: 1
  review: fast
  …
tasks:
  - id: foundation-setup
    agent: ui-ux-expert
    description: Scaffold Next.js with Tailwind, design tokens, layout and UI components
    files:
      - package.json
      - tsconfig.json
      - app/globals.css
      - app/layout.tsx
      - components/ui/
    prompt: Set up a Next.js App Router project with TypeScript and Tailwind CSS. Create design tokens in app/globals.css, a
      shared layout in app/layout.tsx, and Button, Card, Heading and Section components in components/ui/. Run npm run
      lint and npx tsc --noEmit; both must pass.
  - id: home-page
    agent: developer
    description: Build home page with hero section and projects grid
    files:
      - app/page.tsx
      - components/Hero.tsx
      - components/ProjectGrid.tsx
    depends_on:
      - foundation-setup
    …
  - id: seo-meta
    agent: developer
    description: Add SEO metadata, Open Graph image, and a sitemap
    files:
      - app/sitemap.ts
      - app/opengraph-image.tsx
    depends_on:
      - home-page
      - about-page
      - projects-page
      - contact-page
    prompt: Add an Open Graph image at app/opengraph-image.tsx and a sitemap at app/sitemap.ts covering every page.
gates:
  - npm run lint
  - npx tsc --noEmit</code></pre>
            </div>
            <div class="recipe-tip">
              <strong>Tip:</strong> You can edit the spec before running it — add tasks, change
              <code>files</code>, agents or dependencies. Keep <code>files</code> to plain paths: the engine
              refuses <code>*</code> and <code>?</code>, and two tasks in the same phase may not share a path.
              <code>--dry-run</code> doesn't check either, so the run would stop at the start.
            </div>
          </section>

          <!-- Step 4 -->
          <section class="recipe-section recipe-step" id="step-4">
            <div class="recipe-step__number">4</div>
            <h3 class="recipe-section__heading">Step 4: Preview the execution plan</h3>
            <p class="recipe-section__body">
              Add <code>--dry-run</code> to see the phases and the order tasks will run in, without starting an
              agent. Tasks in the same phase run in parallel, up to <code>concurrency</code>. The adapter is the
              agent runtime the run will use.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy run .opencastle/convoys/portfolio.convoy.yml --dry-run</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  ℹ Auto-detected adapter: copilot

  🏰 Convoy Plan: Portfolio
  Adapter: copilot | Concurrency: 3 | Tasks: 6
  Branch: feat/portfolio
  Gates: 2 validation commands

  🏰 Execution Plan: Portfolio
  Adapter:     copilot
  Concurrency: 3
  On failure:  stop
  Tasks:       6
  ──────────────────────────────────
  Phase 1:
    foundation-setup — Scaffold Next.js with Tailwind, design tokens, layout and UI components [ui-ux-expert, 30m] [package.json, tsconfig.json, app/globals.css, app/layout.tsx, components/ui/]

  Phase 2:
    home-page — Build home page with hero section and projects grid [developer, 30m] (after: foundation-setup) [app/page.tsx, components/Hero.tsx, components/ProjectGrid.tsx]
    about-page — Build about page with bio, skills grid, and social links [developer, 30m] (after: foundation-setup) [app/about/page.tsx, components/SkillGrid.tsx]
    projects-page — Build projects page with filterable project cards [developer, 30m] (after: foundation-setup) [app/projects/page.tsx, components/ProjectFilter.tsx]
    contact-page — Build contact page with a validated form [developer, 30m] (after: foundation-setup) [app/contact/page.tsx, app/contact/actions.ts, components/ContactForm.tsx]

  Phase 3:
    seo-meta — Add SEO metadata, Open Graph image, and a sitemap [developer, 30m] (after: home-page, about-page, projects-page, contact-page) [app/sitemap.ts, app/opengraph-image.tsx]</code></pre>
            </div>
          </section>

          <!-- Step 5 -->
          <section class="recipe-section recipe-step" id="step-5">
            <div class="recipe-step__number">5</div>
            <h3 class="recipe-section__heading">Step 5: Execute the convoy</h3>
            <p class="recipe-section__body">
              Run it without <code>--dry-run</code>. The run viewer opens in your browser. The engine creates the
              spec's branch, <code>feat/portfolio</code>, and runs each task in its own git worktree, so agents
              work in parallel without touching each other's files. Each finished task is reviewed and merged
              into the convoy's own branch, and the spec's <code>gates</code> run once at the end. When the run
              ends, OpenCastle prints a summary — what failed and why, the branch, and how to review and merge
              it — and exits.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy run .opencastle/convoys/portfolio.convoy.yml</code></pre>
            </div>
            <div class="recipe-tip">
              <strong>Note:</strong> If your machine sleeps or the process is interrupted, resume any time
              with <code>npx opencastle convoy resume</code>. It also re-runs the tasks that failed, and the
              ones a failure skipped; finished tasks are kept.
            </div>
          </section>

          <!-- Step 6 -->
          <section class="recipe-section recipe-step" id="step-6">
            <div class="recipe-step__number">6</div>
            <h3 class="recipe-section__heading">Step 6: Monitor progress</h3>
            <p class="recipe-section__body">
              While the convoy runs, or after it finishes, open the run viewer to see what each task did.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal — new tab</div>
              <pre><code>$ npx opencastle convoy dashboard</code></pre>
            </div>
            <p class="recipe-section__body">
              It opens at <code>http://localhost:4300</code>, or the next free port, and shows:
            </p>
            <ul class="recipe-section__list">
              <li>The convoys and their tasks, with each task's status</li>
              <li>The task pipeline, phase by phase</li>
              <li>Review and gate results</li>
              <li>The retry queue: tasks that failed too often and need your attention</li>
              <li>The event timeline and the execution log</li>
            </ul>
            <div class="recipe-tip">
              <strong>Tip:</strong> Whenever a convoy runs in a terminal — <code>convoy run</code>,
              <code>resume</code>, or answering yes to <code>Run it?</code> — it prints a <em>Live view</em>
              address for the viewer. For a short status in the terminal, run <code>npx opencastle convoy</code>.
            </div>
          </section>

          <!-- Step 7 -->
          <section class="recipe-section recipe-step" id="step-7">
            <div class="recipe-step__number">7</div>
            <h3 class="recipe-section__heading">Step 7: Review and iterate</h3>
            <p class="recipe-section__body">
              Check out the feature branch and review the generated code. Run the dev server
              to inspect the result in your browser, then iterate with quick-refinement prompts.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ git checkout feat/portfolio
$ npm run dev
# Open http://localhost:3000 in your browser</code></pre>
            </div>
            <p class="recipe-section__body">
              For tweaks, use the <code>quick-refinement</code> prompt rather than another convoy. In Claude Code
              and Copilot Chat it is <code>/oc:quick-refinement</code>; in the other assistants, ask for it by
              name — see <a href="/docs/prompts#how-to-use">how to run a prompt</a>.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">VS Code Copilot Chat</div>
              <pre><code># Open Copilot Chat (Ctrl+Alt+I) → type /oc:quick-refinement
# Describe the change, for example:
"Polish the hero section animation — fade in from below
 rather than appear instantly. Respect prefers-reduced-motion."</code></pre>
            </div>
            <p class="recipe-section__body">
              When satisfied, run the checks and, with a GitHub remote set up, open a pull request:
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npm run lint
$ git push -u origin feat/portfolio
$ gh pr create --title "feat: personal portfolio" --body "Built with OpenCastle's convoy engine"</code></pre>
            </div>
          </section>

          <!-- Tips & Troubleshooting -->
          <section class="recipe-section" id="troubleshooting">
            <h3 class="recipe-section__heading">Tips &amp; Troubleshooting</h3>
            <div class="recipe-troubleshooting">
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">The PRD or spec keeps failing validation</p>
                <p class="recipe-troubleshooting__solution">
                  OpenCastle tries twice to fix it, then carries on with the best version it has and prints
                  the remaining issues. Read them before you run the spec; if they matter, make your
                  description more specific about scope and requirements and run the pipeline again.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">A task keeps failing</p>
                <p class="recipe-troubleshooting__solution">
                  <code>npx opencastle convoy</code> shows what failed, and the run viewer shows why, with the
                  last lines of each failed task's output. Fix the cause — a failing gate, a missing script —
                  then <code>npx opencastle convoy resume</code> re-runs what is not done.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">Need to change scope mid-run</p>
                <p class="recipe-troubleshooting__solution">
                  Stop the convoy with <code>Ctrl+C</code> — the state is saved to <code>.opencastle/convoy.db</code>.
                  <code>npx opencastle convoy resume</code> continues the run as it was started: it replays the
                  spec saved then, so edits to the file don't apply. To
                  change scope, edit the spec and start a new run with
                  <code>npx opencastle convoy run .opencastle/convoys/portfolio.convoy.yml</code>; it works on
                  the same branch.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">Want to run overnight</p>
                <p class="recipe-troubleshooting__solution">
                  Each task writes its state to <code>.opencastle/convoy.db</code> before and after it runs. If
                  your machine sleeps or the process is killed, <code>npx opencastle convoy resume</code> picks up
                  where it left off.
                </p>
              </div>
            </div>
          </section>

          <!-- What's next -->
          <section class="recipe-section" id="whats-next">
            <h3 class="recipe-section__heading">What's next</h3>
            <p class="recipe-section__body">Now that you've shipped a portfolio, try these next steps:</p>
            <ul class="recipe-section__list">
              <li>
                <strong>Larger projects</strong> — The same <code>opencastle convoy</code> command plans an
                e-commerce store or an API backend. When the complexity step finds a PRD too large for one
                convoy, it plans a chain of convoys that run one after another.
              </li>
              <li>
                <strong>Explore Prompt Templates</strong> — The <a href="/docs/prompts">Prompt Templates</a>
                page has ready-to-use templates for brainstorming, feature implementation, PR
                review, and skill creation.
              </li>
              <li>
                <strong>Read the Agentic Development guide</strong> — The <a href="/docs/agentic-development">Agentic Development</a>
                guide covers best practices for multi-agent orchestration, quality gates,
                and how to get the most out of your agent team.
              </li>
              <li>
                <strong>Explore the CLI</strong> — The <a href="/docs/cli">CLI Reference</a>
                documents every <code>opencastle</code> command with all flags and examples.
              </li>
            </ul>
          </section>

        </article>

        <article class="recipe" id="team-work">
          <h2 class="recipe__title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
            Team Work with Linear
          </h2>

          <!-- Introduction -->
          <section class="recipe-section" id="team-intro">
            <h3 class="recipe-section__heading">Introduction</h3>
            <p class="recipe-section__body">This recipe runs OpenCastle in a team repository with Linear as the issue tracker. You'll add the Linear integration, plan a feature with the convoy pipeline, put Linear issue IDs into the convoy's tasks, run the convoy, and open one pull request that closes the issues.</p>
            <p class="recipe-section__body">The convoy engine doesn't talk to Linear itself: the issue IDs travel in the task descriptions and prompts and in the pull request, and Linear closes the issues when the pull request merges. Your assistant reaches Linear through Linear's MCP server, so the Team Lead can create and update issues while you plan.</p>
          </section>

          <!-- What you'll set up -->
          <section class="recipe-section" id="team-what-youll-build">
            <h3 class="recipe-section__heading">What you'll set up</h3>
            <p class="recipe-section__body">A Linear → OpenCastle → Agents → PR workflow that keeps issues, tasks and code tied together. The convoy builds every task on one feature branch, each task carries its Linear ID, and the pull request references them all.</p>

            <div class="recipe-mockup">
              <div class="recipe-mockup__chrome">
                <div class="recipe-mockup__dots"><span></span><span></span><span></span></div>
                <div class="recipe-mockup__url">Linear — Your Team</div>
              </div>
              <div class="recipe-mockup__body">
                <div class="mockup-section-label">Linear board</div>
                <div class="mockup-grid">
                  <div class="mockup-card mockup-card--text">
                    <div class="mockup-card__title">To Do</div>
                    <div class="mockup-card__text">PRJ-211 · Create login form</div>
                    <div class="mockup-card__text">PRJ-212 · Auth flow tests</div>
                  </div>
                  <div class="mockup-card mockup-card--text">
                    <div class="mockup-card__title">In Progress</div>
                    <div class="mockup-card__text">PRJ-210 · Auth API</div>
                  </div>
                  <div class="mockup-card mockup-card--text">
                    <div class="mockup-card__title">Done</div>
                    <div class="mockup-card__text">PRJ-209 · Design auth flow</div>
                  </div>
                </div>
              </div>
              <div class="recipe-mockup__pages">
                <span class="recipe-mockup__page recipe-mockup__page--active">Linear</span>
                <span class="recipe-mockup__page">OpenCastle</span>
                <span class="recipe-mockup__page">Agents</span>
                <span class="recipe-mockup__page">PR</span>
              </div>
            </div>

            <ul class="recipe-section__list">
              <li><strong>Connect Linear</strong> — <code>npx opencastle add linear</code> configures Linear's remote MCP server; each teammate signs in with OAuth.</li>
              <li><strong>Create issues</strong> — one per task in the plan, in Linear or through the Linear tools in your assistant.</li>
              <li><strong>Partition code</strong> — give each task its own files so agents don't collide.</li>
              <li><strong>Run a convoy</strong> — agents build the tasks on one feature branch, ready for a pull request that references the Linear issues.</li>
            </ul>
          </section>

          <!-- Prerequisites -->
          <section class="recipe-section" id="team-prerequisites">
            <h3 class="recipe-section__heading">Prerequisites</h3>
            <ul class="recipe-prereq">
              <li>Node.js 22.5 or later, Git, an AI coding assistant and an agent runtime for the convoy — as in the <a href="#prerequisites">first recipe</a></li>
              <li>A Linear workspace with at least one project</li>
              <li>A shared repository that your team has access to</li>
            </ul>
          </section>

          <!-- Step 1 -->
          <section class="recipe-section recipe-step" id="team-step-1">
            <div class="recipe-step__number">1</div>
            <h3 class="recipe-section__heading">Step 1: Initialize</h3>
            <p class="recipe-section__body">From your local clone, run the initializer. It reads the repository, shows what it found and asks once — the full output is in the <a href="#step-1">first recipe</a>, and every flag is on the <a href="/docs/cli#init">CLI page</a>.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ cd your-team-repo
$ npx opencastle init</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  …
  Set this up? [Y/n]
  Configuring project...
  …
  ✓ Created 113 files
  …</code></pre>
            </div>
          </section>

          <!-- Step 2 -->
          <section class="recipe-section recipe-step" id="team-step-2">
            <div class="recipe-step__number">2</div>
            <h3 class="recipe-section__heading">Step 2: Connect Linear</h3>
            <p class="recipe-section__body">Add the Linear integration. It recompiles the config with Linear's remote MCP server.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle add linear</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  🏰 OpenCastle add

    + linear

  Recompiling targets…

  🏰 OpenCastle sync v1.0.0

  IDEs: VS Code
  Tech: chrome-devtools
  Team: linear
  Framework files are recompiled from source; edits there are replaced.
  Customization files will be preserved.


  ✓ Updated 1 framework files
  + Created 1 new files
  ✓ Updated skill matrix
  ✓ Rebuilt MCP config
  ✓ Updated .opencastle/lock.json (opencastle review explains the change)

  ⟳ Reload VS Code window (Cmd+Shift+P → "Developer: Reload Window") to pick up changes</code></pre>
            </div>
            <p class="recipe-section__body">Linear needs no API key, so <code>npx opencastle doctor</code> reports no variables to set (<a href="/docs/cli#doctor">what doctor checks</a>):</p>
            <div class="recipe-output">
              <pre><code>  …
  ✓ MCP environment variables  No env vars required
  …</code></pre>
            </div>
            <p class="recipe-section__body">Commit what init and add wrote — teammates get the same setup on clone, and the convoy's worktrees start from your last commit. Then open your assistant: the first time it connects to Linear, it opens a browser window to sign in.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ git add .gitignore .opencastle .github .vscode
$ git commit -m "chore: add OpenCastle with Linear"</code></pre>
            </div>
            <div class="recipe-tip"><strong>Tip:</strong> Each teammate signs in once, with their own Linear account, so issue history shows who did what. No shared key to rotate, and nothing secret goes into <code>.env</code> or the committed config.</div>
          </section>

          <!-- Step 3 -->
          <section class="recipe-section recipe-step" id="team-step-3">
            <div class="recipe-step__number">3</div>
            <h3 class="recipe-section__heading">Step 3: Create issues</h3>
            <p class="recipe-section__body">Plan the feature with the convoy pipeline: it writes a PRD and a convoy spec whose tasks you'll map to Linear issues. It runs the same steps as in the <a href="#step-2">first recipe</a>. Answer <strong>n</strong> when it asks <code>Run it? [Y/n]</code> — the IDs go in first.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy "Add user authentication with login, sessions, and role-based access"</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  …
  Pipeline complete!

  PRD:           .opencastle/prds/user-authentication.prd.md
  Convoy spec:   .opencastle/convoys/user-authentication.convoy.yml
  …
  Run it? [Y/n]</code></pre>
            </div>
            <p class="recipe-section__body">Review the generated PRD to confirm it captures the right scope before continuing:</p>
            <div class="recipe-code">
              <div class="recipe-code__header">.opencastle/prds/user-authentication.prd.md (excerpt)</div>
              <pre><code># User Authentication — PRD

## Overview
Add sign-in with email and password, server-side sessions, and role-based access for admins and members.

## Goals
1. A member signs in with email and password and stays signed in for 7 days.
2. Only admins can open /admin.

## Implementation Scope
| Concern | Files / Directories |
|---------|---------------------|
| API | `src/server/auth/` |
| UI | `src/ui/auth/` |
| Tests | `tests/integration/auth/` |
…</code></pre>
            </div>
            <p class="recipe-section__body">Once the PRD looks right, create one Linear issue per task in the spec — in Linear's UI, or by asking your assistant, which has Linear's tools now.</p>
            <div class="recipe-tip"><strong>Tip:</strong> If you prefer full manual control, create the epic and child issues in Linear first, then write the convoy spec by hand with those IDs in it.</div>
          </section>

          <!-- Step 4 -->
          <section class="recipe-section recipe-step" id="team-step-4">
            <div class="recipe-step__number">4</div>
            <h3 class="recipe-section__heading">Step 4: Assign &amp; partition</h3>
            <p class="recipe-section__body">Edit the spec: put each Linear ID in its task's <code>description</code> and <code>prompt</code>, and give each task its own <code>files</code>. Each task runs in an isolated worktree and may change only those paths. Use plain paths — the engine refuses <code>*</code> and <code>?</code>.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">.opencastle/convoys/user-authentication.convoy.yml (excerpt)</div>
              <pre><code># .opencastle/convoys/user-authentication.convoy.yml
name: User authentication
version: 1
concurrency: 3
on_failure: stop
branch: feat/user-authentication
defaults:
  timeout: 30m
  max_retries: 1
  review: fast
  …
tasks:
  - id: api-auth
    agent: developer
    description: PRJ-210 · Implement authentication API with sessions and JWTs
    files:
      - src/server/auth/
    prompt: "Linear issue PRJ-210. Implement the authentication API in src/server/auth/ with server-side sessions and JWTs."
  - id: login-form
    agent: developer
    description: PRJ-211 · Create login form with client-side validation
    files:
      - src/ui/auth/
    depends_on:
      - api-auth
    prompt: "Linear issue PRJ-211. Create the login form in src/ui/auth/ with client-side validation, calling the API from src/server/auth/."
  - id: session-tests
    agent: testing-expert
    description: PRJ-212 · Add integration tests for the auth flow
    files:
      - tests/integration/auth/
    depends_on:
      - login-form
    prompt: "Linear issue PRJ-212. Add integration tests for login, session expiry and role checks in tests/integration/auth/."
gates:
  - npm run lint
  - npx tsc --noEmit</code></pre>
            </div>
            <div class="recipe-tip"><strong>Tip:</strong> Use <code>depends_on</code> for tasks that require artifacts from prior tasks — this enforces ordering and reduces merge conflicts.</div>
          </section>

          <!-- Step 5 -->
          <section class="recipe-section recipe-step" id="team-step-5">
            <div class="recipe-step__number">5</div>
            <h3 class="recipe-section__heading">Step 5: Execute convoy</h3>
            <p class="recipe-section__body">Preview the plan, then run it. Each task runs in its own git worktree and is merged into <code>feat/user-authentication</code> when it passes review — the <a href="#step-5">first recipe</a> describes a run.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy run .opencastle/convoys/user-authentication.convoy.yml --dry-run
$ npx opencastle convoy run .opencastle/convoys/user-authentication.convoy.yml</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  …
  Phase 1:
    api-auth — PRJ-210 · Implement authentication API with sessions and JWTs [developer, 30m] [src/server/auth/]

  Phase 2:
    login-form — PRJ-211 · Create login form with client-side validation [developer, 30m] (after: api-auth) [src/ui/auth/]

  Phase 3:
    session-tests — PRJ-212 · Add integration tests for the auth flow [testing-expert, 30m] (after: login-form) [tests/integration/auth/]</code></pre>
            </div>
            <div class="recipe-tip"><strong>Tip:</strong> <code>npx opencastle convoy resume</code> continues after an interruption or a failure: it re-runs the failed tasks and the ones a failure skipped, and keeps the finished ones.</div>
          </section>

          <!-- Step 6 -->
          <section class="recipe-section recipe-step" id="team-step-6">
            <div class="recipe-step__number">6</div>
            <h3 class="recipe-section__heading">Step 6: Review together</h3>
            <p class="recipe-section__body"><code>npx opencastle convoy</code> shows how the last run ended. Before opening the pull request, check each task's gate and review results in the run viewer, and that every Linear ID is the right one.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  🚚 Convoy (experimental)

  ✓ User authentication — done
    3/3 done

  Nothing outstanding. Start another with opencastle convoy "&lt;task&gt;"</code></pre>
            </div>
            <div class="recipe-tip"><strong>Tip:</strong> <code>npx opencastle convoy dashboard</code> opens the run viewer at <code>http://localhost:4300</code>, or the next free port: per-task gate results, the execution log and the retry queue. It only displays the run; reviews and approvals happen in your pull request.</div>
          </section>

          <!-- Step 7 -->
          <section class="recipe-section recipe-step" id="team-step-7">
            <div class="recipe-step__number">7</div>
            <h3 class="recipe-section__heading">Step 7: Ship the PR</h3>
            <p class="recipe-section__body">Push the feature branch and open a pull request. Include all related Linear issue IDs in the PR body — Linear will use those references to auto-close issues when the PR merges.</p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ git push -u origin feat/user-authentication
$ gh pr create --title "feat: user authentication" --body "Closes PRJ-210, closes PRJ-211, closes PRJ-212"</code></pre>
            </div>
            <div class="recipe-tip"><strong>Tip:</strong> Use the exact Linear IDs in the PR body (e.g. <code>PRJ-210</code>). With Linear's GitHub integration installed, Linear links the pull request to the issues and moves them to <strong>Done</strong> when it merges, if your workspace rules allow it.</div>
          </section>

          <!-- Tips & Troubleshooting -->
          <section class="recipe-section" id="team-troubleshooting">
            <h3 class="recipe-section__heading">Tips &amp; Troubleshooting</h3>
            <div class="recipe-troubleshooting">
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">Linear tools do not appear in the assistant</p>
                <p class="recipe-troubleshooting__solution">Run <code>npx opencastle doctor</code>: it flags an MCP config your assistant cannot load. Installs from before the switch to Linear's own server are moved over by <code>npx opencastle sync</code> unless you edited the entry.</p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">The browser sign-in never appears</p>
                <p class="recipe-troubleshooting__solution">Restart the assistant so it reconnects to the server. If your network blocks <code>mcp.linear.app</code>, ask for it to be allowed — the server is remote.</p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">Task descriptions don't match Linear issues</p>
                <p class="recipe-troubleshooting__solution">Fix the IDs in the spec before the run. After it, a run replays the spec it started with, so put the right IDs in the pull request body instead.</p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">Merge conflicts between tasks</p>
                <p class="recipe-troubleshooting__solution">Give each task paths of its own under <code>files</code>, and order tasks that must touch the same file with <code>depends_on</code>. If a conflict occurs, resolve it on the feature branch and tighten the spec for next time.</p>
              </div>
            </div>
          </section>

          <!-- What's next -->
          <section class="recipe-section" id="team-whats-next">
            <h3 class="recipe-section__heading">What's next</h3>
            <ul class="recipe-section__list">
              <li><strong>Checks on every pull request</strong> — <code>npx opencastle ci</code> adds a GitHub Actions check that fails a pull request whose generated config no longer matches its sources; your own CI runs on the convoy's branch as usual. The <a href="/docs/agentic-development">Agentic Development</a> guide covers review practice.</li>
              <li><strong>Other trackers</strong> — <code>npx opencastle add jira</code> (or <code>trello</code>, <code>notion</code>) adds another tracker alongside Linear or in its place.</li>
              <li><strong>Shared setup across repositories</strong> — the <a href="/docs/teams">Teams</a> page covers baselines, policy and rollout.</li>
            </ul>
          </section>

        </article>

        <article class="recipe" id="api-backend">
          <h2 class="recipe__title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
            Build a REST API Backend
          </h2>

          <!-- Introduction -->
          <section class="recipe-section" id="api-intro">
            <h3 class="recipe-section__heading">Introduction</h3>
            <p class="recipe-section__body">This recipe covers building a Node.js REST API with CRUD endpoints for users, projects, and tasks, JWT authentication middleware, input validation with Zod, and automated test coverage. It walks through initializing the workspace, running OpenCastle's pipeline to plan routes, models, middleware, and tests, reviewing the PRD, and verifying the result locally.</p>
            <p class="recipe-section__body">The convoy runs parallel agents on the server scaffolding, route handlers, validation, auth, and tests, with quality gates and a review of every task.</p>
          </section>

          <!-- What you'll build -->
          <section class="recipe-section" id="api-what-youll-build">
            <h3 class="recipe-section__heading">What you'll build</h3>
            <p class="recipe-section__body">A task management REST API served at <code>/api/v1</code> with endpoints for users, projects, and tasks, role-based access control, and full test coverage. The mockup below represents a sample JSON response from the generated API.</p>

            <div class="recipe-mockup">
              <div class="recipe-mockup__chrome">
                <div class="recipe-mockup__dots"><span></span><span></span><span></span></div>
                <div class="recipe-mockup__url">localhost:3000/api/v1</div>
              </div>
              <div class="recipe-mockup__body">
                <pre><code>{`{
  "data": [
    {
      "id": "task_01",
      "title": "Design API",
      "status": "open",
      "assigneeId": "user_123",
      "dueDate": "2026-04-01"
    }
  ],
  "meta": { "page": 1, "limit": 10, "total": 42 }
}`}</code></pre>
              </div>
              <div class="recipe-mockup__pages">
                <span class="recipe-mockup__page recipe-mockup__page--active">Routes ·</span>
                <span class="recipe-mockup__page">Models ·</span>
                <span class="recipe-mockup__page">Middleware ·</span>
                <span class="recipe-mockup__page">Tests</span>
              </div>
            </div>

            <ul class="recipe-section__list">
              <li><strong>API routes</strong> — CRUD for users, projects, tasks</li>
              <li><strong>Auth</strong> — JWT authentication and role-based access control</li>
              <li><strong>Validation</strong> — Zod schemas for request bodies and params</li>
              <li><strong>Data</strong> — lightweight SQLite models (Node 22.5+), migrations, and seeds</li>
              <li><strong>Tests</strong> — unit and integration tests with CI-friendly tooling</li>
