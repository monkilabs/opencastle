---
import '../../styles/global.css';
import dashboardShot from '../../images/dashboard-snapshot.png';

const title = 'Use Cases — OpenCastle';
const description = 'Real convoy runs, end to end: plan and run a feature from one sentence, and write a spec, stop its run and resume it. Each with the time and cost it took.';

const recipes = [
  {
    id: 'plan-and-run',
    title: 'Plan and run a feature',
    steps: [
      { id: 'run-intro', label: 'Introduction' },
      { id: 'run-prerequisites', label: 'Before you start' },
      { id: 'run-step-1', label: 'Step 1: Initialize' },
      { id: 'run-step-2', label: 'Step 2: Describe the task' },
      { id: 'run-step-3', label: 'Step 3: The run' },
      { id: 'run-step-4', label: 'Step 4: Watch it' },
      { id: 'run-step-5', label: 'Step 5: Review and merge' },
      { id: 'run-cost', label: 'Time and cost' },
      { id: 'run-troubleshooting', label: 'When something fails' },
    ],
  },
  {
    id: 'spec-stop-resume',
    title: 'Write a spec, stop it, resume it',
    steps: [
      { id: 'spec-intro', label: 'Introduction' },
      { id: 'spec-step-1', label: 'Step 1: Write the spec' },
      { id: 'spec-step-2', label: 'Step 2: Check it' },
      { id: 'spec-step-3', label: 'Step 3: Run it' },
      { id: 'spec-step-4', label: 'Step 4: Press Ctrl+C' },
      { id: 'spec-step-5', label: 'Step 5: See where it stands' },
      { id: 'spec-step-6', label: 'Step 6: Resume' },
      { id: 'spec-step-7', label: 'Step 7: Review and merge' },
      { id: 'spec-fields', label: 'What a spec can say' },
    ],
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
  </head>
  <body>
    <header class="docs-header">
      <div class="docs-header__inner">
        <div class="docs-header__brand">
          <a href="/" class="docs-header__logo-link">
            <img class="docs-header__icon" src="/icon-192.png" alt="OpenCastle" width="28" height="28" />
          </a>
          <h1 class="docs-header__title">
            <a href="/docs/" class="docs-header__breadcrumb-link">Docs</a>
            <span class="docs-header__breadcrumb-sep">/</span>
            Use Cases
          </h1>
        </div>
      </div>
    </header>

    <div class="docs-layout">
      <nav class="docs-sidebar" id="docs-sidebar">
        <p class="docs-sidebar__label">Use Cases</p>
        {recipes.map((r, i) => (
          <div class="docs-sidebar__group" data-recipe={r.id}>
            <a class={`docs-sidebar__link ${i === 0 ? 'docs-sidebar__link--active' : ''}`} href={`#${r.id}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
              {r.title}
            </a>
            <ul class="docs-sidebar__list docs-sidebar__steps">
              {r.steps.map(step => (
                <li>
                  <a class="docs-sidebar__link docs-sidebar__cmd" href={`#${step.id}`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    {step.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <main class="docs-main">
        <p class="docs-subtitle">
          Two convoy recipes, each run end to end on a small Node.js notes API: two source files, four
          tests, a <code>CLAUDE.md</code>, and Claude Code as the agent runtime. The output is what the CLI
          printed in real runs, trimmed where marked with <code>…</code>.
        </p>
        <div class="recipe-tip">
          <strong>Experimental:</strong> the convoy engine (<code>opencastle convoy</code>) is experimental
          and may change. Every command and flag is on the <a href="/docs/cli#convoy">CLI page</a>.
        </div>

        <!-- ═══════════════ Recipe 1 ═══════════════ -->
        <article class="recipe" id="plan-and-run">
          <h2 class="recipe__title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
            Plan and run a feature
          </h2>

          <section class="recipe-section" id="run-intro">
            <h3 class="recipe-section__heading">Introduction</h3>
            <p class="recipe-section__body">
              You describe a feature in one sentence. OpenCastle plans it without changing anything, shows
              you the plan and asks once. The agents then work in git worktrees of their own, in parallel where
              the plan allows, and the result lands on a branch for you to review and merge. Your checkout is
              never touched.
            </p>
            <p class="recipe-section__body">
              The run quoted here added pagination and <code>DELETE /notes</code> to the notes API: two tasks,
              planned in 2 minutes 59 seconds and run in 5 minutes 28 seconds, for $2.63 in all.
            </p>
          </section>

          <section class="recipe-section" id="run-prerequisites">
            <h3 class="recipe-section__heading">Before you start</h3>
            <ul class="recipe-prereq">
              <li>Node.js 22.5 or later, and Git</li>
              <li>A git repository with at least one commit</li>
              <li>An agent CLI, installed and signed in: Claude Code (<code>claude</code>), GitHub Copilot (<code>copilot</code>), Cursor (<code>cursor-agent</code>), OpenCode (<code>opencode</code>) or Codex (<code>codex</code>). The convoy uses the one for the assistant <code>opencastle init</code> sets up — see <a href="/docs/cli#convoy">Runtime</a></li>
              <li>Your project's checks as <code>package.json</code> scripts — <code>typecheck</code>, <code>lint</code>, <code>test</code>, <code>build</code> — if you want them run at the end</li>
            </ul>
          </section>

          <section class="recipe-section recipe-step" id="run-step-1">
            <div class="recipe-step__number">1</div>
            <h3 class="recipe-section__heading">Step 1: Initialize</h3>
            <p class="recipe-section__body">
              Run the initializer in the repository. It finds the <code>CLAUDE.md</code>, so it compiles for
              Claude Code, and that is the runtime the convoy will use.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ cd ~/notes-api
$ npx opencastle init</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  🏰 OpenCastle v1.0.0
  Compiles your AI assistant config for every assistant you use

  Scanning repository…

  Found assistant config:
    • Claude Code (CLAUDE.md)

  Will compile for:
    → Claude Code

  Integrations detected:
    chrome-devtools

  Set this up? [Y/n] y

  Configuring project...
  …
  ✓ Merged into your existing CLAUDE.md
    your content is above the managed block and is never overwritten
  …</code></pre>
            </div>
            <p class="recipe-section__body">
              Commit what it wrote. Each task's worktree starts from your last commit, so anything uncommitted
              is not there for the agents.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ git add -A
$ git commit -m "Add OpenCastle"</code></pre>
            </div>
          </section>

          <section class="recipe-section recipe-step" id="run-step-2">
            <div class="recipe-step__number">2</div>
            <h3 class="recipe-section__heading">Step 2: Describe the task</h3>
            <p class="recipe-section__body">
              Say what you want, with the details that matter to you. Planning changes no code. This request
              was sized small, so the tasks were planned straight from it; larger work gets a PRD in
              <code>.opencastle/prds/</code> first. With <code>--yes</code>, one more session reviews the plan and
              the run starts without asking.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy "Add pagination to GET /notes: limit and offset query parameters \
  (defaults 20 and 0, limit capped at 100, a negative or non-numeric value is a 400 with \
  a JSON error). Add DELETE /notes, which removes every note and answers 204. Cover both \
  with tests." --yes</code></pre>
            </div>
            <div class="recipe-output">
              <pre><code>  opencastle convoy — planning, read-only
  Runtime: Claude Code — configured by opencastle init

  ✓ Sized low — planned straight from the request, without a PRD
  ✓ 2 tasks planned
  ✓ Plan checked
  ✓ Plan reviewed

  Plan: Notes pagination delete — 2 tasks, up to 1 at a time

    TASK                       AGENT      DEPENDS ON                FILES
    add-get-notes-pagination   developer  –                         src/notes.js, src/s…
    add-delete-notes-endpoint  developer  add-get-notes-pagination  src/notes.js, src/s…

  Branch convoy/notes-pagination-delete · runtime claude · then once: npm run test
  Spec   .opencastle/convoys/notes-pagination-delete.convoy.yml
  Planned in 2m 59s · 3 sessions · 334K tokens · $0.66</code></pre>
            </div>
            <p class="recipe-section__body">
              The table is the plan: who does what, after what, touching which files. Below it are the branch,
              the runtime, the checks that run once at the end, found in <code>package.json</code>, and what
              planning spent. (This output is from an earlier build; the current one plans the same request in
              under 30 seconds, for about $0.22.)
            </p>
            <p class="recipe-section__body">
              Without <code>--yes</code>, the command stops here and asks. Enter runs the plan. <strong>n</strong>,
              or no answer at all — as in a script — starts nothing and prints the command for later:
            </p>
            <div class="recipe-output">
              <pre><code>  Run it? [Y/n] n

  Not started. To run it later: opencastle convoy run .opencastle/convoys/&lt;name&gt;.convoy.yml</code></pre>
            </div>
            <div class="recipe-tip">
              <strong>Tip:</strong> <code>--dry-run</code> plans and writes the spec, then stops. The spec is plain
              YAML: edit it and run it with <code>npx opencastle convoy run</code>, as in
              <a href="#spec-stop-resume">the second recipe</a>.
            </div>
          </section>

          <section class="recipe-section recipe-step" id="run-step-3">
            <div class="recipe-step__number">3</div>
            <h3 class="recipe-section__heading">Step 3: The run</h3>
            <p class="recipe-section__body">
              Each task starts as soon as the tasks it depends on are done, in a worktree of its own. When its
              agent finishes, the work is committed there, gets one read-only review — a change of at most 10
              lines in 2 files passes without one, unless it touches a sensitive path — and is merged onto the
              run's branch. Here the second task waits for the first, because they change the same files. The
              test suite ran once, at the end, on the merged result.
            </p>
            <div class="recipe-output">
              <pre><code>  Convoy: Notes pagination delete — 2 tasks
  Models: by agent tier — premium opus, standard sonnet, economy haiku (and reviews)
  Live view: http://127.0.0.1:4300

  Branch convoy/notes-pagination-delete (from main) · 2 tasks · up to 1 at once
  ▶ [add-get-notes-pagination] developer
  ✓ [add-get-notes-pagination] (3m 57s) · $1.40
  ▶ [add-delete-notes-endpoint] developer
  ✓ [add-delete-notes-endpoint] (1m 30s) · $0.56

  Gates:
  ✓ npm run test

  ──────────────────────────────────────
  ✓ Convoy done in 5m 28s — 2/2 tasks done
  Gates: 1/1 passed
  Spent: 3.1M tokens · $1.97
  Convoy: convoy-1791045784848
  Branch: convoy/notes-pagination-delete (from main)
    Review: git diff main...convoy/notes-pagination-delete
    Merge:  git merge convoy/notes-pagination-delete
  Log: .opencastle/logs/convoys/convoy-1791045784848.ndjson</code></pre>
            </div>
            <p class="recipe-section__body">
              The developer agent is standard tier, so both tasks ran on <code>sonnet</code>; both reviews ran
              on <code>haiku</code> and passed. The suite went from 4 tests to 12.
            </p>
            <div class="recipe-tip">
              <strong>Tip:</strong> <code>--verbose</code> streams each agent's output.
            </div>
          </section>

          <section class="recipe-section recipe-step" id="run-step-4">
            <div class="recipe-step__number">4</div>
            <h3 class="recipe-section__heading">Step 4: Watch it</h3>
            <p class="recipe-section__body">
              On a terminal the run starts the read-only Observability dashboard (<code>Live view:</code> above):
              every run's tasks, what they wait for and spent, reviews, checks, retries, a failed task's reason and
              the event timeline. To open it at any time:
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ npx opencastle convoy dashboard</code></pre>
            </div>
            <img class="recipe-shot" src={dashboardShot.src} width="1440" height="900" loading="lazy"
              alt="The Observability dashboard's overview of seven real convoy runs: 7 runs and 22 tasks, all done, 6m 16s on average, 21.28M tokens and $19.44, part of it estimated, with runs per day below" />
            <p class="recipe-section__body">
              The overview, over seven real runs on copies of this project. Open each of them at
              <a href="https://www.opencastle.dev/dashboard/">opencastle.dev/dashboard</a>.
            </p>
          </section>

          <section class="recipe-section recipe-step" id="run-step-5">
            <div class="recipe-step__number">5</div>
            <h3 class="recipe-section__heading">Step 5: Review and merge</h3>
            <p class="recipe-section__body">
              The work is on <code>convoy/notes-pagination-delete</code>. Your own branch has only the new spec in
              <code>.opencastle/convoys/</code>, uncommitted. Read the change, then merge it, or push the branch and
              open a pull request.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">Terminal</div>
              <pre><code>$ git diff main...convoy/notes-pagination-delete
$ git merge convoy/notes-pagination-delete</code></pre>
            </div>
            <p class="recipe-section__body">
              <code>npx opencastle convoy</code> with nothing after it says where the last run stands and the
              one thing to do next:
            </p>
            <div class="recipe-output">
              <pre><code>  🚚 Convoy (experimental)

  ✓ Notes pagination delete — done
    2/2 done
    Branch convoy/notes-pagination-delete

  Next: opencastle convoy "&lt;task&gt;"
  every task is done; start another</code></pre>
            </div>
          </section>

          <section class="recipe-section" id="run-cost">
            <h3 class="recipe-section__heading">Time and cost</h3>
            <p class="recipe-section__body">
              Seven runs on this project with Claude Code, all on earlier builds; read them as data points, not a
              promise. The first three asked for the same change.
            </p>
            <table class="recipe-table recipe-table--runs">
              <thead>
                <tr><th>What was asked</th><th>Planned</th><th>Tasks</th><th>Planning</th><th>Running</th><th>Tests</th></tr>
              </thead>
              <tbody>
                <tr><td>Pagination and <code>DELETE /notes</code> (this recipe)</td><td>sized low, no PRD, 3 sessions</td><td>2, one at a time</td><td>2m 59s · $0.66</td><td>5m 28s · $1.97</td><td>4 → 12</td></tr>
                <tr><td>The same</td><td>PRD, fixed once, 7 sessions; a test task folded in</td><td>3, one at a time</td><td>7m 25s · $1.67</td><td>6m 10s · $2.13</td><td>4 → 20</td></tr>
                <tr><td>The same</td><td>PRD, 5 sessions; tests as tasks of their own</td><td>4, up to 2 at once</td><td>5m 41s · $1.56</td><td>4m 34s · $2.22</td><td>4 → 19</td></tr>
                <tr><td>“Add tags to notes: … Reject invalid notes with 400 … Document every endpoint in README.md …”</td><td>PRD</td><td>5, up to 3 at once</td><td>not shown</td><td>4m 53s · $3.21</td><td>4 → 18</td></tr>
                <tr><td>“Add a GET /health endpoint…, with a test”</td><td>PRD</td><td>2, one at a time</td><td>not shown</td><td>3m 59s · $1.50</td><td>4 → 6</td></tr>
                <tr><td><a href="#spec-stop-resume">Search and export</a>, stopped and resumed</td><td>by hand</td><td>3, two at once</td><td>—</td><td>2m 19s + 3m 56s · $2.53 est.</td><td>4 → 12</td></tr>
                <tr><td>Tags, validation and docs, every task on Opus</td><td>by hand</td><td>3, one at a time</td><td>—</td><td>12m 36s · $5.89</td><td>4 → 39</td></tr>
              </tbody>
            </table>
            <ul class="recipe-section__list">
              <li><strong>The model matters most.</strong> A developer task on <code>sonnet</code> cost $0.48–$1.40;
                on Opus, the account default before tasks ran by tier, $2.01–$2.60.</li>
              <li><strong>Planning is now much shorter.</strong> The current build plans the pagination request in
                24–28 seconds for $0.22, and a feature that needs a PRD in under 2 minutes.</li>
              <li><strong>Fewer tasks are not always faster.</strong> Tasks that change the same files run one after
                the other.</li>
            </ul>
          </section>

          <section class="recipe-section" id="run-troubleshooting">
            <h3 class="recipe-section__heading">When something fails</h3>
            <div class="recipe-troubleshooting">
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">A task failed</p>
                <p class="recipe-troubleshooting__solution">
                  A failed attempt runs once more by default, told why the first failed. If it fails again, the
                  tasks that depend on it are skipped and the rest carry on. The summary lists each task that is
                  not done with its reason, and the dashboard shows the end of its output. Fix the cause, then
                  <code>npx opencastle convoy resume</code>.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">A review blocked a task</p>
                <p class="recipe-troubleshooting__solution">
                  If it has a retry left, the task runs again, given the reviewer's issues, as in <a href="#spec-step-6">the second
                  recipe</a>. A review that cannot run or gives no verdict is recorded as skipped, never as a pass.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">The checks failed at the end</p>
                <p class="recipe-troubleshooting__solution">
                  A planned spec gives one agent one attempt to fix the merged result. If the checks still fail,
                  the run ends <code>gate-failed</code> with the failing command and its first line of output; the
                  branch has the work so far.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">A task could not be merged</p>
                <p class="recipe-troubleshooting__solution">
                  A conflict re-runs the task once on top of the work it collided with. If it still cannot merge,
                  the task fails and the summary names the branch its work is kept on.
                </p>
              </div>
              <div class="recipe-troubleshooting__item">
                <p class="recipe-troubleshooting__problem">No runtime found</p>
                <p class="recipe-troubleshooting__solution">
                  The command stops before planning and names the CLI to install. To use another one, pass
                  <code>--adapter</code>.
                </p>
              </div>
            </div>
          </section>
        </article>

        <!-- ═══════════════ Recipe 2 ═══════════════ -->
        <article class="recipe" id="spec-stop-resume">
          <h2 class="recipe__title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
            Write a spec, stop it, resume it
          </h2>

          <section class="recipe-section" id="spec-intro">
            <h3 class="recipe-section__heading">Introduction</h3>
            <p class="recipe-section__body">
              When you already know the tasks, skip planning and write the spec yourself. This one adds search
              and an export to the notes API, after <code>opencastle init</code> as in
              <a href="#run-step-1">the first recipe</a>. Partway through, the run was stopped with Ctrl+C and then
              resumed: everything is recorded in <code>.opencastle/convoy.db</code>, so <code>resume</code> carries
              on with what is not done and keeps what is. The same command picks up a run that failed, or one that
              was killed outright.
            </p>
          </section>

          <section class="recipe-section recipe-step" id="spec-step-1">
            <div class="recipe-step__number">1</div>
            <h3 class="recipe-section__heading">Step 1: Write the spec</h3>
            <p class="recipe-section__body">
              Give each task an <code>id</code>, an <code>agent</code>, the <code>files</code> it may change and a
              <code>prompt</code>; <code>depends_on</code> orders them. Keep code and its tests in the same task.
              Tasks with no files in common run at the same time.
            </p>
            <div class="recipe-code">
              <div class="recipe-code__header">search.convoy.yml</div>
              <pre><code>{`name: Notes search and export
branch: convoy/search-export
gates:
  - npm test
tasks:
  - id: search
    agent: developer
    description: Search notes by text
    files: [src/notes.js, test/notes.test.js]
    prompt: |
      Add searchNotes(query) to src/notes.js: a case-insensitive match on title or body,
      returning matching notes in creation order; an empty or whitespace query returns [].
      Add tests for it in test/notes.test.js and run \`npm test\`.
  - id: export
    agent: developer
    description: Export notes as JSON Lines
    files: [src/export.js, test/export.test.js]
    prompt: |
      Create src/export.js exporting toJsonLines(notes): one JSON object per line, no trailing
      newline, empty string for no notes. Add test/export.test.js covering empty, one and many
      notes, and run \`npm test\`.
  - id: routes
    agent: developer
    description: Wire search and export into the server
    depends_on: [search, export]
    files: [src/server.js, test/server.test.js]
    prompt: |
      In src/server.js add GET /notes/search?q=<text> (uses searchNotes; a missing q is 400 with
      a JSON error) and GET /notes/export (uses toJsonLines, content-type application/x-ndjson).
      Add tests in test/server.test.js and run \`npm test\`.`}</code></pre>
            </div>
            <div class="recipe-tip">
              <strong>Tip:</strong> a spec you write gets no checks unless it lists them under
              <code>gates</code>; the planner adds them from <code>package.json</code>. Keep <code>files</code>
              to paths and directories: a pattern such as <code>src/*.js</code> is refused.
            </div>
          </section>

          <section class="recipe-section recipe-step" id="spec-step-2">
            <div class="recipe-step__number">2</div>
            <h3 class="recipe-section__heading">Step 2: Check it</h3>
            <p class="recipe-section__body">
              <code>--dry-run</code> runs the same checks a run does and shows the order, the runtime, the branch
              and the gates. It starts nothing and records nothing.
            </p>
            <div class="recipe-code">
