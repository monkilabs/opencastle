        justify-content: center;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
        transition: background var(--transition-fast);
      }
      .docs-mobile-toggle:hover { background: var(--bg-tertiary); }
      @media (max-width: 1023px) {
        .docs-mobile-toggle { display: flex; }
        .docs-sidebar--open {
          display: block;
          position: fixed;
          top: 56px;
          left: 0;
          width: 220px;
          height: calc(100vh - 56px);
          background: var(--bg-secondary);
          border-right: 1px solid var(--border-color);
          z-index: 55;
          padding: 16px;
        }
      }
    </style>

    <!-- Mobile sidebar toggle -->
    <button class="docs-mobile-toggle" id="mobile-toggle" type="button" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <script>
      const sidebar = document.getElementById('docs-sidebar');
      const mobileToggle = document.getElementById('mobile-toggle');

      mobileToggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('docs-sidebar--open');
      });

      document.addEventListener('click', (e) => {
        if (sidebar?.classList.contains('docs-sidebar--open') &&
            !sidebar.contains(e.target as Node) &&
            e.target !== mobileToggle) {
          sidebar.classList.remove('docs-sidebar--open');
        }
      });

      sidebar?.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const id = (link as HTMLAnchorElement).getAttribute('href')?.replace('#', '');
          if (id) {
            const target = document.getElementById(id);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.replaceState(null, '', `#${id}`);
            }
          }
          sidebar?.classList.remove('docs-sidebar--open');
        });
      });

      // Show the steps of the recipe in view; the others collapse to their title.
      const groups = sidebar?.querySelectorAll<HTMLElement>('[data-recipe]');
      function setActiveRecipe(id: string) {
        groups?.forEach(g => {
          const active = g.dataset.recipe === id;
          g.classList.toggle('docs-sidebar__group--collapsed', !active);
          g.querySelector(':scope > .docs-sidebar__link')?.classList.toggle('docs-sidebar__link--active', active);
        });
      }
      const recipeObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) setActiveRecipe((entry.target as HTMLElement).id);
        });
      }, { rootMargin: '-80px 0px -60% 0px' });
      document.querySelectorAll<HTMLElement>('article.recipe').forEach(a => recipeObserver.observe(a));

      const hash = location.hash.replace('#', '');
      if (hash) {
        const target = document.getElementById(hash);
        if (target) {
          requestAnimationFrame(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
      }
      // Tab switching
      document.querySelectorAll('.recipe-tabs').forEach(tabs => {
        const tabBtns = tabs.querySelectorAll('.recipe-tabs__tab');
        const panels = tabs.querySelectorAll('.recipe-tabs__panel');
        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const target = (btn as HTMLButtonElement).getAttribute('data-tab');
            tabBtns.forEach(b => b.classList.remove('recipe-tabs__tab--active'));
            panels.forEach(p => p.classList.remove('recipe-tabs__panel--active'));
            btn.classList.add('recipe-tabs__tab--active');
            tabs.querySelector(`[data-panel="${target}"]`)?.classList.add('recipe-tabs__panel--active');
          });
        });
      });
    </script>
  </body>
</html>
