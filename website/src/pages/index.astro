import logo from '../images/opencastle-logo.png';
import illustration from '../images/opencastle-illustration.png';
import dashboardSnapshot from '../images/dashboard-snapshot.png';

const DEMO_URL = 'https://www.opencastle.dev/dashboard';

const agents = [
  { name: 'Team Lead', tier: 'premium' },
  { name: 'Developer', tier: 'quality' },
  { name: 'UI/UX Expert', tier: 'quality' },
  { name: 'Security Expert', tier: 'quality' },
  { name: 'Architect', tier: 'quality' },
  { name: 'Content Engineer', tier: 'standard' },
